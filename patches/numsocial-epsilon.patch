new file mode 100644
index 0000000000..14dab15182
--- /dev/null
+++ b/epsilon/apps/termia/shell/textfx.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <stddef.h>
+
+namespace Termia {
+
+// textfx — line-level text "beautifier" for the Termia scrollback.
+//
+// The NumWorks fonts (SmallFont/LargeFont) carry only Latin + a handful of
+// extended glyphs, so Unicode emitted by `claude`, MicroPython, fastfetch,
+// or future commands renders as ?? boxes. textfx::translate() rewrites a
+// line in place to printable substitutes:
+//
+//   - LaTeX shortcuts (`\alpha`, `\sum`, `\to`, `\sqrt`, …) → readable
+//     ASCII or extended-Latin glyphs the font already has.
+//   - UTF-8 sequences for Greek letters, common math symbols, arrows,
+//     sub/super, and box-drawing → ASCII fallbacks.
+//   - Anything else (unrecognised UTF-8 multi-byte codepoint) → '?'
+//     so the line stays printable.
+//
+// `dst` and `src` may safely overlap — translate() writes left-to-right
+// and never overruns the read head. `dstCap` includes the trailing NUL.
+// Returns the number of bytes written (excluding the NUL), clamped to
+// dstCap-1.
+size_t translate(const char* src, char* dst, size_t dstCap);
+
+}  // namespace Termia
