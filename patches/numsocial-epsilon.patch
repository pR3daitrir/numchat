+#pragma once
+
+#include <apps/numtube/link.h>
+#include <escher/view_controller.h>
+
+#include "chat_view.h"
+#include "protocol.h"
+#include "text_input.h"
+
+namespace Numchat {
+
+class ChatController : public Escher::ViewController {
+ public:
+  explicit ChatController(Escher::Responder* parentResponder);
+
+  enum class Screen { Start, Message, List, Conversation };
+
+  struct ConversationEntry {
+    uint8_t flags;
+    char id[40];
+    char name[32];
+    char preview[64];
+  };
+  struct ChatMessage {
+    uint8_t flags;
+    uint8_t mediaId;
+    char sender[24];
+    char text[TextInput::k_capacity + 4];
+  };
+
+  static constexpr int k_maxConversations = 24;
+  static constexpr int k_maxMessages = 48;
+
+  Escher::View* view() override { return &m_view; }
+  bool handleEvent(Ion::Events::Event event) override;
+  void viewWillAppear() override;
+  void disconnect() { m_link.disconnect(); }
+  // Called by the app's timer while Escher runs (start screen only).
+  void tick();
+
+  // Accessors for ChatView.
+  Screen screen() const { return m_screen; }
+  const char* message() const { return m_message; }
+  const char* status() const { return m_status; }
+  int conversationCount() const { return m_conversationCount; }
+  const ConversationEntry& conversation(int i) const { return m_conversations[i]; }
+  int selection() const { return m_selection; }
+  int firstVisible() const { return m_firstVisible; }
+  const char* openName() const { return m_openName; }
+  int messageCount() const { return m_messageCount; }
+  // 0 is the oldest message kept.
+  const ChatMessage& messageAt(int i) const {
+    return m_messages[(m_messageStart + i) % k_maxMessages];
+  }
+  int scrollLines() const { return m_scrollLines; }
+  bool hasUnseenBelow() const { return m_unseenBelow; }
+  const TextInput& input() const { return m_input; }
+  bool isSending() const { return m_sending; }
+  bool historyLoaded() const { return m_historyLoaded; }
+  // 14x14 picture of an emoji slot, or nullptr if not received yet.
+  const KDColor* emoji(int slot) const {
+    return slot >= 0 && slot < Protocol::k_emojiSlots && (m_emojiValid >> slot & 1)
+               ? m_emojis[slot]
+               : nullptr;
+  }
+  // Message whose snap OK would open (-1: none), chosen by the view.
+  int viewTarget() const { return m_viewTarget; }
+  void setViewTarget(int index) const { m_viewTarget = index; }
+
+ private:
+  void showStart();
+  void showMessage(const char* message, bool needsKey);
+  void redraw(KDRect rect);
+  void redrawAll();
+  void updateModifierIndicator();
+  bool ensureConnected();
+  void runSession();
+  // Return false when the session must end (link lost, Back, Home).
+  bool browseList();
+  bool runConversation(int index);
+  bool pollFrames(bool inConversation, bool* linkLost);
+  void handleConversationFrame(const uint8_t* payload, uint16_t length);
+  void handleMessageFrame(const uint8_t* payload, uint16_t length);
+  void moveSelection(int delta);
+  void scroll(int delta);
+  bool sendInput();
+  bool runViewer(int index);
+  void handleEmojiFrame(const uint8_t* payload, uint16_t length);
+  void handleMediaRows(const uint8_t* payload, uint16_t length);
+  bool requestList();
+  bool linkAlive();
+
+  ChatView m_view;
+  Numtube::Link m_link;
+  TextInput m_input;
+  Screen m_screen;
+  char m_message[100];
+  char m_status[64];
+  ConversationEntry m_conversations[k_maxConversations];
+  int m_conversationCount;
+  int m_pendingCount;
+  int m_selection;
+  int m_firstVisible;
+  char m_openId[40];
+  char m_openName[32];
+  ChatMessage m_messages[k_maxMessages];
+  int m_messageStart;
+  int m_messageCount;
+  int m_scrollLines;
+  bool m_unseenBelow;
+  bool m_sending;
+  bool m_historyLoaded;
+  bool m_messageNeedsKey;
+  bool m_autoStart;
+  uint64_t m_lastFrameTime;
+  uint64_t m_lastPingTime;
+  uint64_t m_sendStartTime;
+  // Viewer
+  bool m_viewing;
+  bool m_viewStillViewable;
+  int m_mediaWidth;
+  int m_mediaHeight;
+  uint64_t m_viewStartTime;
+  mutable int m_viewTarget;
+  uint32_t m_emojiValid;
+  KDColor m_emojis[Protocol::k_emojiSlots][Protocol::k_emojiSize * Protocol::k_emojiSize];
+};
+
+}  // namespace Numchat
diff --git a/epsilon/apps/numchat/chat_view.cpp b/epsilon/apps/numchat/chat_view.cpp
new file mode 100644
index 0000000000..d7a58987f9
--- /dev/null
+++ b/epsilon/apps/numchat/chat_view.cpp
@@ -0,0 +1,428 @@
+#include "chat_view.h"
+
+#include <string.h>
+
+#include "chat_controller.h"
+#include "protocol.h"
+
+namespace Numchat {
+
+namespace {
+
+constexpr KDColor k_background = KDColor::RGB24(0x101010);
+constexpr KDColor k_header = KDColor::RGB24(0x1E1E1E);
+constexpr KDColor k_selected = KDColor::RGB24(0x2E2C10);
+constexpr KDColor k_field = KDColor::RGB24(0x262626);
+constexpr KDColor k_text = KDColorWhite;
+constexpr KDColor k_muted = KDColor::RGB24(0x9A9A9A);
+constexpr KDColor k_accent = KDColor::RGB24(0xFFFC00);
+constexpr KDColor k_mine = KDColor::RGB24(0xF23C57);
+constexpr KDColor k_theirs = KDColor::RGB24(0x0EADFF);
+
+constexpr int k_largeWidth = KDFont::GlyphMaxWidth(KDFont::Size::Large);
+constexpr int k_largeHeight = KDFont::GlyphHeight(KDFont::Size::Large);
+
+bool isCombining(uint8_t byte) { return byte == 0xCC || byte == 0xCD; }
+
+// Emoji slot referenced at p (U+E000 + slot, UTF-8 EE 80 80+slot), or -1.
+int emojiSlot(const char* p) {
+  const uint8_t* b = reinterpret_cast<const uint8_t*>(p);
+  if (b[0] == 0xEE && b[1] == 0x80 && b[2] >= 0x80 &&
+      b[2] < 0x80 + Protocol::k_emojiSlots) {
+    return b[2] - 0x80;
+  }
+  return -1;
+}
+
+// Screen columns taken by the glyph at p: emojis are two glyphs wide.
+int columnsOf(const char* p) { return emojiSlot(p) >= 0 ? 2 : 1; }
+
+// Set by drawRect: where emoji pictures come from.
+const ChatController* s_controller = nullptr;
+
+// Advances past one glyph: its bytes and any combining accents after it.
+const char* nextGlyph(const char* p) {
+  p++;
+  while ((static_cast<uint8_t>(*p) & 0xC0) == 0x80 ||
+         isCombining(static_cast<uint8_t>(*p))) {
+    p++;
+  }
+  return p;
+}
+
+// Screen columns taken by `length` bytes of text.
+int glyphs(const char* text, int length) {
+  int count = 0;
+  for (const char* p = text; p < text + length && *p != '\0'; p = nextGlyph(p)) {
+    count += columnsOf(p);
+  }
+  return count;
+}
+
+KDPoint drawRun(KDContext* ctx, const char* text, int length, KDPoint p,
+                KDGlyph::Style style) {
+  char line[256];
+  if (length <= 0) {
+    return p;
+  }
+  if (length > static_cast<int>(sizeof(line)) - 1) {
+    length = sizeof(line) - 1;
+  }
+  memcpy(line, text, length);
+  line[length] = '\0';
+  return ctx->drawString(line, p, style);
+}
+
+/* Draws `length` bytes of `text`, emojis as pictures (drawString needs a
+ * terminated string, and knows nothing about the emoji references). */
+KDPoint drawPart(KDContext* ctx, const char* text, int length, KDPoint p,
+                 KDGlyph::Style style) {
+  const char* end = text + length;
+  const char* run = text;
+  const char* c = text;
+  while (c < end && *c != '\0') {
+    const int slot = emojiSlot(c);
+    if (slot < 0) {
+      c = nextGlyph(c);
+      continue;
+    }
+    p = drawRun(ctx, run, static_cast<int>(c - run), p, style);
+    constexpr int size = Protocol::k_emojiSize;
+    const int width = 2 * KDFont::GlyphMaxWidth(style.font);
+    const KDColor* pixels = s_controller ? s_controller->emoji(slot) : nullptr;
+    const KDRect box(p.x() + (width - size) / 2, p.y(), size, size);
+    if (pixels != nullptr && style.backgroundColor == k_background) {
+      KDColor buffer[size * size];
+      ctx->fillRectWithPixels(box, pixels, buffer);
+    } else {
+      ctx->fillRect(box, style.backgroundColor);
+      ctx->strokeRect(box, k_muted);
+    }
+    p = KDPoint(p.x() + width, p.y());
+    c = nextGlyph(c);
+    run = c;
+  }
+  return drawRun(ctx, run, static_cast<int>(c - run), p, style);
+}
+
+}  // namespace
+
+int ChatView::lineLength(const char* text, int columns, const char** next) {
+  const char* p = text;
+  const char* lastSpace = nullptr;
+  int count = 0;
+  while (*p != '\0' && *p != '\n') {
+    const int width = columnsOf(p);
+    if (count + width > columns) {
+      break;
+    }
+    if (*p == ' ') {
+      lastSpace = p;
+    }
+    p = nextGlyph(p);
+    count += width;
+  }
+  if (p == text && *p != '\0' && *p != '\n') {
+    p = nextGlyph(p);  // always make progress
+  }
+  const char* end = p;
+  if (*p != '\0' && *p != '\n' && *p != ' ' && lastSpace != nullptr) {
+    end = lastSpace;  // word wrap
+  }
+  const char* following = end;
+  while (*following == ' ') {
+    following++;
+  }
+  if (*following == '\n') {
+    following++;
+  }
+  *next = following;
+  return static_cast<int>(end - text);
+}
+
+bool ChatView::showsSenderName(int index) const {
+  const ChatController::ChatMessage& m = m_controller->messageAt(index);
+  if (m.flags & (Protocol::k_mine | Protocol::k_info) || m.sender[0] == '\0') {
+    return false;
+  }
+  if (index == 0) {
+    return true;
+  }
+  const ChatController::ChatMessage& previous = m_controller->messageAt(index - 1);
+  return (previous.flags & (Protocol::k_mine | Protocol::k_info)) ||
+         strcmp(previous.sender, m.sender) != 0;
+}
+
+int ChatView::linesForMessage(int index) const {
+  const ChatController::ChatMessage& m = m_controller->messageAt(index);
+  const int columns = (m.flags & Protocol::k_info) ? k_infoColumns : k_bubbleColumns;
+  int lines = showsSenderName(index) ? 1 : 0;
+  const char* p = m.text;
+  do {
+    lineLength(p, columns, &p);
+    lines++;
+  } while (*p != '\0');
+  return lines;
+}
+
+int ChatView::totalLines() const {
+  int total = 0;
+  for (int i = 0; i < m_controller->messageCount(); i++) {
+    total += linesForMessage(i);
+  }
+  return total;
+}
+
+void ChatView::drawCentered(KDContext* ctx, const char* text, int y,
+                            KDColor color, KDFont::Size font) const {
+  const int width = KDFont::GlyphMaxWidth(font);
+  const int height = KDFont::GlyphHeight(font);
+  const KDGlyph::Style style{color, k_background, font};
+  const char* p = text;
+  while (*p != '\0') {
+    const char* next;
+    const int length = lineLength(p, k_width / width - 2, &next);
+    const int x = (k_width - glyphs(p, length) * width) / 2;
+    drawPart(ctx, p, length, KDPoint(x, y), style);
+    y += height + 2;
+    if (next == p) {
+      break;
+    }
+    p = next;
+  }
+}
+
+void ChatView::drawRect(KDContext* ctx, KDRect rect) const {
+  s_controller = m_controller;
+  switch (m_controller->screen()) {
+    case ChatController::Screen::Start:
+    case ChatController::Screen::Message:
+      drawStartOrMessage(ctx);
+      break;
+    case ChatController::Screen::List:
+      drawList(ctx);
+      break;
+    case ChatController::Screen::Conversation:
+      drawConversation(ctx);
+      break;
+  }
+}
+
+void ChatView::drawStartOrMessage(KDContext* ctx) const {
+  ctx->fillRect(bounds(), k_background);
+  drawCentered(ctx, "NumChat", 30, k_accent, KDFont::Size::Large);
+  if (m_controller->screen() == ChatController::Screen::Message) {
+    drawCentered(ctx, m_controller->message(), 80, k_text, KDFont::Size::Small);
+    return;
+  }
+  drawCentered(ctx,
+               "Laisse l'appli NumTube ouverte sur le Mac, avec Snapchat "
+               "connecte dans sa fenetre Chrome.",
+               80, k_text, KDFont::Size::Small);
+  drawCentered(ctx, "OK : se connecter", 150, k_accent, KDFont::Size::Small);
+  drawCentered(ctx, "Accents : Ans apres la lettre", 180, k_muted,
+               KDFont::Size::Small);
+}
+
+void ChatView::drawList(KDContext* ctx) const {
+  ctx->fillRect(headerRect(), k_header);
+  ctx->drawString("NumChat", KDPoint(8, 2), {k_accent, k_header, KDFont::Size::Large});
+  const char* status = m_controller->status();
+  if (status[0] != '\0') {
+    const char* next;
+    const int length = lineLength(status, 30, &next);
+    drawPart(ctx, status, length,
+             KDPoint(k_width - 6 - glyphs(status, length) * k_glyphWidth, 4),
+             {k_muted, k_header, KDFont::Size::Small});
+  }
+  const KDRect body(0, k_headerHeight, k_width, k_height - k_headerHeight);
+  ctx->fillRect(body, k_background);
+  const int count = m_controller->conversationCount();
+  if (count == 0) {
+    drawCentered(ctx, "Chargement des conversations...", 100, k_muted,
+                 KDFont::Size::Small);
+    return;
+  }
+  for (int row = 0; row < k_visibleRows; row++) {
+    const int index = m_controller->firstVisible() + row;
+    if (index >= count) {
+      break;
+    }
+    const ChatController::ConversationEntry& c = m_controller->conversation(index);
+    const bool selected = index == m_controller->selection();
+    const KDColor background = selected ? k_selected : k_background;
+    const int y = k_headerHeight + row * k_rowHeight;
+    ctx->fillRect(KDRect(0, y, k_width, k_rowHeight), background);
+    const bool unread = c.flags & Protocol::k_unread;
+    if (unread) {
+      ctx->fillRect(KDRect(6, y + 8, 6, 6), k_accent);
+    }
+    const char* next;
+    drawPart(ctx, c.name, lineLength(c.name, 28, &next), KDPoint(18, y + 2),
+             {unread ? k_accent : k_text, background, KDFont::Size::Large});
+    drawPart(ctx, c.preview, lineLength(c.preview, 42, &next),
+             KDPoint(18, y + 3 + k_largeHeight),
+             {k_muted, background, KDFont::Size::Small});
+    ctx->fillRect(KDRect(0, y + k_rowHeight - 1, k_width, 1), k_header);
+  }
+}
+
+void ChatView::drawConversation(KDContext* ctx) const {
+  // Header
+  ctx->fillRect(headerRect(), k_header);
+  const char* next;
+  const char* name = m_controller->openName();
+  drawPart(ctx, name, lineLength(name, 14, &next), KDPoint(8, 2),
+           {k_text, k_header, KDFont::Size::Large});
+  const char* status = m_controller->status();
+  if (status[0] != '\0') {
+    const int length = lineLength(status, 22, &next);
+    drawPart(ctx, status, length,
+             KDPoint(k_width - 6 - glyphs(status, length) * k_glyphWidth, 4),
+             {k_muted, k_header, KDFont::Size::Small});
+  }
+
+  // Messages, bottom-aligned, scrolled up by scrollLines().
+  const KDRect area = messagesRect();
+  ctx->fillRect(area, k_background);
+  if (!m_controller->historyLoaded() && m_controller->messageCount() == 0) {
+    drawCentered(ctx, "Chargement...", area.y() + 60, k_muted, KDFont::Size::Small);
+  } else {
+    const int total = totalLines();
+    int bottom = total - m_controller->scrollLines();
+    int top = bottom - k_visibleLines;
+    // Few messages: stick them to the bottom of the area.
+    int y = k_messagesTop + (top < 0 ? -top * k_lineHeight : 0);
+    if (top < 0) {
+      top = 0;
+    }
+    int line = 0;
+    int viewTarget = -1;
+    for (int i = 0; i < m_controller->messageCount() && line < bottom; i++) {
+      const ChatController::ChatMessage& m = m_controller->messageAt(i);
+      const bool mine = m.flags & Protocol::k_mine;
+      const bool info = m.flags & Protocol::k_info;
+      const int span = linesForMessage(i);
+      if (line + span <= top) {
+        line += span;
+        continue;
+      }
+      if (showsSenderName(i)) {
+        if (line >= top) {
+          drawPart(ctx, m.sender, lineLength(m.sender, 30, &next),
+                   KDPoint(8, y), {k_theirs, k_background, KDFont::Size::Small});
+          y += k_lineHeight;
+        }
+        line++;
+      }
+      const int columns = info ? k_infoColumns : k_bubbleColumns;
+      const bool viewable = m.flags & Protocol::k_viewable;
+      if (viewable && line + span > top) {
+        viewTarget = i;  // the lowest one on screen wins
+      }
+      const KDColor color = viewable ? k_accent
+                            : info || (m.flags & Protocol::k_media) ? k_muted
+                                                                     : k_text;
+      const char* p = m.text;
+      do {
+        const int length = lineLength(p, columns, &next);
+        if (line >= top && line < bottom) {
+          const int width = glyphs(p, length) * k_glyphWidth;
+          int x;
+          if (info) {
+            x = (k_width - width) / 2;
+          } else if (mine) {
+            x = k_width - 12 - width;
+            ctx->fillRect(KDRect(k_width - 6, y, 2, k_lineHeight), k_mine);
+          } else {
+            x = 12;
+            ctx->fillRect(KDRect(4, y, 2, k_lineHeight), k_theirs);
+          }
+          const KDPoint end = drawPart(ctx, p, length, KDPoint(x, y),
+                                       {color, k_background, KDFont::Size::Small});
+          if (viewable && !mine) {
+            ctx->drawString(" OK : voir", end, {k_muted, k_background, KDFont::Size::Small});
+          }
+          y += k_lineHeight;
+        }
+        line++;
+        if (next == p) {
+          break;
+        }
+        p = next;
+      } while (*p != '\0');
+    }
+    m_controller->setViewTarget(viewTarget);
+    if (m_controller->hasUnseenBelow()) {
+      const char* hint = " Nouveaux messages - bas ";
+      const int width = glyphs(hint, strlen(hint)) * k_glyphWidth;
+      drawPart(ctx, hint, strlen(hint),
+               KDPoint((k_width - width) / 2, area.bottom() - k_lineHeight),
+               {KDColorBlack, k_accent, KDFont::Size::Small});
+    }
+  }
+  drawInput(ctx);
+}
+
+void ChatView::drawInput(KDContext* ctx) const {
+  const KDRect rect = inputRect();
+  ctx->fillRect(rect, k_background);
+  ctx->fillRect(KDRect(rect.x(), rect.y(), rect.width(), 1), k_header);
+  const KDRect field(4, rect.y() + 5, k_width - 8, rect.height() - 9);
+  ctx->fillRect(field, k_field);
+
+  const TextInput& input = m_controller->input();
+  // Mode indicator, like Epsilon's status bar.
+  const Ion::Events::ShiftAlphaStatus mods = input.modifiers();
+  const char* mode = "123";
+  if (mods.alphaIsActive()) {
+    const bool upper = mods.shiftIsActive();
+    mode = mods.alphaIsLocked() ? (upper ? "ABC" : "abc") : (upper ? "A" : "a");
+  } else if (mods.shiftIsActive()) {
+    mode = "shift";
+  }
+  const int modeWidth = static_cast<int>(strlen(mode)) * k_glyphWidth;
+  ctx->drawString(mode, KDPoint(field.right() - 4 - modeWidth, field.y() + 3),
+                  {k_accent, k_field, KDFont::Size::Small});
+
+  const KDGlyph::Style style{m_controller->isSending() ? k_muted : k_text, k_field,
+                             KDFont::Size::Small};
+  const int x = field.x() + 4;
+  const int y = field.y() + 3;
+  if (input.isEmpty()) {
+    const char* hint = m_controller->isSending() ? "Envoi..." : "Ecris un message, EXE envoie";
+    ctx->drawString(hint, KDPoint(x, y), {k_muted, k_field, KDFont::Size::Small});
+    ctx->fillRect(KDRect(x, y, 1, k_glyphHeight), k_text);
+    return;
+  }
+  /* Show the end of the text on two lines, cut by glyph count (typing is
+   * easier to follow without word wrap). */
+  const char* start = input.text();
+  const int total = glyphs(start, input.length());
+  const int rows = total / k_inputColumns + 1;  // the cursor needs room too
+  int skip = (rows > 2 ? rows - 2 : 0) * k_inputColumns;
+  while (skip-- > 0 && *start != '\0') {
+    start = nextGlyph(start);
+  }
+  KDPoint cursor(x, y);
+  for (int row = 0; row < 2; row++) {
+    const char* p = start;
+    int count = 0;
+    while (count < k_inputColumns && *p != '\0') {
+      p = nextGlyph(p);
+      count++;
+    }
+    const int rowY = y + row * k_lineHeight;
+    drawPart(ctx, start, static_cast<int>(p - start), KDPoint(x, rowY), style);
+    if (count < k_inputColumns) {
+      cursor = KDPoint(x + count * k_glyphWidth, rowY);
+      break;
+    }
+    start = p;
+  }
+  if (!m_controller->isSending()) {
+    ctx->fillRect(KDRect(cursor.x(), cursor.y(), 1, k_glyphHeight), k_text);
+  }
+}
+
+}  // namespace Numchat
