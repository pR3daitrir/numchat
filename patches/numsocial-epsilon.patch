+#pragma once
+
+#include "descriptor.h"
+
+namespace Ion {
+namespace Device {
+namespace USB {
+
+/* Interface Association Descriptor (IAD), USB 2.0 ECN "Interface
+ * Association Descriptors". Type 0x0B, 8 bytes. Placed before a run of
+ * interfaces that together implement a single function (e.g. CDC
+ * Control + CDC Data for a virtual serial port). A host that
+ * understands IADs will group those interfaces under one function
+ * driver; a host that ignores it still enumerates each interface
+ * independently.
+ *
+ * For our composite Termia USB device the IAD groups the CDC Control
+ * interface and the CDC Data interface. */
+class InterfaceAssociationDescriptor : public Descriptor {
+ public:
+  constexpr InterfaceAssociationDescriptor(uint8_t bFirstInterface,
+                                           uint8_t bInterfaceCount,
+                                           uint8_t bFunctionClass,
+                                           uint8_t bFunctionSubClass,
+                                           uint8_t bFunctionProtocol,
+                                           uint8_t iFunction)
+      : Descriptor(0x0B),
+        m_bFirstInterface(bFirstInterface),
+        m_bInterfaceCount(bInterfaceCount),
+        m_bFunctionClass(bFunctionClass),
+        m_bFunctionSubClass(bFunctionSubClass),
+        m_bFunctionProtocol(bFunctionProtocol),
+        m_iFunction(iFunction) {}
+  constexpr static uint8_t BLength() {
+    return Descriptor::BLength() + 6 * sizeof(uint8_t);
+  }
+
+ protected:
+  void push(Channel* c) const override;
+  uint8_t bLength() const override { return BLength(); }
+
+ private:
+  uint8_t m_bFirstInterface;
+  uint8_t m_bInterfaceCount;
+  uint8_t m_bFunctionClass;
+  uint8_t m_bFunctionSubClass;
+  uint8_t m_bFunctionProtocol;
+  uint8_t m_iFunction;
+};
+
+}  // namespace USB
+}  // namespace Device
+}  // namespace Ion
