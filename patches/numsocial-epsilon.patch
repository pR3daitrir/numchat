+
+const Escher::Image* App::Descriptor::icon() const {
+  return ImageStore::NumtubeIcon;
+}
+
+App* App::Snapshot::unpack(Escher::Container* container) {
+  return new (container->currentAppBuffer()) App(this);
+}
+
+const App::Descriptor* App::Snapshot::descriptor() const {
+  constexpr static Descriptor s_descriptor;
+  return &s_descriptor;
+}
+
+App::App(Snapshot* snapshot)
+    : Escher::App(snapshot, &m_mainController),
+      m_mainController(&m_modalViewController),
+      m_usbTimer(&m_mainController) {}
+
+void App::willBecomeInactive() {
+  // Give the USB port back, and leave the keyboard as we found it.
+  m_mainController.disconnect();
+  Ion::Events::setShiftAlphaStatus(Ion::Events::ShiftAlphaStatus());
+  Escher::App::willBecomeInactive();
+}
