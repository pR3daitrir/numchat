diff --git a/shared/ion/include/ion/termia_usb.h b/shared/ion/include/ion/termia_usb.h
new file mode 100644
index 0000000000..fdaec41ecd
--- /dev/null
+++ b/shared/ion/include/ion/termia_usb.h
@@ -0,0 +1,107 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace Ion {
+namespace USB {
+namespace Termia {
+
+/* Tethered-mode USB entry point for Termia's userland.
+ *
+ * `runEnumerationProbe(durationMs)` blocks for the requested window:
+ * it stack-builds a TermiaBridge, enables the pullup, spins a poll
+ * loop, then detaches and disables. Returning control to the caller.
+ *
+ * This is a one-shot diagnostic — bulk endpoint data plumbing is
+ * Phase 6c+ work. Persistent tether (USB up while Termia is
+ * interactive) is also deferred; the current userland RAM budget
+ * doesn't leave room for a static TermiaBridge instance, so "up for
+ * the duration of one call" is all we can offer today.
+ *
+ * Return value: number of poll loop iterations executed. 0 on
+ * simulator (no USB controller). */
+uint32_t runEnumerationProbe(uint32_t durationMs);
+
+/* Like runEnumerationProbe but enables bulk-endpoint echo on the CDC
+ * Data interface: every packet the host writes to /dev/ttyACMn is
+ * immediately written back. Used to validate Session-4 bulk endpoint
+ * RX/TX plumbing end-to-end. */
+uint32_t runEchoProbe(uint32_t durationMs);
+
+/* TMIA-server mode: the device answers PING frames from the host
+ * (e.g. `termia-bridge ping`) with PONG frames carrying the same
+ * nonce. Non-PING frames are dropped. Runs for `durationMs` and
+ * returns the poll-loop iteration count. */
+uint32_t runTmiaServerProbe(uint32_t durationMs);
+
+/* Calc-initiated Claude query. Sends a TMIA ClaudeRequest frame with
+ * `prompt` as payload and streams incoming ClaudeChunk frames to
+ * `sink`. Exits on ClaudeDone, Error, or `timeoutMs` whichever first.
+ *
+ * `sink` is called once per chunk frame payload (the first byte is
+ * the ChunkKind; the rest is the chunk text). Return `true` from the
+ * sink to continue, `false` to abort.
+ *
+ * The USB pullup and host-side cdc_acm binding are retained between
+ * calls — only the first invocation pays the enumeration cost
+ * (~5 s); subsequent calls skip straight to sending and are instant.
+ * Call closeTether() explicitly when done to drop the pullup, or let
+ * the Termia app's willBecomeInactive do it automatically.
+ *
+ * Returns:
+ *   0  simulator (no USB) — caller should fall back to host-local claude
+ *  >0  the number of chunk frames delivered (1 for an immediate Done). */
+using ClaudeChunkSink = bool (*)(const uint8_t* payload, uint16_t len,
+                                 void* userData);
+uint32_t runClaudeProbe(const char* prompt, uint32_t timeoutMs,
+                        ClaudeChunkSink sink, void* userData);
+
+/* True if a prior call left the USB pullup active and the host's
+ * cdc_acm stack bound. Subsequent Claude calls skip enumeration. */
+bool isTetheredActive();
+
+/* Drop the USB pullup, letting the host tear down /dev/ttyACMn.
+ * Safe to call even if not currently tethered. The Termia app wires
+ * this into its willBecomeInactive hook so leaving the app
+ * automatically disconnects. */
+void closeTether();
+
+/* Callback invoked for every SyncEntry streamed back from the host
+ * during a sync-list round-trip. `name` is NUL-terminated; `size`
+ * and `mtimeUnix` are as reported by the host filesystem. Return
+ * `true` to keep receiving, `false` to abort. */
+using SyncListSink = bool (*)(const char* name, uint32_t size,
+                              uint32_t mtimeUnix, void* userData);
+
+/* Round-trip a SYNC_LIST request. Sends an empty SYNC_LIST frame,
+ * waits for the host's response, calls `sink` once per entry in
+ * the returned list. Returns the number of entries delivered, or
+ * 0 on failure (no tether, timeout, malformed response). */
+uint32_t syncList(SyncListSink sink, void* userData, uint32_t timeoutMs);
+
+/* Long-lived byte stream over the same CDC link (used by NumTube).
+ *
+ * The USB device object lives in caller-provided storage so that a whole
+ * browsing session can stay connected without using static RAM. */
+constexpr size_t k_streamStorageSize = 3072;
+
+/* Forces a fresh enumeration as a serial device. Returns immediately;
+ * poll streamReady() until the host has configured the link. */
+bool streamBegin(void* storage, size_t storageSize);
+bool streamReady();
+/* Answers pending USB control requests (no data is read) for about
+ * durationMs. Call it regularly while not reading, so that the host never
+ * waits on the calculator. */
+void streamService(uint32_t durationMs);
+/* Drops the connection. Safe to call at any time. */
+void streamEnd();
+/* Fetches one USB packet (at most 64 bytes, cap must be >= 64). Never
+ * blocks. Returns the number of bytes copied. */
+uint16_t streamRead(uint8_t* buffer, uint16_t cap);
+/* Sends bytes, giving up after timeoutMs if the host stops reading. */
+bool streamWrite(const uint8_t* data, size_t length, uint32_t timeoutMs);
+
+}  // namespace Termia
+}  // namespace USB
+}  // namespace Ion
