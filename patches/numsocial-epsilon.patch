diff --git a/epsilon/apps/termia/tmia/tmia.cpp b/epsilon/apps/termia/tmia/tmia.cpp
new file mode 100644
index 0000000000..0ed6f3c436
--- /dev/null
+++ b/epsilon/apps/termia/tmia/tmia.cpp
@@ -0,0 +1,112 @@
+#include "tmia.h"
+
+#include <string.h>
+
+namespace Termia {
+namespace TMIA {
+
+uint16_t crc16(const uint8_t* data, size_t len) {
+  uint16_t crc = 0xFFFF;
+  for (size_t i = 0; i < len; i++) {
+    crc ^= static_cast<uint16_t>(data[i]) << 8;
+    for (int bit = 0; bit < 8; bit++) {
+      if (crc & 0x8000) {
+        crc = (crc << 1) ^ 0x1021;
+      } else {
+        crc <<= 1;
+      }
+    }
+  }
+  return crc;
+}
+
+size_t encode(FrameType type, const uint8_t* payload, size_t payloadLen,
+              uint8_t* out, size_t outCap, EncodeError* err) {
+  auto setErr = [err](EncodeError e) {
+    if (err) *err = e;
+  };
+  if (payloadLen > kMaxPayload) {
+    setErr(EncodeError::PayloadTooLarge);
+    return 0;
+  }
+  const size_t total = kHeaderLen + payloadLen + kCrcLen;
+  if (outCap < total) {
+    setErr(EncodeError::BufferTooSmall);
+    return 0;
+  }
+  memcpy(out, kMagic, 4);
+  out[4] = kVersion;
+  out[5] = static_cast<uint8_t>(type);
+  out[6] = static_cast<uint8_t>(payloadLen & 0xFF);
+  out[7] = static_cast<uint8_t>(payloadLen >> 8);
+  if (payloadLen > 0 && payload != nullptr) {
+    memcpy(out + kHeaderLen, payload, payloadLen);
+  }
+  const uint16_t c = crc16(out, kHeaderLen + payloadLen);
+  out[kHeaderLen + payloadLen] = static_cast<uint8_t>(c & 0xFF);
+  out[kHeaderLen + payloadLen + 1] = static_cast<uint8_t>(c >> 8);
+  setErr(EncodeError::None);
+  return total;
+}
+
+const uint8_t* decode(const uint8_t* bytes, size_t bytesLen, FrameType* outType,
+                      size_t* outPayloadLen, DecodeError* err) {
+  auto setErr = [err](DecodeError e) {
+    if (err) *err = e;
+  };
+  if (bytesLen < kHeaderLen + kCrcLen) {
+    setErr(DecodeError::Underflow);
+    return nullptr;
+  }
+  if (memcmp(bytes, kMagic, 4) != 0) {
+    setErr(DecodeError::BadMagic);
+    return nullptr;
+  }
+  if (bytes[4] != kVersion) {
+    setErr(DecodeError::BadVersion);
+    return nullptr;
+  }
+  // Validate type byte.
+  switch (static_cast<FrameType>(bytes[5])) {
+    case FrameType::ClaudeRequest:
+    case FrameType::ClaudeChunk:
+    case FrameType::ClaudeDone:
+    case FrameType::SyncList:
+    case FrameType::SyncPush:
+    case FrameType::SyncPull:
+    case FrameType::Error:
+    case FrameType::Ping:
+    case FrameType::Pong:
+    case FrameType::Hello:
+    case FrameType::HelloAck:
+      break;
+    default:
+      setErr(DecodeError::UnknownType);
+      return nullptr;
+  }
+  const size_t len = static_cast<size_t>(bytes[6]) |
+                     (static_cast<size_t>(bytes[7]) << 8);
+  if (len > kMaxPayload) {
+    setErr(DecodeError::LengthOverflow);
+    return nullptr;
+  }
+  if (bytesLen < kHeaderLen + len + kCrcLen) {
+    setErr(DecodeError::LengthOverflow);
+    return nullptr;
+  }
+  const uint16_t expected = crc16(bytes, kHeaderLen + len);
+  const uint16_t actual =
+      static_cast<uint16_t>(bytes[kHeaderLen + len]) |
+      (static_cast<uint16_t>(bytes[kHeaderLen + len + 1]) << 8);
+  if (expected != actual) {
+    setErr(DecodeError::BadCrc);
+    return nullptr;
+  }
+  if (outType) *outType = static_cast<FrameType>(bytes[5]);
+  if (outPayloadLen) *outPayloadLen = len;
+  setErr(DecodeError::None);
+  return bytes + kHeaderLen;
+}
+
+}  // namespace TMIA
+}  // namespace Termia
diff --git a/epsilon/apps/termia/tmia/tmia.h b/epsilon/apps/termia/tmia/tmia.h
new file mode 100644
index 0000000000..cff0b4efd3
--- /dev/null
+++ b/epsilon/apps/termia/tmia/tmia.h
@@ -0,0 +1,82 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+// TMIA wire-format codec for Termia — C++ mirror of the Rust
+// termia-protocol crate. Same byte layout (see TERMIA.md §6.4):
+//
+//   +0  +1  +2  +3  +4  +5  +6  +7  +8 ... +N  +N+1 +N+2
+//   | 'T' 'M' 'I' 'A' |ver|type| length |  payload  | crc16 |
+//
+// Shared constants and FrameType codes are kept in sync by hand with
+// bridge/crates/termia-protocol/src/lib.rs. Test: the CRC vector
+// matches the CCITT-FALSE standard check (0x29B1 for "123456789").
+//
+// Phase 6 adds full encode/decode here, ready for whichever transport
+// (USB CDC, or the simulator's TCP echo) eventually carries the bytes.
+namespace Termia {
+namespace TMIA {
+
+inline constexpr uint8_t kMagic[4] = {'T', 'M', 'I', 'A'};
+inline constexpr uint8_t kVersion = 1;
+inline constexpr size_t kHeaderLen = 8;
+inline constexpr size_t kCrcLen = 2;
+inline constexpr size_t kMaxPayload = 4096;
+inline constexpr size_t kMaxFrame = kHeaderLen + kMaxPayload + kCrcLen;
+
+enum class FrameType : uint8_t {
+  ClaudeRequest = 0x01,
+  ClaudeChunk = 0x02,
+  ClaudeDone = 0x03,
+  SyncList = 0x04,
+  SyncPush = 0x05,
+  SyncPull = 0x06,
+  Error = 0x07,
+  Ping = 0x08,
+  Pong = 0x09,
+  Hello = 0x0A,
+  HelloAck = 0x0B,
+};
+
+enum class ChunkKind : uint8_t {
+  TextDelta = 0x01,
+  ToolUse = 0x02,
+  Thinking = 0x03,
+  Error = 0x04,
+};
+
+enum class EncodeError {
+  None = 0,
+  BufferTooSmall,
+  PayloadTooLarge,
+};
+
+enum class DecodeError {
+  None = 0,
+  Underflow,
+  BadMagic,
+  BadVersion,
+  UnknownType,
+  LengthOverflow,
+  BadCrc,
+};
+
+// CRC-16/CCITT-FALSE: poly 0x1021, init 0xFFFF, no reflect, xor-out 0.
+uint16_t crc16(const uint8_t* data, size_t len);
+
+// Encode a frame. Returns bytes written on success, 0 on error
+// (inspect `err` for the reason). `out` must be at least
+// kHeaderLen + payloadLen + kCrcLen bytes.
+size_t encode(FrameType type, const uint8_t* payload, size_t payloadLen,
+              uint8_t* out, size_t outCap, EncodeError* err = nullptr);
+
+// Decode a frame. On success, writes the frame type to `outType` and
+// returns a pointer to the payload bytes inside `bytes`; `outPayloadLen`
+// receives the payload length. Returns nullptr on any error (see `err`).
+const uint8_t* decode(const uint8_t* bytes, size_t bytesLen,
+                      FrameType* outType, size_t* outPayloadLen,
+                      DecodeError* err = nullptr);
+
+}  // namespace TMIA
+}  // namespace Termia
diff --git a/epsilon/apps/termia/ui/shell_controller.cpp b/epsilon/apps/termia/ui/shell_controller.cpp
new file mode 100644
index 0000000000..a96e985f19
--- /dev/null
+++ b/epsilon/apps/termia/ui/shell_controller.cpp
@@ -0,0 +1,29 @@
+#include "shell_controller.h"
+
+namespace Termia {
+
+ShellController::ShellController(Escher::Responder* parentResponder,
+                                  Scrollback* scrollback, History* history)
+    : Escher::ViewController(parentResponder),
+      m_shell(scrollback, history),
+      m_view(&m_shell) {}
+
+void ShellController::viewWillAppear() {
+  m_shell.init();  // idempotent; prints the welcome banner on first entry
+  m_view.redrawAll();
+}
+
+bool ShellController::handleEvent(Ion::Events::Event event) {
+  // Home and Back are left unhandled so Epsilon's container exits the
+  // app naturally. The shell never consumes them.
+  if (event == Ion::Events::Home || event == Ion::Events::Back) {
+    return false;
+  }
+  if (m_shell.handleEvent(event)) {
+    m_view.redrawAll();
+    return true;
+  }
+  return false;
+}
+
+}  // namespace Termia
