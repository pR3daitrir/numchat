+
+namespace Ion {
+namespace Device {
+namespace USB {
+
+using namespace Regs;
+
+/* Distinct PID from the DFU mode (Config::PID = 0xA291) so `lsusb` and
+ * udev rules can tell the two modes apart on sight. Same STMicro VID
+ * (0x0483) as Calculator — the bridge daemon only checks VID. */
+static constexpr uint16_t k_termiaBridgePID = 0xA292;
+static constexpr uint16_t k_termiaBridgeBCD = 0x0100;  // Termia USB iface v1.0
+
+static constexpr uint16_t k_configurationTotalLength =
+    ConfigurationDescriptor::BLength() + InterfaceDescriptor::BLength() +
+    2 * EndpointDescriptor::BLength();
+// Same vendor code as the DFU device (calculator.h).
+static constexpr uint8_t k_microsoftOSVendorCode = 2;
+
+TermiaBridge::TermiaBridge(const char* serialNumber)
+    : Device(&m_cdcInterface),
+      m_cdcInterface(&m_ep0),
+      m_bulkInEndpoint(k_cdcBulkInEndpoint, 0x02 /* bulk */,
+                       k_cdcBulkMaxPacketSize, 0),
+      m_bulkOutEndpoint(k_cdcBulkOutEndpoint, 0x02, k_cdcBulkMaxPacketSize, 0,
+                        &m_bulkInEndpoint),
+      m_dataInterface(0,     // bInterfaceNumber
+                      0,     // bAlternateSetting
+                      2,     // bNumEndpoints
+                      0xFF,  // vendor class
+                      0x00, 0x00, 0, &m_bulkOutEndpoint),
+      m_interfaces{m_dataInterface},
+      m_configurationDescriptor(k_configurationTotalLength,
+                                1,  // bNumInterfaces
+                                k_bConfigurationValue, 0,
+                                0x80,  // bus-powered
+                                0x32,  // 100 mA
+                                m_interfaces),
+      m_deviceDescriptor(0x0200,  // USB 2.0 (no BOS needed)
+                         0x00, 0x00, 0x00,  // class defined by the interface
+                         64, 0x0483, k_termiaBridgePID, k_termiaBridgeBCD,
+                         1, 2, 3, 1),
+      m_manufacturerStringDescriptor("NumWorks"),
+      m_productStringDescriptor("NumWorks NumTube"),
+      m_serialNumberStringDescriptor(serialNumber),
+      m_microsoftOSStringDescriptor(k_microsoftOSVendorCode),
+      m_extendedCompatIdDescriptor("WINUSB"),
+      m_descriptors{makeDescriptorList(
+          &m_deviceDescriptor,              // type = Device, index = 0
+          &m_configurationDescriptor,       // type = Configuration, index = 0
+          &m_languageStringDescriptor,      // type = String, index = 0
+          &m_manufacturerStringDescriptor,  // type = String, index = 1
+          &m_productStringDescriptor,       // type = String, index = 2
+          &m_serialNumberStringDescriptor   // type = String, index = 3
