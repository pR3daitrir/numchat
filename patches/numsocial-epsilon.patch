+#pragma once
+
+#include <escher/view_controller.h>
+
+#include "link.h"
+#include "main_view.h"
+#include "player.h"
+
+namespace Numtube {
+
+class MainController : public Escher::ViewController {
+ public:
+  explicit MainController(Escher::Responder* parentResponder);
+
+  enum class Screen { Search, Message, Results };
+  struct Result {
+    char id[17];
+    uint32_t durationSeconds;
+    char title[92];
+    char channel[32];
+  };
+  static constexpr int k_maxResults = 8;
+  static constexpr int k_visibleRows = 5;
+  static constexpr int k_queryCapacity = 64;
+
+  Escher::View* view() override { return &m_view; }
+  bool handleEvent(Ion::Events::Event event) override;
+  void viewWillAppear() override;
+  void disconnect() { m_link.disconnect(); }
+  void serviceLink() { m_link.service(); }
+
+  // Accessors for MainView.
+  Screen screen() const { return m_screen; }
+  const char* query() const { return m_query; }
+  const char* message() const { return m_message; }
+  int resultCount() const { return m_resultCount; }
+  const Result& result(int index) const { return m_results[index]; }
+  int selection() const { return m_selection; }
+  int firstVisible() const { return m_firstVisible; }
+
+ private:
+  bool handleSearchEvent(Ion::Events::Event event);
+  bool handleResultsEvent(Ion::Events::Event event);
+  void showSearch();
+  void showResults();
+  void showMessage(const char* message);
+  void showMessageNow(const char* message);
+  void redrawNow();
+  bool ensureConnected();
+  void runSession();
+  void runSearch();
+  void browseResults();
+  void moveSelection(int delta);
+  void runPlayer();
+  void parseResult(const uint8_t* payload, uint16_t length);
+  void showErrorThenSearch(const char* message);
+
+  MainView m_view;
+  Link m_link;
+  Player m_player;
+  Screen m_screen;
+  char m_query[k_queryCapacity];
+  char m_message[120];
+  Result m_results[k_maxResults];
+  int m_resultCount;
+  int m_selection;
+  int m_firstVisible;
+  bool m_messageNeedsKey;
+};
+
+}  // namespace Numtube
diff --git a/epsilon/apps/numtube/main_view.cpp b/epsilon/apps/numtube/main_view.cpp
new file mode 100644
index 0000000000..625848855f
--- /dev/null
+++ b/epsilon/apps/numtube/main_view.cpp
@@ -0,0 +1,192 @@
+#include "main_view.h"
+
+#include <kandinsky/font.h>
+#include <string.h>
+
+#include "main_controller.h"
+
+namespace Numtube {
+
+namespace {
+
+constexpr KDColor k_background = KDColor::RGB24(0x101010);
+constexpr KDColor k_selected = KDColor::RGB24(0x3A1412);
+constexpr KDColor k_field = KDColor::RGB24(0x282828);
+constexpr KDColor k_text = KDColorWhite;
+constexpr KDColor k_muted = KDColor::RGB24(0xA0A0A0);
+constexpr KDColor k_accent = KDColor::RGB24(0xE5322D);
+
+constexpr int k_smallWidth = KDFont::GlyphMaxWidth(KDFont::Size::Small);
+constexpr int k_smallHeight = KDFont::GlyphHeight(KDFont::Size::Small);
+constexpr int k_largeWidth = KDFont::GlyphMaxWidth(KDFont::Size::Large);
+constexpr int k_largeHeight = KDFont::GlyphHeight(KDFont::Size::Large);
+constexpr int k_screenWidth = 320;
+constexpr int k_rowHeight = 44;
+constexpr int k_titleColumns = 44;
+
+// Byte length of at most maxGlyphs characters of a UTF-8 string, cut after a
+// space when the text continues past that point.
+int prefixLength(const char* text, int maxGlyphs, bool wordBreak) {
+  int bytes = 0;
+  int glyphs = 0;
+  int lastSpace = -1;
+  while (text[bytes] != '\0' && glyphs < maxGlyphs) {
+    if (text[bytes] == ' ') {
+      lastSpace = bytes;
+    }
+    bytes++;
+    // Skip continuation bytes and combining accents (lead byte 0xCC/0xCD).
+    while ((static_cast<uint8_t>(text[bytes]) & 0xC0) == 0x80 ||
+           static_cast<uint8_t>(text[bytes]) == 0xCC ||
+           static_cast<uint8_t>(text[bytes]) == 0xCD) {
+      bytes++;
+    }
+    glyphs++;
+  }
+  if (wordBreak && text[bytes] != '\0' && lastSpace > 0) {
+    return lastSpace;
+  }
+  return bytes;
+}
+
+void formatDuration(uint32_t seconds, char* out) {
+  const uint32_t hours = seconds / 3600;
+  const uint32_t minutes = (seconds % 3600) / 60;
+  const uint32_t secs = seconds % 60;
+  char* p = out;
+  if (hours > 0) {
+    if (hours >= 10) {
+      *p++ = static_cast<char>('0' + hours / 10);
+    }
+    *p++ = static_cast<char>('0' + hours % 10);
+    *p++ = ':';
+  }
+  if (hours > 0 || minutes >= 10) {
+    *p++ = static_cast<char>('0' + minutes / 10);
+  }
+  *p++ = static_cast<char>('0' + minutes % 10);
+  *p++ = ':';
+  *p++ = static_cast<char>('0' + secs / 10);
+  *p++ = static_cast<char>('0' + secs % 10);
+  *p = '\0';
+}
+
+KDPoint centered(const char* text, int y, int glyphWidth) {
+  int glyphs = 0;
+  for (const char* c = text; *c != '\0'; c++) {
+    const uint8_t byte = static_cast<uint8_t>(*c);
+    glyphs += (byte & 0xC0) != 0x80 && byte != 0xCC && byte != 0xCD;
+  }
+  return KDPoint((k_screenWidth - glyphs * glyphWidth) / 2, y);
+}
+
+}  // namespace
+
+void MainView::drawRect(KDContext* ctx, KDRect rect) const {
+  ctx->fillRect(bounds(), k_background);
+  switch (m_controller->screen()) {
+    case MainController::Screen::Search:
+      drawSearch(ctx);
+      break;
+    case MainController::Screen::Message:
+      drawMessage(ctx);
+      break;
+    case MainController::Screen::Results:
+      drawResults(ctx);
+      break;
+  }
+}
+
+void MainView::drawSearch(KDContext* ctx) const {
+  const KDGlyph::Style title{k_accent, k_background, KDFont::Size::Large};
+  const char* heading = "Recherche YouTube";
+  ctx->drawString(heading, centered(heading, 34, k_largeWidth), title);
+
+  const KDRect field(16, 66, k_screenWidth - 32, k_largeHeight + 16);
+  ctx->fillRect(field, k_field);
+  ctx->fillRect(KDRect(16, field.bottom(), field.width(), 2), k_accent);
+
+  const char* query = m_controller->query();
+  const int columns = (field.width() - 16) / k_largeWidth - 1;
+  int length = static_cast<int>(strlen(query));
+  const char* visible = query + (length > columns ? length - columns : 0);
+  length = static_cast<int>(strlen(visible));
+  const KDGlyph::Style input{k_text, k_field, KDFont::Size::Large};
+  const KDPoint end = ctx->drawString(visible, KDPoint(24, 74), input);
+  ctx->fillRect(KDRect(end.x(), 74, 2, k_largeHeight), k_text);
+
+  const KDGlyph::Style hint{k_muted, k_background, KDFont::Size::Small};
+  const char* lines[] = {
+      "Tape ta recherche puis appuie sur EXE",
+      "alpha : lettres / chiffres",
+      "Sur le PC, la passerelle doit tourner :",
+      "./numtube",
+  };
+  int y = 124;
+  for (const char* line : lines) {
+    ctx->drawString(line, centered(line, y, k_smallWidth), hint);
+    y += k_smallHeight + 6;
+  }
+}
+
+void MainView::drawMessage(KDContext* ctx) const {
+  const char* message = m_controller->message();
+  const int height = bounds().height();
+  // Messages are short; split on '\n' into centred lines.
+  int y = (height - 2 * k_largeHeight) / 2;
+  const char* line = message;
+  const KDGlyph::Style style{k_text, k_background, KDFont::Size::Large};
+  char buffer[40];
+  while (*line != '\0') {
+    const char* end = strchr(line, '\n');
+    size_t bytes = end ? static_cast<size_t>(end - line) : strlen(line);
+    size_t copy = bytes < sizeof(buffer) - 1 ? bytes : sizeof(buffer) - 1;
+    memcpy(buffer, line, copy);
+    buffer[copy] = '\0';
+    ctx->drawString(buffer, centered(buffer, y, k_largeWidth), style);
+    y += k_largeHeight + 4;
+    line += bytes;
+    if (*line == '\n') {
+      line++;
+    }
+  }
+}
+
+void MainView::drawResults(KDContext* ctx) const {
+  const int count = m_controller->resultCount();
+  const int first = m_controller->firstVisible();
+  const int selected = m_controller->selection();
+  int y = 1;
+  for (int i = first; i < count && i < first + MainController::k_visibleRows; i++) {
+    const MainController::Result& result = m_controller->result(i);
+    const KDColor background = i == selected ? k_selected : k_background;
+    ctx->fillRect(KDRect(0, y, k_screenWidth, k_rowHeight - 1), background);
+    if (i == selected) {
+      ctx->fillRect(KDRect(0, y, 3, k_rowHeight - 1), k_accent);
+    }
+    const KDGlyph::Style titleStyle{k_text, background, KDFont::Size::Small};
+    const char* title = result.title;
+    int bytes = prefixLength(title, k_titleColumns, true);
+    ctx->drawString(title, KDPoint(7, y + 1), titleStyle, bytes);
+    title += bytes;
+    if (*title == ' ') {
+      title++;
+    }
+    ctx->drawString(title, KDPoint(7, y + 1 + k_smallHeight), titleStyle,
+                    prefixLength(title, k_titleColumns, false));
+
+    const KDGlyph::Style metaStyle{k_muted, background, KDFont::Size::Small};
+    char duration[12];
+    formatDuration(result.durationSeconds, duration);
+    int durationGlyphs = static_cast<int>(strlen(duration));
+    ctx->drawString(duration,
+                    KDPoint(k_screenWidth - 6 - durationGlyphs * k_smallWidth,
+                            y + 1 + 2 * k_smallHeight),
+                    metaStyle);
+    ctx->drawString(result.channel, KDPoint(7, y + 1 + 2 * k_smallHeight), metaStyle,
+                    prefixLength(result.channel, k_titleColumns - 9, false));
+    y += k_rowHeight;
+  }
+}
+
+}  // namespace Numtube
