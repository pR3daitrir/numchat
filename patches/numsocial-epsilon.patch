+  void willBecomeInactive() override;
+  int numberOfTimers() override { return 1; }
+  Escher::Timer* timerAtIndex(int i) override { return &m_usbTimer; }
+
+ private:
+  // Answers the host's USB requests between screens (every tick, 300 ms).
+  class UsbTimer : public Escher::Timer {
+   public:
+    explicit UsbTimer(MainController* controller)
+        : Escher::Timer(1), m_controller(controller) {}
+
+   private:
+    bool fire() override {
+      m_controller->serviceLink();
+      return false;
+    }
+    MainController* m_controller;
+  };
+
+  App(Snapshot* snapshot);
+  MainController m_mainController;
+  UsbTimer m_usbTimer;
+};
