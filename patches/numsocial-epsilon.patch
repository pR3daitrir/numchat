+#pragma once
+
+#include <apps/i18n.h>
+#include <escher/app.h>
+
+#include "screen_controller.h"
+
+namespace Numscreen {
+
+class App : public Escher::App {
+ public:
+  class Descriptor : public Escher::App::Descriptor {
+   public:
+    I18n::Message name() const override { return I18n::Message::NumscreenApp; }
+    I18n::Message upperName() const override {
+      return I18n::Message::NumscreenAppCapital;
+    }
+    const Escher::Image* icon() const override;
+  };
+
+  class Snapshot : public Escher::App::Snapshot {
+   public:
+    App* unpack(Escher::Container* container) override;
+    const Descriptor* descriptor() const override;
+  };
+
+  void willBecomeInactive() override;
+  int numberOfTimers() override { return 1; }
+  Escher::Timer* timerAtIndex(int i) override { return &m_usbTimer; }
+
+ private:
+  // Starts the session once the app is on screen (every tick, 100 ms).
+  class UsbTimer : public Escher::Timer {
+   public:
+    explicit UsbTimer(ScreenController* controller)
+        : Escher::Timer(1), m_controller(controller) {}
+
+   private:
+    bool fire() override {
+      m_controller->tick();
+      return false;
+    }
+    ScreenController* m_controller;
+  };
+
+  App(Snapshot* snapshot);
+  ScreenController m_controller;
+  UsbTimer m_usbTimer;
+};
+
+}  // namespace Numscreen
