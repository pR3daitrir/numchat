diff --git a/epsilon/apps/numtube/player.cpp b/epsilon/apps/numtube/player.cpp
new file mode 100644
index 0000000000..414462c819
--- /dev/null
+++ b/epsilon/apps/numtube/player.cpp
@@ -0,0 +1,398 @@
+#include "player.h"
+
+#include <ion/display.h>
+#include <ion/timing.h>
+#include <ion/usb.h>
+#include <kandinsky/font.h>
+#include <string.h>
+
+#if !defined(PLATFORM_DEVICE)
+#include <stdio.h>
+#include <stdlib.h>
+#endif
+
+#include "protocol.h"
+
+namespace Numtube {
+
+namespace {
+
+constexpr KDColor k_black = KDColorBlack;
+constexpr KDColor k_barBackground = KDColor::RGB24(0x404040);
+constexpr KDColor k_barFill = KDColor::RGB24(0xE5322D);
+constexpr KDColor k_subtitleColor = KDColorWhite;
+constexpr KDColor k_statusColor = KDColor::RGB24(0xFFB734);
+constexpr KDFont::Size k_font = KDFont::Size::Large;
+
+constexpr uint32_t k_firstFrameTimeoutMs = 90000;
+constexpr uint32_t k_streamTimeoutMs = 20000;
+constexpr int32_t k_shortSeekMs = 10000;
+constexpr int32_t k_longSeekMs = 60000;
+
+static_assert(sizeof(KDColor) == sizeof(uint16_t), "KDColor must be RGB565");
+
+KDContext* screenContext() {
+  KDContext* context = Ion::Display::Context::SharedContext;
+  context->setOrigin(KDPointZero);
+  context->setClippingRect(KDRect(0, 0, Ion::Display::Width, Ion::Display::Height));
+  return context;
+}
+
+uint32_t read32(const uint8_t* p) {
+  return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) |
+         (static_cast<uint32_t>(p[2]) << 16) |
+         (static_cast<uint32_t>(p[3]) << 24);
+}
+
+// Accents arrive as combining marks (U+0300-U+036F, lead byte 0xCC or 0xCD),
+// drawn over the previous letter: they take no width.
+int glyphCount(const char* text, int bytes) {
+  int count = 0;
+  for (int i = 0; i < bytes; i++) {
+    const uint8_t byte = static_cast<uint8_t>(text[i]);
+    if ((byte & 0xC0) != 0x80 && byte != 0xCC && byte != 0xCD) {
+      count++;
+    }
+  }
+  return count;
+}
+
+#if !defined(PLATFORM_DEVICE)
+/* Simulator-only test hook: with NUMTUBE_SCREENSHOT=/path/prefix, writes the
+ * screen as a PPM file every 100 frames (macOS blocks normal captures). */
+void debugScreenshot(uint32_t frameCount) {
+  const char* prefix = getenv("NUMTUBE_SCREENSHOT");
+  if (prefix == nullptr || frameCount % 100 != 0) {
+    return;
+  }
+  char path[512];
+  snprintf(path, sizeof(path), "%s-%04u.ppm", prefix, static_cast<unsigned>(frameCount));
+  FILE* file = fopen(path, "wb");
+  if (file == nullptr) {
+    return;
+  }
+  fprintf(file, "P6 %d %d 255\n", Ion::Display::Width, Ion::Display::Height);
+  KDColor line[Ion::Display::Width];
+  for (int y = 0; y < Ion::Display::Height; y++) {
+    Ion::Display::pullRect(KDRect(0, y, Ion::Display::Width, 1), line);
+    for (KDColor c : line) {
+      const uint8_t rgb[3] = {c.red(), c.green(), c.blue()};
+      fwrite(rgb, 1, 3, file);
+    }
+  }
+  fclose(file);
+}
+#endif
+
+}  // namespace
+
+Player::Player(Link* link)
+    : m_link(link),
+      m_decoder(m_rowBuffer, this),
+      m_durationMs(0),
+      m_progressX(0),
+      m_framesShown(0),
+      m_started(false),
+      m_paused(false),
+      m_stripDirty(false),
+      m_hasSubtitles(false) {
+  m_subtitle[0] = m_status[0] = m_error[0] = '\0';
+}
+
+void Player::push(int x, int y, int width, const uint16_t* pixels) {
+  Ion::Display::pushRect(KDRect(x, y, width, 1),
+                         reinterpret_cast<const KDColor*>(pixels));
+}
+
+void Player::clearScreen() {
+  Ion::Display::pushRectUniform(
+      KDRect(0, 0, Ion::Display::Width, Ion::Display::Height), k_black);
+  Ion::Display::pushRectUniform(KDRect(0, k_barY, Ion::Display::Width, k_barHeight),
+                                k_barBackground);
+}
+
+void Player::drawProgress(uint32_t positionMs) {
+  if (m_durationMs == 0) {
+    return;
+  }
+  const uint64_t scaled = static_cast<uint64_t>(positionMs) * Ion::Display::Width;
+  int x = static_cast<int>(scaled / m_durationMs);
+  x = x > Ion::Display::Width ? Ion::Display::Width : x;
+  if (x == m_progressX) {
+    return;
+  }
+  if (x > m_progressX) {
+    Ion::Display::pushRectUniform(
+        KDRect(m_progressX, k_barY, x - m_progressX, k_barHeight), k_barFill);
+  } else {
+    Ion::Display::pushRectUniform(
+        KDRect(x, k_barY, m_progressX - x, k_barHeight), k_barBackground);
+  }
+  m_progressX = x;
+}
+
+void Player::drawStrip() {
+  m_stripDirty = false;
+  KDContext* context = screenContext();
+  context->fillRect(KDRect(0, k_stripY, Ion::Display::Width, k_stripHeight), k_black);
+
+  const char* text = m_subtitle;
+  KDColor color = k_subtitleColor;
+  if (m_status[0] != '\0') {
+    text = m_status;
+    color = k_statusColor;
+  } else if (m_paused) {
+    text = "II  Pause";
+    color = k_statusColor;
+  }
+
+  // Count the lines first so that the block is vertically centred.
+  int lines = 0;
+  for (const char* c = text; *c != '\0'; c++) {
+    lines += (*c == '\n');
+  }
+  lines += (*text != '\0');
+
+  const int glyphWidth = KDFont::GlyphMaxWidth(k_font);
+  const int glyphHeight = KDFont::GlyphHeight(k_font);
+  int y = k_stripY + (k_stripHeight - lines * glyphHeight) / 2;
+  const KDGlyph::Style style{color, k_black, k_font};
+  while (*text != '\0') {
+    const char* end = strchr(text, '\n');
+    const int bytes = end ? static_cast<int>(end - text) : static_cast<int>(strlen(text));
+    const int x = (Ion::Display::Width - glyphCount(text, bytes) * glyphWidth) / 2;
+    context->drawString(text, KDPoint(x < 0 ? 0 : x, y), style, bytes);
+    y += glyphHeight;
+    text += bytes;
+    if (*text == '\n') {
+      text++;
+    }
+  }
+}
+
+void Player::copyText(char* destination, int capacity, const uint8_t* source,
+                      uint16_t length) {
+  int count = length < capacity - 1 ? length : capacity - 1;
+  memcpy(destination, source, count);
+  /* The gateway only cuts on character boundaries, but never trust a length
+   * from the wire to leave a partial UTF-8 sequence for the font renderer. */
+  while (count > 0 && (static_cast<uint8_t>(destination[count - 1]) & 0x80) &&
+         (static_cast<uint8_t>(destination[count - 1]) & 0xC0) == 0xC0) {
+    count--;
+  }
+  destination[count] = '\0';
+}
+
+void Player::sendControl(uint8_t command) { m_link->send(Protocol::Control, &command, 1); }
+
+void Player::sendSeek(int32_t deltaMs) {
+  uint8_t payload[5];
+  payload[0] = Protocol::Seek;
+  const uint32_t value = static_cast<uint32_t>(deltaMs);
+  payload[1] = static_cast<uint8_t>(value);
+  payload[2] = static_cast<uint8_t>(value >> 8);
+  payload[3] = static_cast<uint8_t>(value >> 16);
+  payload[4] = static_cast<uint8_t>(value >> 24);
+  m_link->send(Protocol::Control, payload, sizeof(payload));
+}
+
+bool Player::handleKey(Ion::Keyboard::Key key, Exit* exit) {
+  using Ion::Keyboard::Key;
+  switch (key) {
+    case Key::Back:
+    case Key::Home:
+    case Key::OnOff:
+      *exit = Exit::Stopped;
+      return true;
+    case Key::OK:
+    case Key::EXE:
+      m_paused = !m_paused;
+      sendControl(m_paused ? Protocol::Pause : Protocol::Resume);
+      m_stripDirty = true;
+      break;
+    case Key::Left:
+      sendSeek(-k_shortSeekMs);
+      break;
+    case Key::Right:
+      sendSeek(k_shortSeekMs);
+      break;
+    case Key::Down:
+      sendSeek(-k_longSeekMs);
+      break;
+    case Key::Up:
+      sendSeek(k_longSeekMs);
+      break;
+    default:
+      break;
+  }
+  return false;
+}
+
+bool Player::handleFrame(uint8_t type, const uint8_t* payload, uint16_t length,
+                         Exit* exit) {
+  switch (type) {
+    case Protocol::PlayInfo:
+      if (length >= 6) {
+        m_durationMs = read32(payload);
+        m_hasSubtitles = payload[5] != 0;
+        m_started = true;
+        if (!m_hasSubtitles) {
+          copyText(m_subtitle, k_textCapacity,
+                   reinterpret_cast<const uint8_t*>("(pas de sous-titres)"), 20);
+          m_stripDirty = true;
+        }
+      }
+      break;
+    case Protocol::Video:
+      if (m_started && length >= Protocol::k_videoHeaderLength) {
+        const uint16_t frame = static_cast<uint16_t>(payload[0] | (payload[1] << 8));
+        const uint32_t pts = read32(payload + 2);
+        const uint16_t startTile = static_cast<uint16_t>(payload[6] | (payload[7] << 8));
+        const uint8_t flags = payload[8];
+        m_decoder.decode(startTile, payload + Protocol::k_videoHeaderLength,
+                         length - Protocol::k_videoHeaderLength);
+        if (flags & Protocol::k_videoFlagEndOfFrame) {
+          drawProgress(pts);
+          const uint8_t ack[2] = {static_cast<uint8_t>(frame),
+                                  static_cast<uint8_t>(frame >> 8)};
+          m_link->send(Protocol::Ack, ack, sizeof(ack));
+#if !defined(PLATFORM_DEVICE)
+          if (m_stripDirty) {
+            drawStrip();
+          }
+          debugScreenshot(++m_framesShown);
+#endif
+        }
+      }
+      break;
+    case Protocol::Subtitle:
+      if (m_hasSubtitles) {
+        copyText(m_subtitle, k_textCapacity, payload, length);
+        m_stripDirty = true;
+      }
+      break;
+    case Protocol::Status:
+      copyText(m_status, k_statusCapacity, payload, length);
+      m_stripDirty = true;
+      break;
+    case Protocol::Error:
+      copyText(m_error, sizeof(m_error), payload, length);
+      break;
+    case Protocol::PlayEnd:
+      *exit = (length > 0 && payload[0] != 0) ? Exit::Error : Exit::Finished;
+      return true;
+    default:
+      break;
+  }
+  return false;
+}
+
+Player::Exit Player::play(const char* videoId) {
+  m_link->log("player: start");
+  m_durationMs = 0;
+  m_progressX = 0;
+  m_framesShown = 0;
+  m_started = m_paused = m_hasSubtitles = false;
+  m_subtitle[0] = m_error[0] = '\0';
+  copyText(m_status, k_statusCapacity,
+           reinterpret_cast<const uint8_t*>("Connexion..."), 12);
+  m_link->log("player: clear");
+  clearScreen();
+  m_link->log("player: strip");
+  drawStrip();
+  m_link->log("player: request");
+
+  uint8_t request[4 + 16] = {0, 0, 0, 0};
+  size_t idLength = strlen(videoId);
+  idLength = idLength > 16 ? 16 : idLength;
+  memcpy(request + 4, videoId, idLength);
+  m_link->send(Protocol::Play, request, static_cast<uint16_t>(4 + idLength));
+  bool answered = false;
+  uint64_t requestTime = Ion::Timing::millis();
+
+  KeyWatcher keys;
+  m_link->log("player: loop");
+  Exit exit = Exit::Stopped;
+  int logged = 0;
+  uint64_t lastData = Ion::Timing::millis();
+  while (true) {
+    Ion::Keyboard::Key key;
+    bool done = false;
+    while ((key = keys.next()) != Ion::Keyboard::Key::None && !done) {
+      done = handleKey(key, &exit);
+    }
+    if (done) {
+      sendControl(Protocol::Stop);
+      break;
+    }
+    if (!cablePlugged()) {
+      exit = Exit::Disconnected;
+      break;
+    }
+    uint8_t type;
+    const uint8_t* payload;
+    uint16_t length;
+    bool got = false;
+    // Drain what is ready, but come back regularly for the keyboard.
+    for (int i = 0; i < 64 && m_link->poll(&type, &payload, &length); i++) {
+      got = true;
+      if (logged < 12) {
+        char line[40] = "frame type xx len xxxxx";
+        static const char k_hex[] = "0123456789abcdef";
+        line[11] = k_hex[type >> 4];
+        line[12] = k_hex[type & 15];
+        for (int d = 0, v = length; d < 5; d++, v /= 10) {
+          line[22 - d] = static_cast<char>('0' + v % 10);
+        }
+        m_link->log(line);
+        logged++;
+      }
+      if (handleFrame(type, payload, length, &exit)) {
+        done = true;
+        break;
+      }
+    }
+    if (done) {
+      break;
+    }
+    if (m_stripDirty) {
+      if (logged < 12) {
+        m_link->log("player: strip text");
+      }
+      drawStrip();
+      if (logged < 12) {
+        m_link->log("player: strip text ok");
+        logged++;
+      }
+    }
+    const uint64_t now = Ion::Timing::millis();
+    if (got) {
+      answered = true;
+      lastData = now;
+    } else if (!answered && now - requestTime > 6000) {
+      // The gateway answers at once with a status line: the request was lost.
+      m_link->log("player: request resent");
+      m_link->send(Protocol::Play, request, static_cast<uint16_t>(4 + idLength));
+      requestTime = now;
+    } else if (!m_paused &&
+               now - lastData > (m_started ? k_streamTimeoutMs : k_firstFrameTimeoutMs)) {
+      if (m_error[0] == '\0') {
+        copyText(m_error, sizeof(m_error),
+                 reinterpret_cast<const uint8_t*>("Plus de reponse du PC"), 21);
+      }
+      exit = Exit::Error;
+      break;
+    }
+  }
+  /* Throw away what was already on the wire so the next screen starts clean. */
+  const uint64_t drainEnd = Ion::Timing::millis() + 150;
+  uint8_t type;
+  const uint8_t* payload;
+  uint16_t length;
+  while (Ion::Timing::millis() < drainEnd) {
+    m_link->poll(&type, &payload, &length);
+  }
+  return exit;
+}
+
+}  // namespace Numtube
