@@ -0,0 +1,92 @@
+#include "dispatcher.h"
+
+#include <string.h>
+
+namespace Termia {
+
+// Forward declarations — implementations live in commands/builtin.cpp.
+int cmd_help(int argc, const char* const argv[], Shell* shell);
+int cmd_clear(int argc, const char* const argv[], Shell* shell);
+int cmd_echo(int argc, const char* const argv[], Shell* shell);
+int cmd_whoami(int argc, const char* const argv[], Shell* shell);
+int cmd_uptime(int argc, const char* const argv[], Shell* shell);
+int cmd_mem(int argc, const char* const argv[], Shell* shell);
+int cmd_history(int argc, const char* const argv[], Shell* shell);
+int cmd_ls(int argc, const char* const argv[], Shell* shell);
+int cmd_cat(int argc, const char* const argv[], Shell* shell);
+int cmd_rm(int argc, const char* const argv[], Shell* shell);
+int cmd_cp(int argc, const char* const argv[], Shell* shell);
+int cmd_mv(int argc, const char* const argv[], Shell* shell);
+int cmd_touch(int argc, const char* const argv[], Shell* shell);
+int cmd_run(int argc, const char* const argv[], Shell* shell);
+int cmd_fastfetch(int argc, const char* const argv[], Shell* shell);
+int cmd_ping(int argc, const char* const argv[], Shell* shell);
+int cmd_claude(int argc, const char* const argv[], Shell* shell);
+int cmd_sync(int argc, const char* const argv[], Shell* shell);
+int cmd_push(int argc, const char* const argv[], Shell* shell);
+int cmd_pull(int argc, const char* const argv[], Shell* shell);
+int cmd_man(int argc, const char* const argv[], Shell* shell);
+int cmd_set(int argc, const char* const argv[], Shell* shell);
+int cmd_matrix(int argc, const char* const argv[], Shell* shell);
+int cmd_tether(int argc, const char* const argv[], Shell* shell);
+int cmd_theme(int argc, const char* const argv[], Shell* shell);
+int cmd_zoom(int argc, const char* const argv[], Shell* shell);
+int cmd_light(int argc, const char* const argv[], Shell* shell);
+int cmd_dark(int argc, const char* const argv[], Shell* shell);
+int cmd_model(int argc, const char* const argv[], Shell* shell);
+int cmd_viz(int argc, const char* const argv[], Shell* shell);
+int cmd_box(int argc, const char* const argv[], Shell* shell);
+
+// Keep alphabetical so `help` can print in a stable order.
+static const Command kBuiltins[] = {
+    {"box", cmd_box, "draw a titled ASCII box around text"},
+    {"cat", cmd_cat, "print file contents"},
+    {"claude", cmd_claude, "ask Claude (USB bridge wip)"},
+    {"clear", cmd_clear, "clear the screen"},
+    {"cp", cmd_cp, "copy src to dst"},
+    {"dark", cmd_dark, "shortcut: switch to default dark theme"},
+    {"echo", cmd_echo, "print arguments ($? expands to last exit code)"},
+    {"fastfetch", cmd_fastfetch, "show NumWorks system info"},
+    {"help", cmd_help, "list built-in commands"},
+    {"history", cmd_history, "print command history"},
+    {"light", cmd_light, "shortcut: switch to white-on-black light theme"},
+    {"ls", cmd_ls, "list files; optional prefix filter"},
+    {"man", cmd_man, "show a command's help"},
+    {"matrix", cmd_matrix, "Matrix-style screensaver dump"},
+    {"mem", cmd_mem, "show shell memory usage"},
+    {"model", cmd_model, "show or switch the Claude model (sonnet/opus/haiku)"},
+    {"mv", cmd_mv, "rename src to dst"},
+    {"ping", cmd_ping, "self-test the TMIA codec (USB transport wip)"},
+    {"pull", cmd_pull, "fetch a file from the host sync dir (wip)"},
+    {"push", cmd_push, "send a file to the host sync dir (wip)"},
+    {"rm", cmd_rm, "remove a file"},
+    {"run", cmd_run, "execute a Python script"},
+    {"set", cmd_set, "set a config key (theme, ...)"},
+    {"sync", cmd_sync, "bidirectionally mirror files with host (wip)"},
+    {"tether", cmd_tether, "probe USB CDC-ACM enumeration (3s, device only)"},
+    {"theme", cmd_theme, "show or switch theme (Shift+Power cycles)"},
+    {"touch", cmd_touch, "create an empty file"},
+    {"uptime", cmd_uptime, "time since boot"},
+    {"viz", cmd_viz, "render numbers as a sparkline or --bar chart"},
+    {"whoami", cmd_whoami, "print username"},
+    {"zoom", cmd_zoom, "zoom in/out the on-screen font (Shift+>/<)"},
+};
+static constexpr int kBuiltinCount =
+    sizeof(kBuiltins) / sizeof(kBuiltins[0]);
+
+const Command* Dispatcher::find(const char* name) {
+  if (name == nullptr) {
+    return nullptr;
+  }
+  for (int i = 0; i < kBuiltinCount; i++) {
+    if (strcmp(kBuiltins[i].name, name) == 0) {
+      return &kBuiltins[i];
+    }
+  }
+  return nullptr;
+}
+
+const Command* Dispatcher::commands() { return kBuiltins; }
+int Dispatcher::commandCount() { return kBuiltinCount; }
+
+}  // namespace Termia
