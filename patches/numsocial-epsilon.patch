new file mode 100644
index 0000000000..4aa9214e52
--- /dev/null
+++ b/shared/ion/src/device/shared/usb/stack/descriptor/endpoint_descriptor.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include "descriptor.h"
+
+namespace Ion {
+namespace Device {
+namespace USB {
+
+/* Standard endpoint descriptor, USB 2.0 §9.6.6. Type 0x05, 7 bytes.
+ *
+ * `bEndpointAddress` encodes direction (bit 7: 1=IN, 0=OUT) and
+ * endpoint number (bits 0..3). `bmAttributes` bits 0..1 encode the
+ * transfer type (0=Control, 1=Isochronous, 2=Bulk, 3=Interrupt).
+ *
+ * This class supports chaining via `next`, so callers can link a
+ * sequence of descriptors (e.g. bulk OUT followed by bulk IN) into the
+ * "additional descriptors" slot of a single interface descriptor
+ * without needing to model them as an array. */
+class EndpointDescriptor : public Descriptor {
+ public:
+  constexpr EndpointDescriptor(uint8_t bEndpointAddress, uint8_t bmAttributes,
+                               uint16_t wMaxPacketSize, uint8_t bInterval,
+                               const Descriptor* next = nullptr)
+      : Descriptor(0x05),
+        m_bEndpointAddress(bEndpointAddress),
+        m_bmAttributes(bmAttributes),
+        m_wMaxPacketSize(wMaxPacketSize),
+        m_bInterval(bInterval),
+        m_next(next) {}
+  constexpr static uint8_t BLength() {
+    /* Per USB 2.0 §9.6.6 the standard endpoint descriptor is 7 B:
+     * bLength + bDescriptorType (via Descriptor::BLength() = 2)
+     *   + bEndpointAddress (1) + bmAttributes (1)
+     *   + wMaxPacketSize (2) + bInterval (1) */
+    return Descriptor::BLength() + 3 * sizeof(uint8_t) + sizeof(uint16_t);
+  }
+
+ protected:
+  void push(Channel* c) const override;
+  uint8_t bLength() const override { return BLength(); }
+
+ private:
+  uint8_t m_bEndpointAddress;
+  uint8_t m_bmAttributes;
+  uint16_t m_wMaxPacketSize;
+  uint8_t m_bInterval;
+  const Descriptor* m_next;
+};
+
+}  // namespace USB
+}  // namespace Device
+}  // namespace Ion
