new file mode 100644
index 0000000000..a7af8a1ee8
--- /dev/null
+++ b/epsilon/apps/home/homebrew_apps.cpp
@@ -0,0 +1,28 @@
+#include "homebrew_apps.h"
+
+#include <stdint.h>
+
+namespace Home {
+
+namespace {
+
+struct HomebrewConfig {
+  char magic[16];
+  uint32_t hiddenApps;  // bit 0: NumTube, bit 1: NumChat, bit 2: NumScreen
+};
+
+/* volatile: the value is patched in the image after compilation, the compiler
+ * must not fold it. Keep in sync with app/flasher.py. */
+__attribute__((used)) const volatile HomebrewConfig k_homebrewConfig = {
+    "NUMAPPS-HIDDEN1", 0};
+
+}  // namespace
+
+bool homebrewAppIsHidden(I18n::Message appName) {
+  const uint32_t hidden = k_homebrewConfig.hiddenApps;
+  return (appName == I18n::Message::NumtubeApp && (hidden & 1)) ||
+         (appName == I18n::Message::NumchatApp && (hidden & 2)) ||
+         (appName == I18n::Message::NumscreenApp && (hidden & 4));
+}
+
+}  // namespace Home
