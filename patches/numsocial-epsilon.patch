+#pragma once
+
+#include <escher/view.h>
+
+namespace Termia {
+
+class Shell;
+
+// Renders the terminal: black background, green scrollback + prompt in
+// Epsilon's SmallFont (7×14). The cursor is a filled 7×14 block drawn
+// in XOR over the character under the caret.
+class TerminalView : public Escher::View {
+ public:
+  explicit TerminalView(const Shell* shell);
+  void drawRect(KDContext* ctx, KDRect rect) const override;
+  // Escher::View::markRectAsDirty is protected, so expose a public
+  // wrapper that the controller can call after event handling.
+  void redrawAll() { markRectAsDirty(bounds()); }
+
+ private:
+  const Shell* m_shell;
+};
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/vfs/vfs.cpp b/epsilon/apps/termia/vfs/vfs.cpp
new file mode 100644
index 0000000000..2b4741267c
--- /dev/null
+++ b/epsilon/apps/termia/vfs/vfs.cpp
@@ -0,0 +1,183 @@
+#include "vfs.h"
+
+#include <ion/storage/file_system.h>
+#include <ion/storage/record.h>
+#include <string.h>
+
+namespace Termia {
+namespace VFS {
+
+using FS = Ion::Storage::FileSystem;
+using Record = Ion::Storage::Record;
+
+static inline FS* fs() { return FS::sharedFileSystem; }
+
+// Helper: copy full name into a fixed-size field with truncation.
+static void copyName(char* dst, const char* src, size_t cap) {
+  if (cap == 0) {
+    return;
+  }
+  size_t i = 0;
+  if (src) {
+    while (i < cap - 1 && src[i]) {
+      dst[i] = src[i];
+      i++;
+    }
+  }
+  dst[i] = '\0';
+}
+
+static bool prefixMatches(const char* fullName, const char* prefix) {
+  if (!prefix || !*prefix) {
+    return true;
+  }
+  size_t plen = strlen(prefix);
+  return strncmp(fullName, prefix, plen) == 0;
+}
+
+int list(const char* prefix, FileInfo* out, int cap) {
+  if (!out || cap <= 0) {
+    return 0;
+  }
+  int total = 0;
+  for (int e = 0; e < k_numListableExtensions && total < cap; e++) {
+    const char* ext = k_listableExtensions[e];
+    int n = fs()->numberOfRecordsWithExtension(ext);
+    for (int i = 0; i < n && total < cap; i++) {
+      Record r = fs()->recordWithExtensionAtIndex(ext, i);
+      if (r.isNull()) {
+        continue;
+      }
+      const char* fullName = r.fullName();
+      if (!fullName || !prefixMatches(fullName, prefix)) {
+        continue;
+      }
+      copyName(out[total].fullName, fullName, sizeof(out[total].fullName));
+      out[total].size = r.value().size;
+      total++;
+    }
+  }
+  return total;
+}
+
+bool exists(const char* fullName) {
+  if (!fullName) {
+    return false;
+  }
+  return fs()->hasRecord(fs()->recordNamed(fullName));
+}
+
+int size(const char* fullName) {
+  if (!fullName) {
+    return -1;
+  }
+  Record r = fs()->recordNamed(fullName);
+  if (r.isNull()) {
+    return -1;
+  }
+  return static_cast<int>(r.value().size);
+}
+
+const void* borrow(const char* fullName, size_t* outSize) {
+  if (!fullName) {
+    return nullptr;
+  }
+  Record r = fs()->recordNamed(fullName);
+  if (r.isNull()) {
+    if (outSize) {
+      *outSize = 0;
+    }
+    return nullptr;
+  }
+  Record::Data d = r.value();
+  if (outSize) {
+    *outSize = d.size;
+  }
+  return d.buffer;
+}
+
+WriteError write(const char* fullName, const void* data, size_t dataSize) {
+  if (!fullName || !*fullName) {
+    return WriteError::InvalidName;
+  }
+  Record existing = fs()->recordNamed(fullName);
+  if (!existing.isNull()) {
+    Record::ErrorStatus err =
+        existing.setValue({data, dataSize});
+    switch (err) {
+      case Record::ErrorStatus::None:
+        return WriteError::None;
+      case Record::ErrorStatus::NotEnoughSpaceAvailable:
+        return WriteError::OutOfSpace;
+      case Record::ErrorStatus::NonCompliantName:
+        return WriteError::InvalidName;
+      default:
+        return WriteError::Other;
+    }
+  }
+  // Create. createRecordWithFullNameAndDataChunks wants an array of
+  // (ptr, size) pairs; we always pass exactly one chunk.
+  const void* chunks[1] = {data};
+  size_t sizes[1] = {dataSize};
+  Record::ErrorStatus err =
+      fs()->createRecordWithFullNameAndDataChunks(fullName, chunks, sizes, 1);
+  switch (err) {
+    case Record::ErrorStatus::None:
+      return WriteError::None;
+    case Record::ErrorStatus::NotEnoughSpaceAvailable:
+      return WriteError::OutOfSpace;
+    case Record::ErrorStatus::NonCompliantName:
+    case Record::ErrorStatus::NameTaken:
+      return WriteError::InvalidName;
+    default:
+      return WriteError::Other;
+  }
+}
+
+bool remove(const char* fullName) {
+  if (!fullName) {
+    return false;
+  }
+  Record r = fs()->recordNamed(fullName);
+  if (r.isNull()) {
+    return false;
+  }
+  return r.tryToDestroy();
+}
+
+RenameError rename(const char* from, const char* to) {
+  if (!from || !to) {
+    return RenameError::InvalidName;
+  }
+  Record r = fs()->recordNamed(from);
+  if (r.isNull()) {
+    return RenameError::NotFound;
+  }
+  if (!fs()->recordNamed(to).isNull()) {
+    return RenameError::NameTaken;
+  }
+  Record::ErrorStatus err = Record::SetFullName(&r, to);
+  switch (err) {
+    case Record::ErrorStatus::None:
+      return RenameError::None;
+    case Record::ErrorStatus::NameTaken:
+      return RenameError::NameTaken;
+    case Record::ErrorStatus::NonCompliantName:
+      return RenameError::InvalidName;
+    default:
+      return RenameError::Other;
+  }
+}
+
+size_t freeSpace() { return fs()->availableSize(); }
+
+size_t totalSpace() {
+  // Ion::Storage's buffer is fixed at k_totalSize (see file_system.h); we
+  // compute used as free subtracted from something, but k_totalSize is
+  // hidden so we fake it via the known constant.
+  // Keep this pinned: update if Epsilon changes the buffer size.
+  return 42 * 1024;  // 42 KB per Ion::Storage::k_totalSize
+}
+
+}  // namespace VFS
+}  // namespace Termia
diff --git a/epsilon/apps/termia/vfs/vfs.h b/epsilon/apps/termia/vfs/vfs.h
new file mode 100644
index 0000000000..15cbd9d7c8
--- /dev/null
+++ b/epsilon/apps/termia/vfs/vfs.h
@@ -0,0 +1,84 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+// Thin wrapper over `Ion::Storage::FileSystem::sharedFileSystem` that
+// exposes the slice of behaviour our shell commands need (ls / cat /
+// cp / mv / rm / touch) without leaking Ion's Record API everywhere.
+//
+// Iteration caveat: Ion::Storage has no public "record at index i, any
+// extension" call. We work around it by iterating a fixed allow-list
+// of user-visible extensions (k_listableExtensions). System records
+// (.sys, .rgm, .stm) are intentionally hidden.
+//
+// See TERMIA.md §6.3 for the spec-level contract.
+namespace Termia {
+namespace VFS {
+
+// Extensions we enumerate when listing. Keep this in sync with what
+// the user is expected to create via other apps (Python / math /
+// sequences). `py` is first because Phase 3's headline verification is
+// "make a script in the Python app, see it in `ls`".
+inline constexpr const char* k_listableExtensions[] = {
+    "py", "eq", "exp", "func", "lis", "seq", "mat", "reg", "pc",
+};
+inline constexpr int k_numListableExtensions =
+    sizeof(k_listableExtensions) / sizeof(k_listableExtensions[0]);
+
+// Maximum total file name length we handle cleanly. Longer names are
+// truncated when copied into FileInfo.fullName.
+inline constexpr int k_maxFullNameLen = 31;
+
+struct FileInfo {
+  char fullName[k_maxFullNameLen + 1];  // NUL-terminated
+  size_t size;                          // bytes of payload
+};
+
+// Enumerate records whose fullName starts with `prefix`. Pass an empty
+// or null prefix to list everything user-visible.
+// Returns the count written to `out`, capped at `cap`.
+int list(const char* prefix, FileInfo* out, int cap);
+
+// True if a record with that full name exists.
+bool exists(const char* fullName);
+
+// Byte size of a record's payload, or -1 if the record doesn't exist.
+int size(const char* fullName);
+
+// Borrow a pointer directly into Ion::Storage's buffer for the given
+// record. No copy. The pointer is valid until the next storage mutation
+// (create / destroy / rename / setValue). Returns nullptr if not found.
+// `outSize` receives the byte length.
+const void* borrow(const char* fullName, size_t* outSize);
+
+// Create-or-overwrite a record. Returns an error code; None on success.
+enum class WriteError {
+  None,
+  InvalidName,
+  OutOfSpace,
+  Other,
+};
+WriteError write(const char* fullName, const void* data, size_t size);
+
+// Destroy the record if present. Returns true on success.
+bool remove(const char* fullName);
+
+// Rename `from` → `to`. Returns an error code; None on success.
+enum class RenameError {
+  None,
+  NotFound,
+  InvalidName,
+  NameTaken,
+  Other,
+};
+RenameError rename(const char* from, const char* to);
+
+// Approximate free bytes remaining in the store.
+size_t freeSpace();
+
+// Total bytes in the store (buffer capacity).
+size_t totalSpace();
+
+}  // namespace VFS
+}  // namespace Termia
