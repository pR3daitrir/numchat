+namespace Numtube {
+
+// Full-screen playback loop. Blocks until the video ends or the user leaves.
+class Player {
+ public:
+  explicit Player(Link* link);
+
+  enum class Exit { Finished, Stopped, Error, Disconnected };
+  Exit play(const char* videoId);
+  const char* errorMessage() const { return m_error; }
+
+  // TileDecoder's blitter interface.
+  void push(int x, int y, int width, const uint16_t* pixels);
+
+ private:
+  static constexpr int k_barY = 180;
+  static constexpr int k_barHeight = 2;
+  static constexpr int k_stripY = 182;
+  static constexpr int k_stripHeight = 58;
+  static constexpr int k_textCapacity = 208;
+  static constexpr int k_statusCapacity = 48;
+
+  void sendControl(uint8_t command);
+  void sendSeek(int32_t deltaMs);
+  bool handleKey(Ion::Keyboard::Key key, Exit* exit);
+  bool handleFrame(uint8_t type, const uint8_t* payload, uint16_t length,
+                   Exit* exit);
+  void clearScreen();
+  void drawStrip();
+  void drawProgress(uint32_t positionMs);
+  void copyText(char* destination, int capacity, const uint8_t* source,
+                uint16_t length);
+
+  Link* m_link;
+  TileDecoder<Player> m_decoder;
+  uint16_t m_rowBuffer[TileDecoder<Player>::k_rowBufferPixels];
+  uint32_t m_durationMs;
+  int m_progressX;
