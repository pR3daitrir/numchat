+#pragma once
+
+namespace Termia {
+
+class Shell;
+
+// A single built-in command: name, handler, one-line help.
+// Handlers return an exit code (0 = success).
+struct Command {
+  const char* name;
+  int (*handler)(int argc, const char* const argv[], Shell* shell);
+  const char* help;
+};
+
+class Dispatcher {
+ public:
+  // Looks up `name` in the builtin table. Returns a pointer to the
+  // Command, or nullptr if not found.
+  static const Command* find(const char* name);
+
+  // Access the full table for `help` / `history` etc.
+  static const Command* commands();
+  static int commandCount();
+};
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/shell/history.cpp b/epsilon/apps/termia/shell/history.cpp
new file mode 100644
index 0000000000..9f0b00be4d
--- /dev/null
+++ b/epsilon/apps/termia/shell/history.cpp
@@ -0,0 +1,86 @@
+#include "history.h"
+
+#include <string.h>
+
+namespace Termia {
+
+History::History() : m_nextWrite(0), m_filled(0), m_browseOffset(-1) {
+  for (int i = 0; i < k_numEntries; i++) {
+    m_entries[i].bytes[0] = '\0';
+  }
+}
+
+void History::push(const char* command) {
+  if (command == nullptr || command[0] == '\0') {
+    return;
+  }
+  // Skip if same as the most recent entry (suppress dupes like bash's
+  // ignoredups, a nice quality-of-life touch for an arrow-key history).
+  if (m_filled > 0) {
+    int newestIdx = (m_nextWrite - 1 + k_numEntries) % k_numEntries;
+    if (strcmp(m_entries[newestIdx].bytes, command) == 0) {
+      return;
+    }
+  }
+
+  Entry& slot = m_entries[m_nextWrite];
+  size_t len = strlen(command);
+  if (len >= k_entryCapacity) {
+    len = k_entryCapacity - 1;
+  }
+  memcpy(slot.bytes, command, len);
+  slot.bytes[len] = '\0';
+
+  m_nextWrite = (m_nextWrite + 1) % k_numEntries;
+  if (m_filled < k_numEntries) {
+    m_filled++;
+  }
+  resetBrowse();
+}
+
+const char* History::browseUp() {
+  if (m_filled == 0) {
+    return "";
+  }
+  if (m_browseOffset + 1 >= m_filled) {
+    // Already at oldest; don't advance.
+    if (m_browseOffset < 0) {
+      m_browseOffset = 0;
+    }
+  } else {
+    m_browseOffset++;
+  }
+  int idx = (m_nextWrite - 1 - m_browseOffset + k_numEntries) % k_numEntries;
+  return m_entries[idx].bytes;
+}
+
+const char* History::browseDown() {
+  if (m_browseOffset < 0) {
+    return "";  // not browsing; nothing to do
+  }
+  if (m_browseOffset == 0) {
+    // Moving below newest → leave browse mode with empty line.
+    m_browseOffset = -1;
+    return "";
+  }
+  m_browseOffset--;
+  int idx = (m_nextWrite - 1 - m_browseOffset + k_numEntries) % k_numEntries;
+  return m_entries[idx].bytes;
+}
+
+void History::resetBrowse() { m_browseOffset = -1; }
+
+const char* History::entryAtChronoIndex(int offset) const {
+  if (offset < 0 || offset >= m_filled) {
+    return "";
+  }
+  // Oldest is m_nextWrite (or m_nextWrite - m_filled if the buffer
+  // hasn't wrapped yet). Chronological index 0 = oldest.
+  int start = (m_filled == k_numEntries) ? m_nextWrite
+                                         : (m_nextWrite - m_filled + k_numEntries) %
+                                               k_numEntries;
+  int idx = (start + offset) % k_numEntries;
+  return m_entries[idx].bytes;
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/shell/history.h b/epsilon/apps/termia/shell/history.h
new file mode 100644
index 0000000000..96d328372c
--- /dev/null
+++ b/epsilon/apps/termia/shell/history.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <stdint.h>
+
+namespace Termia {
+
+// 32-entry circular command history. Fixed 64-byte slots, total ~2 KB
+// per TERMIA.md §3.3.
+//
+// Browsing:
+// - Enter "browse" mode by calling browseUp(); repeated calls move to
+//   older entries.
+// - browseDown() moves toward newer entries; moving past the newest
+//   returns "" (meaning "clear the line — not browsing anymore").
+class History {
+ public:
+  static constexpr int k_numEntries = 32;
+  static constexpr int k_entryCapacity = 64;  // bytes, incl NUL
+
+  History();
+
+  // Append a command. Empty strings are ignored so blank Enter presses
+  // don't pollute the ring.
+  void push(const char* command);
+
+  // Move the browse cursor one step older / newer. Returns a pointer to
+  // the corresponding entry (empty string if unavailable). The caller
+  // should copy this into the line editor.
+  const char* browseUp();
+  const char* browseDown();
+
+  // Reset the browse cursor. Called whenever the user types a character
+  // — so next browseUp starts from the newest entry again.
+  void resetBrowse();
+
+  int count() const { return m_filled; }
+
+  // Direct read for the `history` builtin. offset 0 = oldest, count()-1 = newest.
+  const char* entryAtChronoIndex(int offset) const;
+
+ private:
+  struct Entry {
+    char bytes[k_entryCapacity];
+  };
+  Entry m_entries[k_numEntries];
+  int m_nextWrite;
+  int m_filled;
+  int m_browseOffset;  // -1 = not browsing; 0 = newest
+};
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/shell/line_editor.cpp b/epsilon/apps/termia/shell/line_editor.cpp
new file mode 100644
index 0000000000..a80ba2dfa4
--- /dev/null
+++ b/epsilon/apps/termia/shell/line_editor.cpp
@@ -0,0 +1,145 @@
+#include "line_editor.h"
+
+#include <string.h>
+
+namespace Termia {
+
+LineEditor::LineEditor() : m_length(0), m_cursor(0), m_submitted(false) {
+  m_buffer[0] = '\0';
+}
+
+bool LineEditor::handleEvent(Ion::Events::Event event) {
+  if (event == Ion::Events::EXE || event == Ion::Events::OK) {
+    m_submitted = true;
+    return true;
+  }
+  if (event == Ion::Events::Backspace) {
+    backspace();
+    return true;
+  }
+  if (event == Ion::Events::Left) {
+    if (m_cursor > 0) {
+      m_cursor--;
+      return true;
+    }
+    return false;
+  }
+  if (event == Ion::Events::Right) {
+    if (m_cursor < m_length) {
+      m_cursor++;
+      return true;
+    }
+    return false;
+  }
+  if (event == Ion::Events::ShiftLeft) {
+    if (m_cursor != 0) {
+      m_cursor = 0;
+      return true;
+    }
+    return false;
+  }
+  if (event == Ion::Events::ShiftRight) {
+    if (m_cursor != m_length) {
+      m_cursor = m_length;
+      return true;
+    }
+    return false;
+  }
+  if (event == Ion::Events::Clear) {
+    if (m_length != 0) {
+      clear();
+      return true;
+    }
+    return false;
+  }
+  // Printable: anything with a single-byte text representation. We use
+  // Ion::Events::copyText (works on both simulator and device — the
+  // `Event::text()` method is simulator-only) and filter to single-
+  // character results so calculator function keys like `sin(` (4 chars)
+  // are ignored — only single-codepoint keys land in the prompt.
+  char buf[4] = {0};
+  size_t n = Ion::Events::copyText(static_cast<uint8_t>(event), buf,
+                                   sizeof(buf));
+  if (n == 1) {
+    insertText(buf);
+    return true;
+  }
+  return false;
+}
+
+const char* LineEditor::takeSubmitted() {
+  if (!m_submitted) {
+    return nullptr;
+  }
+  m_submitted = false;
+  // Caller gets a pointer into m_buffer; it must consume before we
+  // mutate. We return the buffer first and let the caller decide when
+  // to reset us via clear(). This avoids a second copy.
+  return m_buffer;
+}
+
+void LineEditor::setText(const char* text) {
+  m_length = 0;
+  m_cursor = 0;
+  m_buffer[0] = '\0';
+  if (text == nullptr) {
+    return;
+  }
+  size_t len = 0;
+  while (len < static_cast<size_t>(k_maxLen) && text[len] != '\0') {
+    len++;
+  }
+  memcpy(m_buffer, text, len);
+  m_buffer[len] = '\0';
+  m_length = static_cast<int>(len);
+  m_cursor = m_length;
+}
+
+void LineEditor::clear() {
+  m_length = 0;
+  m_cursor = 0;
+  m_buffer[0] = '\0';
+  m_submitted = false;
+}
+
+void LineEditor::insertText(const char* text) {
+  if (text == nullptr) {
+    return;
+  }
+  size_t addLen = strlen(text);
+  if (m_length + static_cast<int>(addLen) > k_maxLen) {
+    return;  // buffer full; silently drop (calc has no bell)
+  }
+  // Shift [cursor, length) right by addLen to make room.
+  if (m_cursor < m_length) {
+    memmove(m_buffer + m_cursor + addLen, m_buffer + m_cursor,
+            m_length - m_cursor);
+  }
+  memcpy(m_buffer + m_cursor, text, addLen);
+  m_length += static_cast<int>(addLen);
+  m_cursor += static_cast<int>(addLen);
+  m_buffer[m_length] = '\0';
+}
+
+void LineEditor::backspace() {
+  if (m_cursor == 0) {
+    return;
+  }
+  // Shift [cursor, length) left by 1.
+  memmove(m_buffer + m_cursor - 1, m_buffer + m_cursor, m_length - m_cursor);
+  m_cursor--;
+  m_length--;
+  m_buffer[m_length] = '\0';
+}
+
+void LineEditor::deleteForward() {
+  if (m_cursor >= m_length) {
+    return;
+  }
+  memmove(m_buffer + m_cursor, m_buffer + m_cursor + 1,
+          m_length - m_cursor - 1);
+  m_length--;
+  m_buffer[m_length] = '\0';
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/shell/line_editor.h b/epsilon/apps/termia/shell/line_editor.h
new file mode 100644
index 0000000000..1cd4090ea5
--- /dev/null
+++ b/epsilon/apps/termia/shell/line_editor.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <ion/events.h>
+#include <stdint.h>
+
+namespace Termia {
+
+// A single-line editable buffer. Holds the command-in-progress, tracks a
+// caret position, and interprets calculator keypresses as text-editing
+// operations.
+//
+// Wider than what fits on-screen (128 chars vs ~43 visible cells) so that
+// typical commands aren't prematurely clipped; the view is responsible for
+// horizontal scrolling if/when the buffer overflows the visible area.
+class LineEditor {
+ public:
+  static constexpr int k_maxLen = 128;
+
+  LineEditor();
+
+  // Returns true if the event was handled (and so state changed, meaning a
+  // redraw is required). Up/Down are intentionally NOT handled here — the
+  // Shell intercepts them first so it can delegate to History.
+  bool handleEvent(Ion::Events::Event event);
+
+  // Pull the submitted command line. After a successful call, the buffer
+  // is reset. Returns nullptr if no submission is pending.
+  const char* takeSubmitted();
+
+  // Set the buffer contents (used by History browsing). Clamps length.
+  void setText(const char* text);
+
+  // Reset buffer + cursor.
+  void clear();
+
+  // Read-only accessors for the view.
+  const char* text() const { return m_buffer; }
+  int length() const { return m_length; }
+  int cursorPos() const { return m_cursor; }
+
+ private:
+  void insertText(const char* text);
+  void backspace();
+  void deleteForward();
+
+  char m_buffer[k_maxLen + 1];  // +1 for trailing NUL
+  int m_length;
+  int m_cursor;
+  bool m_submitted;
+};
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/shell/parser.cpp b/epsilon/apps/termia/shell/parser.cpp
new file mode 100644
index 0000000000..31da0b7891
--- /dev/null
+++ b/epsilon/apps/termia/shell/parser.cpp
@@ -0,0 +1,97 @@
+#include "parser.h"
+
+#include <string.h>
+
+namespace Termia {
+
+static bool isSpace(char c) { return c == ' ' || c == '\t'; }
+
+int Parser::tokenize(char* line, const char* argv[k_maxArgs],
+                     const char** errorOut) {
+  if (errorOut) {
+    *errorOut = nullptr;
+  }
+  if (line == nullptr) {
+    return 0;
+  }
+  int argc = 0;
+  char* src = line;
+
+  while (*src) {
+    while (isSpace(*src)) {
+      src++;
+    }
+    if (*src == '\0') {
+      break;
+    }
+    if (argc >= k_maxArgs) {
+      if (errorOut) {
+        *errorOut = "too many arguments";
+      }
+      return -1;
+    }
+
+    // Start a token. We write unescaped bytes back into `line` starting
+    // at `dst` — this works because the unescaped form is never longer
+    // than the raw form.
+    char* tokenStart = src;  // temporary; real start is `dst` after unquoting
+    (void)tokenStart;
+    char* dst = src;
+    argv[argc++] = dst;
+
+    bool inQuote = false;
+    while (*src) {
+      char c = *src;
+      if (!inQuote && isSpace(c)) {
+        break;
+      }
+      if (c == '"') {
+        inQuote = !inQuote;
+        src++;
+        continue;
+      }
+      if (c == '\\') {
+        char next = src[1];
+        if (next == '\0') {
+          if (errorOut) {
+            *errorOut = "dangling backslash";
+          }
+          return -1;
+        }
+        // Support: \" \\ \  (escaped space)  \n -> literal newline
+        if (next == '"' || next == '\\' || next == ' ' || next == '\t') {
+          *dst++ = next;
+        } else if (next == 'n') {
+          *dst++ = '\n';
+        } else if (next == 't') {
+          *dst++ = '\t';
+        } else {
+          // Unknown escape: keep the backslash and the char, so users
+          // see what they typed.
+          *dst++ = '\\';
+          *dst++ = next;
+        }
+        src += 2;
+        continue;
+      }
+      *dst++ = c;
+      src++;
+    }
+
+    if (inQuote) {
+      if (errorOut) {
+        *errorOut = "unterminated quote";
+      }
+      return -1;
+    }
+
+    // Terminate the token and advance to after it in `line`.
+    if (*src) {
+      *src++ = '\0';
+    }
+    *dst = '\0';
+  }
+  return argc;
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/shell/parser.h b/epsilon/apps/termia/shell/parser.h
new file mode 100644
index 0000000000..31f39c1539
--- /dev/null
+++ b/epsilon/apps/termia/shell/parser.h
@@ -0,0 +1,23 @@
+#pragma once
+
+namespace Termia {
+
+// Tokenizes a command line into an argv-style array in place. Supports
+// double-quoted tokens with `\"` and `\\` backslash escapes. Tokens are
+// whitespace-separated outside of quotes.
+//
+// Mutates the input buffer: inserts NULs at token boundaries and shifts
+// bytes when unescaping. Input must be writable (not a string literal).
+class Parser {
+ public:
+  static constexpr int k_maxArgs = 16;
+
+  // Tokenize `line` in place. Returns argc (0 on empty line). `argv` is
+  // populated with pointers into `line`. On syntax error (unterminated
+  // quote, dangling backslash), returns -1 and writes a short message to
+  // `errorOut` (if non-null).
+  static int tokenize(char* line, const char* argv[k_maxArgs],
+                      const char** errorOut = nullptr);
+};
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/shell/scrollback.cpp b/epsilon/apps/termia/shell/scrollback.cpp
new file mode 100644
index 0000000000..d4eef9f584
--- /dev/null
+++ b/epsilon/apps/termia/shell/scrollback.cpp
@@ -0,0 +1,68 @@
+#include "scrollback.h"
+
+#include <string.h>
+
+#include "textfx.h"
+
+namespace Termia {
+
+Scrollback::Scrollback() : m_nextWrite(0), m_filled(0) {
+  for (int i = 0; i < k_numLines; i++) {
+    m_lines[i].bytes[0] = '\0';
+    m_lines[i].length = 0;
+  }
+}
+
+void Scrollback::writeLine(const char* text) {
+  Line& slot = m_lines[m_nextWrite];
+  // Run every line through the Unicode/LaTeX translator before storing it.
+  // Done here (not at every callsite) so commands like `claude`, `fastfetch`,
+  // run_python output, and any future producer get pretty rendering for free.
+  // The translator is a no-op for plain-ASCII lines (~all builtin output).
+  size_t len = translate(text, slot.bytes, k_lineCapacity);
+  slot.length = static_cast<uint8_t>(len);
+
+  m_nextWrite = (m_nextWrite + 1) % k_numLines;
+  if (m_filled < k_numLines) {
+    m_filled++;
+  }
+}
+
+void Scrollback::clear() {
+  m_nextWrite = 0;
+  m_filled = 0;
+  // Don't bother zeroing payload; `lineAt` gates on m_filled.
+}
+
+size_t Scrollback::usedBytes() const {
+  size_t total = 0;
+  for (int i = 0; i < m_filled; i++) {
+    total += m_lines[i].length;
+  }
+  return total;
+}
+
+const char* Scrollback::lineAt(int offset) const {
+  if (offset < 0 || offset >= m_filled) {
+    return "";
+  }
+  // Newest line is at m_nextWrite - 1, oldest is at m_nextWrite - m_filled.
+  int idx = (m_nextWrite - 1 - offset) % k_numLines;
+  if (idx < 0) {
+    idx += k_numLines;
+  }
+  return m_lines[idx].bytes;
+}
+
+int Scrollback::lineLengthAt(int offset) const {
+  if (offset < 0 || offset >= m_filled) {
+    return 0;
+  }
+  int idx = (m_nextWrite - 1 - offset) % k_numLines;
+  if (idx < 0) {
+    idx += k_numLines;
+  }
+  return m_lines[idx].length;
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/shell/scrollback.h b/epsilon/apps/termia/shell/scrollback.h
new file mode 100644
index 0000000000..6cd4f6de40
--- /dev/null
+++ b/epsilon/apps/termia/shell/scrollback.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace Termia {
+
+// Fixed-slot line ring buffer for the shell's on-screen history.
+// TERMIA.md §6.2 asks for ~16 KB; this laid out as 256 lines × 64 B is
+// 16,384 B of line payload. Extra bytes are length byte + padding, so
+// total is ~16.2 KB — within the spec's 16 KB bucket (§3.3) to a
+// negligible overshoot.
+//
+// Design choices:
+// - Fixed slots (not a byte-ring with length prefixes) so iteration and
+//   rendering are O(1) per line without pointer chasing — matters for
+//   the 30 FPS scroll requirement.
+// - Lines longer than `k_lineCapacity-1` chars are truncated with a
+//   trailing "…" marker; this is plenty for help text / uptime / etc.
+// - Ring overwrites oldest slot; `lineFromNewest(0)` always returns the
+//   most recently written line.
+class Scrollback {
+ public:
+  static constexpr int k_numLines = 256;
+  static constexpr int k_lineCapacity = 64;  // bytes per line, incl NUL
+
+  Scrollback();
+
+  // Append a line (copies, NUL-truncates at k_lineCapacity-1).
+  void writeLine(const char* text);
+
+  // printf-like formatting is delegated to callers (who use
+  // Poincare::Print::CustomPrintf with a local buffer + writeLine) so
+  // this class stays portable between simulator (host libc) and device
+  // (newlib, no vsnprintf in the expected header scope).
+
+  // Drop everything. Render next frame will show an empty scrollback.
+  void clear();
+
+  // Lines currently in the buffer, 0..k_numLines.
+  int lineCount() const { return m_filled; }
+
+  // Total bytes occupied by line payload (for the `mem` command).
+  size_t usedBytes() const;
+
+  // Read-only access. `offset == 0` is the newest line,
+  // `offset == lineCount()-1` is the oldest still retained.
+  // Out-of-range: returns "" with length 0.
+  const char* lineAt(int offsetFromNewest) const;
+  int lineLengthAt(int offsetFromNewest) const;
+
+ private:
+  struct Line {
+    char bytes[k_lineCapacity];
+    uint8_t length;  // strlen, excludes NUL
+  };
+  Line m_lines[k_numLines];
+  int m_nextWrite;  // circular write index, [0, k_numLines)
+  int m_filled;     // number of lines actually written, saturates at k_numLines
+};
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/shell/shell.cpp b/epsilon/apps/termia/shell/shell.cpp
new file mode 100644
index 0000000000..ac9922a5dd
--- /dev/null
+++ b/epsilon/apps/termia/shell/shell.cpp
@@ -0,0 +1,358 @@
+#include "shell.h"
+
+#include <poincare/print.h>
+#include <string.h>
+
+#include "../vfs/vfs.h"
+#include "dispatcher.h"
+#include "parser.h"
+
+namespace Termia {
+
+Palette paletteFor(ThemeId id) {
+  switch (id) {
+    case ThemeId::Light:
+      // Pure-white background, near-black text — matches the look of every
+      // other built-in NumWorks app (Calculation, Settings, Function, …).
+      // Accent is Epsilon's signature yellow so any selection/highlight
+      // we add later reads as "this is Termia, just in light mode".
+      return {KDColorWhite, KDColor::RGB24(0x101010),
+              KDColor::RGB24(0xFFB734)};
+    case ThemeId::Matrix:
+      return {KDColorBlack, KDColor::RGB24(0x00FF41),
+              KDColor::RGB24(0x008F11)};
+    case ThemeId::Amber:
+      return {KDColorBlack, KDColor::RGB24(0xFFBF00),
+              KDColor::RGB24(0xFF8000)};
+    case ThemeId::Solarized:
+      return {KDColor::RGB24(0x002B36), KDColor::RGB24(0x93A1A1),
+              KDColor::RGB24(0xB58900)};
+    case ThemeId::Default:
+    default:
+      return {KDColorBlack, KDColor::RGB24(0x7CFC00),
+              KDColor::RGB24(0x5A8F00)};
+  }
+}
+
+ThemeId nextTheme(ThemeId t) {
+  uint8_t v = static_cast<uint8_t>(t);
+  v = (v + 1) % static_cast<uint8_t>(ThemeId::Count);
+  return static_cast<ThemeId>(v);
+}
+
+const char* themeName(ThemeId id) {
+  switch (id) {
+    case ThemeId::Light:
+      return "light";
+    case ThemeId::Matrix:
+      return "matrix";
+    case ThemeId::Amber:
+      return "amber";
+    case ThemeId::Solarized:
+      return "solarized";
+    case ThemeId::Default:
+    default:
+      return "default";
+  }
+}
+
+ThemeId themeFromName(const char* name, bool* ok) {
+  if (name == nullptr) {
+    if (ok) *ok = false;
+    return ThemeId::Default;
+  }
+  if (strcmp(name, "light") == 0) {
+    if (ok) *ok = true;
+    return ThemeId::Light;
+  }
+  if (strcmp(name, "dark") == 0) {
+    // "dark" is a friendly alias for the original green-on-black look.
+    if (ok) *ok = true;
+    return ThemeId::Default;
+  }
+  if (strcmp(name, "matrix") == 0) {
+    if (ok) *ok = true;
+    return ThemeId::Matrix;
+  }
+  if (strcmp(name, "amber") == 0) {
+    if (ok) *ok = true;
+    return ThemeId::Amber;
+  }
+  if (strcmp(name, "solarized") == 0) {
+    if (ok) *ok = true;
+    return ThemeId::Solarized;
+  }
+  if (strcmp(name, "default") == 0) {
+    if (ok) *ok = true;
+    return ThemeId::Default;
+  }
+  if (ok) *ok = false;
+  return ThemeId::Default;
+}
+
+Shell::Shell(Scrollback* scrollback, History* history)
+    : m_scrollback(scrollback),
+      m_history(history),
+      m_lineEditor(),
+      m_lastExitCode(0),
+      m_initialized(false) {}
+
+void Shell::setCurrentModel(const char* name) {
+  if (name == nullptr || *name == '\0') {
+    m_currentModel[0] = '\0';
+    return;
+  }
+  size_t n = strlen(name);
+  if (n >= sizeof(m_currentModel)) {
+    n = sizeof(m_currentModel) - 1;
+  }
+  memcpy(m_currentModel, name, n);
+  m_currentModel[n] = '\0';
+}
+
+bool Shell::completePrefix(const char* prefix, char* outBuf, size_t outCap) {
+  if (!prefix || !*prefix || outCap == 0) {
+    return false;
+  }
+  size_t plen = strlen(prefix);
+
+  // Pass 1: find a unique command match.
+  const Command* cmds = Dispatcher::commands();
+  int cmdCount = Dispatcher::commandCount();
+
+  // Pass 2: find matching files.
+  VFS::FileInfo fileHits[32];
+  int fileCount = VFS::list(prefix, fileHits, 32);
+
+  // Aggregate: first unique match wins, otherwise list options.
+  int matchCount = 0;
+  const char* uniqueMatch = nullptr;
+  for (int i = 0; i < cmdCount; i++) {
+    if (strncmp(cmds[i].name, prefix, plen) == 0) {
+      matchCount++;
+      uniqueMatch = cmds[i].name;
+    }
+  }
+  for (int i = 0; i < fileCount; i++) {
+    matchCount++;
+    uniqueMatch = fileHits[i].fullName;
+  }
+  if (matchCount == 0) {
+    return false;
+  }
+  if (matchCount == 1) {
+    // Copy uniqueMatch into outBuf.
+    size_t n = 0;
+    while (n < outCap - 1 && uniqueMatch[n]) {
+      outBuf[n] = uniqueMatch[n];
+      n++;
+    }
+    outBuf[n] = '\0';
+    return true;
+  }
+  // Ambiguous: dump options as a single wrapped line per kind.
+  m_scrollback->writeLine("candidates:");
+  for (int i = 0; i < cmdCount; i++) {
+    if (strncmp(cmds[i].name, prefix, plen) == 0) {
+      char line[Scrollback::k_lineCapacity];
+      Poincare::Print::CustomPrintf(line, sizeof(line), "  %s",
+                                     cmds[i].name);
+      m_scrollback->writeLine(line);
+    }
+  }
+  for (int i = 0; i < fileCount; i++) {
+    char line[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(line, sizeof(line), "  %s",
+                                   fileHits[i].fullName);
+    m_scrollback->writeLine(line);
+  }
+  return false;
+}
+
+void Shell::init() {
+  if (m_initialized) {
+    return;
+  }
+  m_initialized = true;
+  m_scrollback->writeLine("Termia v0.1 - a Termux-inspired shell");
+  m_scrollback->writeLine("Type 'help' for available commands.");
+  m_scrollback->writeLine(
+      "Hotkeys: Shift+Power=theme  Shift+>/<=zoom  Shift+Up/Dn=scroll");
+  m_scrollback->writeLine(
+      "         Shift+Left/Right=horiz scroll   `model`/`viz`/`box`");
+  m_scrollback->writeLine("");
+}
+
+bool Shell::handleEvent(Ion::Events::Event event) {
+  // Shift+Power → cycle theme. One press flips Default→Light→Matrix→…→back.
+  // The Sto event has no text payload, so it's safe to consume here without
+  // worrying about the line editor stealing it.
+  if (event == Ion::Events::Sto) {
+    m_theme = nextTheme(m_theme);
+    return true;
+  }
+  // Shift+Square (the `>` glyph) → zoom in.  Shift+Sqrt (the `<` glyph) →
+  // zoom out. We intercept BEFORE the line editor; the trade-off is that
+  // `<` and `>` can't be typed at the prompt anymore, which the shell has
+  // no use for today (no redirection, no comparison operators in args).
+  if (event == Ion::Events::Greater) {
+    setZoomLevel(m_zoomLevel + 1);
+    return true;
+  }
+  if (event == Ion::Events::Lower) {
+    setZoomLevel(m_zoomLevel - 1);
+    return true;
+  }
+
+  // (ShiftLeft/ShiftRight horizontal scroll is intercepted earlier above.)
+
+  // Tab-completion: the NumWorks doesn't have a Tab key, so we bind
+  // the Toolbox key (pop-up helper key next to Shift/Alpha on the
+  // keypad) to "complete current word against commands + VFS".
+  if (event == Ion::Events::Toolbox) {
+    char completed[64];
+    if (completePrefix(m_lineEditor.text(), completed, sizeof(completed))) {
+      m_lineEditor.setText(completed);
+    }
+    return true;
+  }
+
+  // Horizontal scrollback navigation: Shift+Left / Shift+Right slide the
+  // viewport left/right by one cell, so users can read lines wider than
+  // the screen. We take ShiftLeft/ShiftRight away from the LineEditor
+  // here (it used them for cursor home/end at the prompt) — plain
+  // Left/Right + long-press still cover that, and horizontal scrollback
+  // is the higher-value affordance now that lines can wrap visually.
+  if (event == Ion::Events::ShiftRight) {
+    setHorizOffset(m_horizOffset + 1);
+    return true;
+  }
+  if (event == Ion::Events::ShiftLeft) {
+    if (m_horizOffset == 0) {
+      return false;  // already pinned left; let the event bubble harmlessly
+    }
+    setHorizOffset(m_horizOffset - 1);
+    return true;
+  }
+
+  // Scrollback viewport navigation via Shift+Up / Shift+Down.
+  // The max offset is lineCount-1 (can't scroll past the oldest line).
+  if (event == Ion::Events::ShiftUp) {
+    int maxOffset = m_scrollback->lineCount() - 1;
+    if (maxOffset < 0) maxOffset = 0;
+    if (m_viewOffset < maxOffset) {
+      m_viewOffset++;
+      return true;
+    }
+    return false;
+  }
+  if (event == Ion::Events::ShiftDown) {
+    if (m_viewOffset > 0) {
+      m_viewOffset--;
+      return true;
+    }
+    return false;
+  }
+
+  // History navigation: Up / Down cycle previous commands.
+  if (event == Ion::Events::Up) {
+    const char* entry = m_history->browseUp();
+    if (entry != nullptr) {
+      m_lineEditor.setText(entry);
+      return true;
+    }
+    return false;
+  }
+  if (event == Ion::Events::Down) {
+    const char* entry = m_history->browseDown();
+    if (entry != nullptr) {
+      m_lineEditor.setText(entry);
+      return true;
+    }
+    return false;
+  }
+
+  bool handled = m_lineEditor.handleEvent(event);
+
+  // Any plain-character typing resets the history browse cursor so the
+  // next Up arrow starts from newest again (bash-ish behaviour), and
+  // also snaps the scrollback viewport back to the bottom (tmux-ish).
+  // Uses copyText for the same reason line_editor does — Event::text()
+  // isn't linkable on the device.
+  char probe[4] = {0};
+  size_t pn = Ion::Events::copyText(static_cast<uint8_t>(event), probe,
+                                     sizeof(probe));
+  if (pn == 1) {
+    m_history->resetBrowse();
+    m_viewOffset = 0;
+    m_horizOffset = 0;
+  }
+
+  const char* submitted = m_lineEditor.takeSubmitted();
+  if (submitted != nullptr) {
+    m_viewOffset = 0;  // submitting snaps the view back to latest
+    // Copy the line because the Parser tokenises in place and we also
+    // clear the editor. One allocation on the stack, no heap.
+    char copy[LineEditor::k_maxLen + 1];
+    size_t slen = strlen(submitted);
+    if (slen > LineEditor::k_maxLen) {
+      slen = LineEditor::k_maxLen;
+    }
+    memcpy(copy, submitted, slen);
+    copy[slen] = '\0';
+    m_lineEditor.clear();
+
+    // Echo the submitted line into the scrollback so the user sees a
+    // record of what they ran.
+    char echoLine[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(echoLine, sizeof(echoLine), "%s%s",
+                                   prompt(), copy);
+    m_scrollback->writeLine(echoLine);
+
+    // Push to history BEFORE the parser mutates `copy`.
+    m_history->push(copy);
+
+    // Tokenise.
+    const char* argv[Parser::k_maxArgs];
+    const char* parseErr = nullptr;
+    int argc = Parser::tokenize(copy, argv, &parseErr);
+    if (argc < 0) {
+      char errLine[Scrollback::k_lineCapacity];
+      Poincare::Print::CustomPrintf(
+          errLine, sizeof(errLine), "termia: %s",
+          parseErr ? parseErr : "parse error");
+      m_scrollback->writeLine(errLine);
+      m_lastExitCode = 2;
+    } else if (argc == 0) {
+      // Blank line — nothing to do. Exit code unchanged.
+    } else {
+      // $? expansion: tokens equal to "$?" become the stringified
+      // previous exit code. One shared buffer is fine: all expanded
+      // slots point into it until the next command.
+      static char exitCodeStr[16];
+      Poincare::Print::CustomPrintf(exitCodeStr, sizeof(exitCodeStr), "%i",
+                                     m_lastExitCode);
+      for (int i = 0; i < argc; i++) {
+        if (strcmp(argv[i], "$?") == 0) {
+          argv[i] = exitCodeStr;
+        }
+      }
+
+      const Command* cmd = Dispatcher::find(argv[0]);
+      if (cmd == nullptr) {
+        char errLine[Scrollback::k_lineCapacity];
+        Poincare::Print::CustomPrintf(errLine, sizeof(errLine),
+                                       "termia: %s: command not found",
+                                       argv[0]);
+        m_scrollback->writeLine(errLine);
+        m_lastExitCode = 127;
+      } else {
+        m_lastExitCode = cmd->handler(argc, argv, this);
+      }
+    }
+    handled = true;
+  }
+  return handled;
+}
+
+}  // namespace Termia
