@@ -0,0 +1,126 @@
+#pragma once
+
+#include <ion/events.h>
+#include <kandinsky/color.h>
+
+#include "history.h"
+#include "line_editor.h"
+#include "scrollback.h"
+
+namespace Termia {
+
+struct Palette {
+  KDColor bg;
+  KDColor fg;
+  KDColor accent;  // used sparingly (cursor hint row, etc.)
+};
+
+enum class ThemeId : uint8_t {
+  Default = 0,
+  Light,
+  Matrix,
+  Amber,
+  Solarized,
+  Count,  // sentinel — keep last
+};
+
+// Cycle to the next theme in enum order, wrapping at the end. Used by the
+// Shift+Power hotkey for one-press dark/light toggling.
+ThemeId nextTheme(ThemeId t);
+
+Palette paletteFor(ThemeId id);
+const char* themeName(ThemeId id);
+ThemeId themeFromName(const char* name, bool* ok);
+
+// REPL glue. Owns the line editor and borrows the scrollback + history
+// (which live in App::Snapshot so they persist across app re-entries).
+class Shell {
+ public:
+  Shell(Scrollback* scrollback, History* history);
+
+  // First-time setup: prints the welcome banner. Idempotent — repeated
+  // calls after the first do nothing. Called by the App when it first
+  // becomes active.
+  void init();
+
+  // Feed an event. Returns true if something changed that requires a
+  // redraw. The Shell intercepts Up/Down arrows for history; everything
+  // else is delegated to the LineEditor. Home/Back are NOT consumed —
+  // they bubble so the apps container can exit the app.
+  bool handleEvent(Ion::Events::Event event);
+
+  // Read-only accessors used by the view + commands.
+  Scrollback* scrollback() { return m_scrollback; }
+  const Scrollback* scrollback() const { return m_scrollback; }
+  History* history() { return m_history; }
+  const LineEditor& lineEditor() const { return m_lineEditor; }
+  int lastExitCode() const { return m_lastExitCode; }
+  const char* prompt() const { return "$ "; }
+  const char* username() const { return "matin"; }
+
+  // Phase-9 additions.
+  ThemeId theme() const { return m_theme; }
+  void setTheme(ThemeId t) { m_theme = t; }
+  Palette palette() const { return paletteFor(m_theme); }
+
+  // Zoom level. 0 = SmallFont (7×14, default), 1 = LargeFont (10×18).
+  // The terminal_view reads this every frame to pick its font + cell size.
+  int zoomLevel() const { return m_zoomLevel; }
+  void setZoomLevel(int z) {
+    if (z < 0) z = 0;
+    if (z > 1) z = 1;
+    m_zoomLevel = z;
+  }
+
+  // Scrollback viewport offset. 0 = newest at the bottom (default);
+  // positive = how many lines to skip (older content scrolls into view).
+  int viewOffset() const { return m_viewOffset; }
+  void setViewOffset(int n) { m_viewOffset = n < 0 ? 0 : n; }
+  void resetViewOffset() { m_viewOffset = 0; }
+
+  // Horizontal scroll: how many character cells to slide each scrollback
+  // row to the left when rendering, so lines wider than the screen can
+  // be read by sliding right with Shift+Right.
+  int horizOffset() const { return m_horizOffset; }
+  void setHorizOffset(int n) {
+    if (n < 0) n = 0;
+    if (n > k_maxHorizOffset) n = k_maxHorizOffset;
+    m_horizOffset = n;
+  }
+
+  // Currently-selected Claude model. Empty string means "default" (the
+  // calculator pins to sonnet for cost+speed). Valid values: "sonnet",
+  // "opus", "haiku", or a full ID like "claude-opus-4-7". Used by the
+  // claude command via prefixed header in the prompt frame.
+  const char* currentModel() const { return m_currentModel; }
+  void setCurrentModel(const char* name);
+
+  // Complete a prefix against built-in command names and VFS
+  // filenames. Writes up to one result into `outBuf` and returns true
+  // on a unique match; on ambiguity, lists candidates into scrollback
+  // and returns false. Empty prefix or no match: returns false.
+  bool completePrefix(const char* prefix, char* outBuf, size_t outCap);
+
+ private:
+  // Called when the line editor signals a submission. Parses, dispatches,
+  // appends output lines + the prompt line to scrollback, pushes to
+  // history.
+  void submitLine();
+
+  Scrollback* m_scrollback;
+  History* m_history;
+  LineEditor m_lineEditor;
+  int m_lastExitCode;
+  bool m_initialized;
+  ThemeId m_theme = ThemeId::Default;
+  int m_viewOffset = 0;
+  int m_zoomLevel = 0;  // 0 = small (7×14), 1 = large (10×18)
+  int m_horizOffset = 0;
+  // 32 chars covers the difference between scrollback line capacity (64)
+  // and the smallest visible width (Large font = 32 cols), with a bit of
+  // headroom. Past that, the user is scrolling into NUL bytes anyway.
+  static constexpr int k_maxHorizOffset = 48;
+  char m_currentModel[16] = "sonnet";  // default; `model` command can change.
+};
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/shell/textfx.cpp b/epsilon/apps/termia/shell/textfx.cpp
new file mode 100644
index 0000000000..1c6bf995c8
--- /dev/null
+++ b/epsilon/apps/termia/shell/textfx.cpp
@@ -0,0 +1,314 @@
+#include "textfx.h"
+
+#include <stdint.h>
+#include <string.h>
+
+namespace Termia {
+
+// One LaTeX-style replacement: token (without leading backslash) → ASCII
+// substitute. Matched longest-first by storing entries in descending
+// length order so we don't shadow longer prefixes (e.g. `\rightarrow`
+// before `\right`).
+struct LatexEntry {
+  const char* token;   // without backslash, NUL-terminated
+  uint8_t tokenLen;    // strlen(token); cached so we don't recompute
+  const char* repl;    // replacement text (NUL-terminated)
+};
+
+// Order: longer/more specific first within each group. The `tokenLen`
+// is computed by hand to keep this a const table on flash.
+static constexpr LatexEntry k_latex[] = {
+    // Greek (lowercase first, then cap)
+    {"alpha", 5, "a"},   {"beta", 4, "B"},     {"gamma", 5, "y"},
+    {"delta", 5, "d"},   {"epsilon", 7, "e"},  {"zeta", 4, "z"},
+    {"eta", 3, "n"},     {"theta", 5, "th"},   {"iota", 4, "i"},
+    {"kappa", 5, "k"},   {"lambda", 6, "lam"}, {"mu", 2, "u"},
+    {"nu", 2, "v"},      {"xi", 2, "x"},       {"pi", 2, "pi"},
+    {"rho", 3, "p"},     {"sigma", 5, "s"},    {"tau", 3, "t"},
+    {"phi", 3, "ph"},    {"chi", 3, "X"},      {"psi", 3, "ps"},
+    {"omega", 5, "w"},   {"Gamma", 5, "Y"},    {"Delta", 5, "D"},
+    {"Theta", 5, "Th"},  {"Lambda", 6, "Lam"}, {"Pi", 2, "Pi"},
+    {"Sigma", 5, "Sum"}, {"Phi", 3, "Ph"},     {"Psi", 3, "Ps"},
+    {"Omega", 5, "Om"},
+    // Math operators
+    {"sum", 3, "Sum"},     {"prod", 4, "Prod"},   {"int", 3, "Int"},
+    {"infty", 5, "inf"},   {"infinity", 8, "inf"},
+    {"sqrt", 4, "sqrt"},   {"cdot", 4, "."},      {"times", 5, "x"},
+    {"div", 3, "/"},       {"pm", 2, "+/-"},      {"mp", 2, "-/+"},
+    {"ne", 2, "!="},       {"neq", 3, "!="},      {"leq", 3, "<="},
+    {"le", 2, "<="},       {"geq", 3, ">="},      {"ge", 2, ">="},
+    {"approx", 6, "~="},   {"equiv", 5, "==="},   {"propto", 6, "~"},
+    // Arrows
+    {"rightarrow", 10, "->"},   {"leftarrow", 9, "<-"},
+    {"Rightarrow", 10, "=>"},   {"Leftarrow", 9, "<="},
+    {"leftrightarrow", 14, "<->"},
+    {"to", 2, "->"},            {"gets", 4, "<-"},
+    {"uparrow", 7, "^"},        {"downarrow", 9, "v"},
+    // Misc
+    {"in", 2, "in"},     {"notin", 5, "not in"},   {"subset", 6, "subset"},
+    {"supset", 6, "supset"}, {"subseteq", 8, "<="},{"supseteq", 8, ">="},
+    {"forall", 6, "for all "}, {"exists", 6, "exists "},
+    {"land", 4, "AND"},  {"lor", 3, "OR"},          {"neg", 3, "NOT"},
+    {"emptyset", 8, "{}"}, {"angle", 5, "/_"},
+    // Bracket helpers — drop the modifier, keep the bracket so
+    // "\left( a + b \right)" reads as "( a + b )".
+    {"left", 4, ""}, {"right", 5, ""}, {"big", 3, ""}, {"Big", 3, ""},
+    {"bigg", 4, ""}, {"Bigg", 4, ""},
+    // Fractions / binomials — \frac{a}{b} → "(a)/(b)" via the same
+    // brace-mapping that LaTeX text uses.
+    {"frac", 4, ""}, {"dfrac", 5, ""}, {"tfrac", 5, ""},
+    {"binom", 5, "C"}, {"choose", 6, "C"},
+    {"text", 4, ""},  {"mathbf", 6, ""}, {"mathit", 6, ""}, {"mathrm", 6, ""},
+    {"mathcal", 7, ""}, {"mathbb", 6, ""}, {"operatorname", 12, ""},
+    {"begin", 5, ""},  {"end", 3, ""},  {"label", 5, ""},  {"ref", 3, ""},
+    // LaTeX `\\` (line break): the outer translator already consumes
+    // the first backslash, so the token here is just the second `\`.
+    {"\\", 1, " | "},
+    // Whitespace controls — render as a single space so "$x \, y$" doesn't
+    // glue together.
+    {",", 1, " "}, {";", 1, " "}, {"!", 1, ""},  {":", 1, " "},
+    {"quad", 4, "  "},   {"qquad", 5, "    "},
+};
+
+static constexpr size_t k_latexCount = sizeof(k_latex) / sizeof(k_latex[0]);
+
+// UTF-8 codepoint → ASCII substitute. Match key is the codepoint, not the
+// byte sequence, so we decode first.
+struct UnicodeEntry {
+  uint32_t cp;
+  const char* repl;
+};
+
+static constexpr UnicodeEntry k_unicode[] = {
+    // Greek lowercase
+    {0x03B1, "a"},  {0x03B2, "B"},  {0x03B3, "y"},  {0x03B4, "d"},
+    {0x03B5, "e"},  {0x03B6, "z"},  {0x03B7, "n"},  {0x03B8, "th"},
+    {0x03B9, "i"},  {0x03BA, "k"},  {0x03BB, "lam"},{0x03BC, "u"},
+    {0x03BD, "v"},  {0x03BE, "x"},  {0x03BF, "o"},  {0x03C0, "pi"},
+    {0x03C1, "p"},  {0x03C3, "s"},  {0x03C2, "s"},  {0x03C4, "t"},
+    {0x03C5, "y"},  {0x03C6, "ph"}, {0x03C7, "X"},  {0x03C8, "ps"},
+    {0x03C9, "w"},
+    // Greek capitals
+    {0x0393, "Y"},  {0x0394, "D"},  {0x0398, "Th"}, {0x039B, "Lam"},
+    {0x03A0, "Pi"}, {0x03A3, "Sum"},{0x03A6, "Ph"}, {0x03A8, "Ps"},
+    {0x03A9, "Om"},
+    // Math
+    {0x00B0, "deg"}, {0x00B1, "+/-"},{0x00B2, "^2"}, {0x00B3, "^3"},
+    {0x00B5, "u"},   {0x00B7, "."},  {0x00BC, "1/4"},{0x00BD, "1/2"},
+    {0x00BE, "3/4"}, {0x00D7, "x"},  {0x00F7, "/"},
+    {0x2018, "'"},   {0x2019, "'"},  {0x201C, "\""},{0x201D, "\""},
+    {0x2013, "-"},   {0x2014, "--"}, {0x2026, "..."},
+    {0x2032, "'"},   {0x2033, "''"},
+    {0x2200, "for all "}, {0x2202, "d"},  {0x2203, "exists "},
+    {0x2205, "{}"},  {0x2208, " in "}, {0x2209, " not in "},
+    {0x221A, "sqrt"},{0x221E, "inf"},
+    {0x2227, " AND "}, {0x2228, " OR "}, {0x2229, " ^ "},
+    {0x222A, " U "},   {0x222B, "Int"},   {0x2248, "~="},
+    {0x2260, "!="},    {0x2261, "==="},   {0x2264, "<="},
+    {0x2265, ">="},    {0x2282, "subset"},{0x2286, "subseteq"},
+    {0x2295, "(+)"},   {0x2297, "(x)"},   {0x2299, "(.)"},
+    {0x22C5, "."},
+    // Arrows
+    {0x2190, "<-"},  {0x2191, "^"},   {0x2192, "->"},  {0x2193, "v"},
+    {0x2194, "<->"}, {0x21D0, "<="}, {0x21D2, "=>"},  {0x21D4, "<=>"},
+    // Superscripts / subscripts (only the common ones)
+    {0x2070, "^0"}, {0x2071, "^i"}, {0x2074, "^4"}, {0x2075, "^5"},
+    {0x2076, "^6"}, {0x2077, "^7"}, {0x2078, "^8"}, {0x2079, "^9"},
+    {0x207A, "^+"}, {0x207B, "^-"}, {0x207C, "^="}, {0x207F, "^n"},
+    {0x2080, "_0"}, {0x2081, "_1"}, {0x2082, "_2"}, {0x2083, "_3"},
+    {0x2084, "_4"}, {0x2085, "_5"}, {0x2086, "_6"}, {0x2087, "_7"},
+    {0x2088, "_8"}, {0x2089, "_9"},
+    // Box drawing: collapse to + / - / | so frames still read as frames.
+    {0x2500, "-"},  {0x2502, "|"},  {0x250C, "+"}, {0x2510, "+"},
+    {0x2514, "+"},  {0x2518, "+"},  {0x251C, "+"}, {0x2524, "+"},
+    {0x252C, "+"},  {0x2534, "+"},  {0x253C, "+"},
+    {0x2550, "="},  {0x2551, "|"},  {0x2554, "+"}, {0x2557, "+"},
+    {0x255A, "+"},  {0x255D, "+"},
+    // Bullets / dots
+    {0x2022, "*"},  {0x25CF, "*"},  {0x25CB, "o"},
+    // Common emoji-as-symbol fallbacks
+    {0x2713, "v"},  {0x2717, "x"},  {0x2705, "[v]"}, {0x274C, "[x]"},
+    {0x26A0, "[!]"},{0x1F44D, "+1"},{0x1F389, "*"}, {0x1F4A1, "[i]"},
+    // Currency (so prices don't blank out)
+    {0x20AC, "EUR"},{0x00A3, "GBP"},{0x00A5, "JPY"},
+    // No-break space → regular space
+    {0x00A0, " "},
+};
+
+static constexpr size_t k_unicodeCount =
+    sizeof(k_unicode) / sizeof(k_unicode[0]);
+
+// Decode one UTF-8 codepoint starting at `s`. On success, sets `*outCp`
+// and returns the number of bytes consumed. On any malformed input,
+// consumes a single byte and returns 1 with cp = 0xFFFD (replacement).
+static size_t utf8Decode(const unsigned char* s, uint32_t* outCp) {
+  unsigned char b = s[0];
+  if (b < 0x80) {
+    *outCp = b;
+    return 1;
+  }
+  // Need to know length from the leading bits.
+  size_t need;
+  uint32_t cp;
+  if ((b & 0xE0) == 0xC0) {
+    need = 2;
+    cp = b & 0x1F;
+  } else if ((b & 0xF0) == 0xE0) {
+    need = 3;
+    cp = b & 0x0F;
+  } else if ((b & 0xF8) == 0xF0) {
+    need = 4;
+    cp = b & 0x07;
+  } else {
+    *outCp = 0xFFFD;
+    return 1;
+  }
+  for (size_t i = 1; i < need; i++) {
+    unsigned char nb = s[i];
+    if ((nb & 0xC0) != 0x80) {
+      // Truncated / malformed — bail and let the caller advance one byte.
+      *outCp = 0xFFFD;
+      return 1;
+    }
+    cp = (cp << 6) | (nb & 0x3F);
+  }
+  *outCp = cp;
+  return need;
+}
+
+// Linear scan — table is small (<200 entries) and called per multi-byte
+// codepoint, not per byte, so this stays cheap. A binary search would
+// only matter if the table grew several × bigger.
+static const char* lookupUnicode(uint32_t cp) {
+  for (size_t i = 0; i < k_unicodeCount; i++) {
+    if (k_unicode[i].cp == cp) return k_unicode[i].repl;
+  }
+  return nullptr;
+}
+
+// Try to match a LaTeX command starting at `*pSrc` (which points at the
+// character right after the backslash). On match, *pSrc is advanced past
+// the token and the replacement is appended to dst.
+//
+// Returns true if a token was matched. False means the caller should emit
+// the literal backslash + first char and move on.
+static bool matchLatex(const char** pSrc, char* dst, size_t dstCap,
+                       size_t* pDstLen) {
+  const char* src = *pSrc;
+  for (size_t i = 0; i < k_latexCount; i++) {
+    const LatexEntry& e = k_latex[i];
+    if (memcmp(src, e.token, e.tokenLen) == 0) {
+      // Reject partial matches: the token must end at a non-letter
+      // boundary, otherwise `\pi` would eagerly match `\pibble`.
+      char following = src[e.tokenLen];
+      bool letterAfter = (following >= 'a' && following <= 'z') ||
+                         (following >= 'A' && following <= 'Z');
+      if (letterAfter) continue;
+      // Append replacement (clipped to dstCap-1 incl trailing NUL).
+      size_t rl = strlen(e.repl);
+      if (*pDstLen + rl >= dstCap) {
+        rl = (dstCap > 0 && *pDstLen < dstCap - 1) ? (dstCap - 1 - *pDstLen)
+                                                   : 0;
+      }
+      memcpy(dst + *pDstLen, e.repl, rl);
+      *pDstLen += rl;
+      *pSrc = src + e.tokenLen;
+      return true;
+    }
+  }
+  return false;
+}
+
+// Skip an ANSI CSI escape sequence: ESC '[' params… terminator(@-~).
+// Also handle ESC ']' OSC sequences (terminate at BEL or ESC \).
+// Returns the number of source bytes consumed (>= 1). Caller has
+// already confirmed *p == 0x1b.
+static size_t skipAnsi(const char* p) {
+  // p[0] == ESC. If we don't recognise the next byte, just consume the
+  // ESC alone — better to drop one byte than render a literal ESC.
+  if (p[1] == '\0') return 1;
+  unsigned char nb = static_cast<unsigned char>(p[1]);
+  // CSI: ESC [ ... <terminator @-~>
+  if (nb == '[') {
+    size_t i = 2;
+    while (p[i]) {
+      unsigned char c = static_cast<unsigned char>(p[i]);
+      if (c >= 0x40 && c <= 0x7E) return i + 1;  // terminator
+      i++;
+    }
+    return i;
+  }
+  // OSC: ESC ] ... BEL  (or ESC \)
+  if (nb == ']') {
+    size_t i = 2;
+    while (p[i]) {
+      if (static_cast<unsigned char>(p[i]) == 0x07) return i + 1;
+      if (p[i] == 0x1b && p[i + 1] == '\\') return i + 2;
+      i++;
+    }
+    return i;
+  }
+  // Two-byte ESC sequences (=, >, M, etc.) — drop the byte after ESC.
+  return 2;
+}
+
+size_t translate(const char* src, char* dst, size_t dstCap) {
+  if (dst == nullptr || dstCap == 0) return 0;
+  if (src == nullptr) {
+    dst[0] = '\0';
+    return 0;
+  }
+  size_t dstLen = 0;
+  const char* p = src;
+  while (*p && dstLen + 1 < dstCap) {
+    unsigned char b = static_cast<unsigned char>(*p);
+
+    // ANSI / VT escape: drop the whole sequence so terminal-coloured
+    // output (claude CLI in some modes, ripgrep, ls --color, …) renders
+    // as plain text instead of leaving "[1m" garbage in the scrollback.
+    if (b == 0x1b) {
+      p += skipAnsi(p);
+      continue;
+    }
+
+    // LaTeX command
+    if (b == '\\') {
+      const char* afterSlash = p + 1;
+      if (matchLatex(&afterSlash, dst, dstCap, &dstLen)) {
+        p = afterSlash;
+        continue;
+      }
+      // Not a known command — drop the backslash so the line still reads.
+      p++;
+      continue;
+    }
+
+    // ASCII printable: copy through.
+    if (b < 0x80) {
+      dst[dstLen++] = static_cast<char>(b);
+      p++;
+      continue;
+    }
+
+    // UTF-8 multi-byte: decode + look up.
+    uint32_t cp;
+    size_t n = utf8Decode(reinterpret_cast<const unsigned char*>(p), &cp);
+    p += n;
+    const char* repl = lookupUnicode(cp);
+    if (repl == nullptr) {
+      // Unknown codepoint: a single '?' is friendlier than dropping silently.
+      if (dstLen + 1 < dstCap) {
+        dst[dstLen++] = '?';
+      }
+      continue;
+    }
+    size_t rl = strlen(repl);
+    if (dstLen + rl >= dstCap) rl = dstCap - 1 - dstLen;
+    memcpy(dst + dstLen, repl, rl);
+    dstLen += rl;
+  }
+  dst[dstLen] = '\0';
+  return dstLen;
+}
+
+}  // namespace Termia
