+#pragma once
+
+#include <apps/numtube/link.h>
+#include <apps/numtube/tile_decoder.h>
+#include <escher/view.h>
+#include <escher/view_controller.h>
+#include <kandinsky/font.h>
+
+namespace Numscreen {
+
+class ScreenController;
+
+// Start and error screens (the shared screen itself is drawn straight to the
+// display by the session loop).
+class StartView : public Escher::View {
+ public:
+  explicit StartView(const ScreenController* controller) : m_controller(controller) {}
+  void drawRect(KDContext* ctx, KDRect rect) const override;
+  void redrawAll() { markRectAsDirty(bounds()); }
+
+ private:
+  void drawCentered(KDContext* ctx, const char* text, int y, KDColor color,
+                    KDFont::Size font) const;
+  const ScreenController* m_controller;
+};
+
+class ScreenController : public Escher::ViewController {
+ public:
+  explicit ScreenController(Escher::Responder* parentResponder);
+
+  Escher::View* view() override { return &m_view; }
+  bool handleEvent(Ion::Events::Event event) override;
+  void viewWillAppear() override;
+  void disconnect() { m_link.disconnect(); }
+  // Called by the app's timer while Escher runs.
+  void tick();
+
+  const char* message() const { return m_message; }
+
+  // TileDecoder's blitter interface.
+  void push(int x, int y, int width, const uint16_t* pixels);
+
+  // The computer screen: 320x200 at the top, a status strip below.
+  static constexpr int k_pictureRows = 50;  // rows of 4x4 tiles
+  static constexpr int k_pictureHeight = k_pictureRows * Numtube::k_tileSize;
+  static constexpr int k_stripY = k_pictureHeight;
+  static constexpr int k_stripHeight = 240 - k_pictureHeight;
+
+ private:
+  enum class Exit { Stopped, Error };
+
+  void showStart();
+  void showMessage(const char* message);
+  void runSession();
+  Exit share();
+  bool forwardKeys();
+  void handleFrame(uint8_t type, const uint8_t* payload, uint16_t length);
+  void drawStrip();
+
+  using Decoder = Numtube::TileDecoder<ScreenController, k_pictureRows>;
+
+  StartView m_view;
+  Numtube::Link m_link;
+  Decoder m_decoder;
+  uint16_t m_rowBuffer[Decoder::k_rowBufferPixels];
+  uint64_t m_keyState;
+  uint64_t m_lastScan;
+  bool m_autoStart;
+  bool m_stripDirty;
+  bool m_framesSeen;
+  char m_message[120];
+  char m_status[96];
+};
+
+}  // namespace Numscreen
