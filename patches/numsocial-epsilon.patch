diff --git a/shared/ion/src/device/shared/usb/cdc_interface.cpp b/shared/ion/src/device/shared/usb/cdc_interface.cpp
new file mode 100644
index 0000000000..4ba700dd24
--- /dev/null
+++ b/shared/ion/src/device/shared/usb/cdc_interface.cpp
@@ -0,0 +1,73 @@
+#include "cdc_interface.h"
+
+#include <string.h>
+
+namespace Ion {
+namespace Device {
+namespace USB {
+
+bool CDCInterface::processSetupInRequest(SetupPacket* request,
+                                         uint8_t* transferBuffer,
+                                         uint16_t* transferBufferLength,
+                                         uint16_t transferBufferMaxLength) {
+  // Standard interface requests (SET/GET_INTERFACE, GET_STATUS, ...) —
+  // let the base class handle them.
+  if (Interface::processSetupInRequest(request, transferBuffer,
+                                       transferBufferLength,
+                                       transferBufferMaxLength)) {
+    return true;
+  }
+
+  // Everything we handle below is class-specific (CDC).
+  if (request->requestType() != SetupPacket::RequestType::Class) {
+    return false;
+  }
+
+  switch (request->bRequest()) {
+    case static_cast<uint8_t>(CDCRequest::SetLineCoding):
+      // The 7-byte line-coding payload arrives in the following data-OUT
+      // phase. We reserve space in the transfer buffer for it; the actual
+      // parse happens in wholeDataReceivedCallback once the host finishes
+      // pushing the bytes. Acknowledge the setup by returning true.
+      *transferBufferLength = 0;
+      return true;
+
+    case static_cast<uint8_t>(CDCRequest::GetLineCoding): {
+      uint16_t n =
+          transferBufferMaxLength < sizeof(LineCoding) ? transferBufferMaxLength
+                                                       : sizeof(LineCoding);
+      memcpy(transferBuffer, &m_lineCoding, n);
+      *transferBufferLength = n;
+      return true;
+    }
+
+    case static_cast<uint8_t>(CDCRequest::SetControlLineState):
+      // wValue low byte: bit 0 = DTR, bit 1 = RTS. No OUT data phase.
+      m_controlLineState = request->wValue();
+      *transferBufferLength = 0;
+      return true;
+
+    case static_cast<uint8_t>(CDCRequest::SendBreak):
+      // Not meaningful on a virtual port without a backing UART; just
+      // acknowledge so the host's write(2) to cdc_acm doesn't error.
+      *transferBufferLength = 0;
+      return true;
+  }
+  return false;
+}
+
+void CDCInterface::wholeDataReceivedCallback(SetupPacket* request,
+                                             uint8_t* transferBuffer,
+                                             uint16_t* transferBufferLength) {
+  if (request->requestType() != SetupPacket::RequestType::Class) {
+    return;
+  }
+  if (request->bRequest() == static_cast<uint8_t>(CDCRequest::SetLineCoding) &&
+      *transferBufferLength >= sizeof(LineCoding)) {
+    memcpy(&m_lineCoding, transferBuffer, sizeof(LineCoding));
+  }
+}
+
+}  // namespace USB
+}  // namespace Device
+}  // namespace Ion
diff --git a/shared/ion/src/device/shared/usb/cdc_interface.h b/shared/ion/src/device/shared/usb/cdc_interface.h
new file mode 100644
index 0000000000..c0ed877b4b
--- /dev/null
+++ b/shared/ion/src/device/shared/usb/cdc_interface.h
@@ -0,0 +1,83 @@
+#pragma once
+
+#include <stdint.h>
+
+#include "stack/endpoint0.h"
+#include "stack/interface.h"
+#include "stack/setup_packet.h"
+
+namespace Ion {
+namespace Device {
+namespace USB {
+
+/* CDC-ACM class interface handler.
+ *
+ * Binds control-endpoint dispatch for the CDC class-specific requests
+ * that the Linux cdc_acm driver issues when it probes the device:
+ *
+ *   SET_LINE_CODING (0x20)     — OUT, 7 B  (baud, stop, parity, bits)
+ *   GET_LINE_CODING (0x21)     — IN,  7 B  (echoes last-set line coding)
+ *   SET_CONTROL_LINE_STATE (0x22) — wValue bits 0,1 = DTR, RTS
+ *   SEND_BREAK (0x23)          — wValue = duration in ms (ignored)
+ *
+ * Since data on our ACM port rides USB bulk transfers directly (not a
+ * real UART), baud / parity / break are all accepted but have no
+ * physical meaning. We remember the line coding so GET returns the
+ * same bytes the host most recently SET — some host software asserts
+ * round-trip correctness.
+ *
+ * The class-specific request recipient field of a Setup packet targets
+ * the CDC Control interface (number 0 in our composite layout). The
+ * CDC Data interface (number 1) has no class-specific requests and
+ * simply delegates to the base Interface handler for standard ones.
+ * Since Endpoint0 routes every interface-recipient request through a
+ * single `Interface*`, we dispatch both interface numbers here and
+ * ignore non-CDC requests (falling through to the base). */
+class CDCInterface : public Interface {
+ public:
+  explicit CDCInterface(Endpoint0* ep0)
+      : Interface(ep0),
+        m_lineCoding{115200, 0, 0, 8},
+        m_controlLineState(0),
+        m_activeAlternateSetting(0) {}
+
+  void wholeDataReceivedCallback(SetupPacket* request, uint8_t* transferBuffer,
+                                 uint16_t* transferBufferLength) override;
+
+ protected:
+  bool processSetupInRequest(SetupPacket* request, uint8_t* transferBuffer,
+                             uint16_t* transferBufferLength,
+                             uint16_t transferBufferMaxLength) override;
+  void setActiveInterfaceAlternative(uint8_t index) override {
+    m_activeAlternateSetting = index;
+  }
+  uint8_t getActiveInterfaceAlternative() override {
+    return m_activeAlternateSetting;
+  }
+
+ private:
+  // CDC class-specific request codes (USB CDC PSTN 1.2 §6.3).
+  enum class CDCRequest : uint8_t {
+    SetLineCoding = 0x20,
+    GetLineCoding = 0x21,
+    SetControlLineState = 0x22,
+    SendBreak = 0x23,
+  };
+
+  // USB CDC PSTN 1.2 Table 17 — line coding structure (7 bytes).
+  struct __attribute__((packed)) LineCoding {
+    uint32_t dwDTERate;    // Baud rate (not physically honoured).
+    uint8_t bCharFormat;   // 0 = 1 stop bit, 1 = 1.5, 2 = 2.
+    uint8_t bParityType;   // 0 = none, 1 = odd, 2 = even, 3 = mark, 4 = space.
+    uint8_t bDataBits;     // 5, 6, 7, 8, or 16.
+  };
+  static_assert(sizeof(LineCoding) == 7, "CDC LineCoding must be 7 bytes");
+
+  LineCoding m_lineCoding;
+  uint16_t m_controlLineState;  // bit 0 = DTR, bit 1 = RTS.
+  uint8_t m_activeAlternateSetting;
+};
+
+}  // namespace USB
+}  // namespace Device
+}  // namespace Ion
diff --git a/shared/ion/src/device/shared/usb/stack/descriptor/cdc_functional_descriptor.cpp b/shared/ion/src/device/shared/usb/stack/descriptor/cdc_functional_descriptor.cpp
new file mode 100644
index 0000000000..38ce5ecaf0
--- /dev/null
+++ b/shared/ion/src/device/shared/usb/stack/descriptor/cdc_functional_descriptor.cpp
@@ -0,0 +1,51 @@
+#include "cdc_functional_descriptor.h"
+
+namespace Ion {
+namespace Device {
+namespace USB {
+
+// Header --------------------------------------------------------------------
+void CDCHeaderFunctionalDescriptor::push(Channel* c) const {
+  Descriptor::push(c);
+  c->push(static_cast<uint8_t>(0x00));  // bDescriptorSubType = Header
+  c->push(m_bcdCDC);
+  if (m_next != nullptr) {
+    m_next->push(c);
+  }
+}
+
+// Call Management -----------------------------------------------------------
+void CDCCallManagementFunctionalDescriptor::push(Channel* c) const {
+  Descriptor::push(c);
+  c->push(static_cast<uint8_t>(0x01));  // bDescriptorSubType = Call Management
+  c->push(m_bmCapabilities);
+  c->push(m_bDataInterface);
+  if (m_next != nullptr) {
+    m_next->push(c);
+  }
+}
+
+// ACM -----------------------------------------------------------------------
+void CDCACMFunctionalDescriptor::push(Channel* c) const {
+  Descriptor::push(c);
+  c->push(static_cast<uint8_t>(0x02));  // bDescriptorSubType = ACM
+  c->push(m_bmCapabilities);
+  if (m_next != nullptr) {
+    m_next->push(c);
+  }
+}
+
+// Union ---------------------------------------------------------------------
+void CDCUnionFunctionalDescriptor::push(Channel* c) const {
+  Descriptor::push(c);
+  c->push(static_cast<uint8_t>(0x06));  // bDescriptorSubType = Union
+  c->push(m_bControlInterface);
+  c->push(m_bSubordinateInterface0);
+  if (m_next != nullptr) {
+    m_next->push(c);
+  }
+}
+
+}  // namespace USB
+}  // namespace Device
+}  // namespace Ion
diff --git a/shared/ion/src/device/shared/usb/stack/descriptor/cdc_functional_descriptor.h b/shared/ion/src/device/shared/usb/stack/descriptor/cdc_functional_descriptor.h
new file mode 100644
index 0000000000..204bb2e212
--- /dev/null
+++ b/shared/ion/src/device/shared/usb/stack/descriptor/cdc_functional_descriptor.h
@@ -0,0 +1,120 @@
+#pragma once
+
+#include "descriptor.h"
+
+namespace Ion {
+namespace Device {
+namespace USB {
+
+/* USB CDC v1.2 class-specific "functional" descriptors. All share
+ * bDescriptorType = 0x24 (CS_INTERFACE) and are differentiated by the
+ * `bDescriptorSubType` byte. They live in the "extra descriptors"
+ * slot of the CDC Control interface descriptor, serialized in the
+ * order: Header → CallManagement → ACM → Union → interruptEndpoint.
+ *
+ * Each supports an optional `next` pointer so the whole sequence is
+ * built as a linked chain instead of a parallel array.
+ *
+ * Reference: USB Class Definitions for Communications Devices 1.2,
+ * sections 5.2.3 (Header), 5.2.3.2 (Call Management), 5.2.3.3 (ACM),
+ * 5.2.3.8 (Union). */
+
+// bDescriptorSubType = 0x00. Announces the CDC version the interface
+// complies to.
+class CDCHeaderFunctionalDescriptor : public Descriptor {
+ public:
+  constexpr explicit CDCHeaderFunctionalDescriptor(
+      uint16_t bcdCDC, const Descriptor* next = nullptr)
+      : Descriptor(0x24), m_bcdCDC(bcdCDC), m_next(next) {}
+  constexpr static uint8_t BLength() {
+    return Descriptor::BLength() + sizeof(uint8_t) + sizeof(uint16_t);
+  }
+
+ protected:
+  void push(Channel* c) const override;
+  uint8_t bLength() const override { return BLength(); }
+
+ private:
+  uint16_t m_bcdCDC;
+  const Descriptor* m_next;
+};
+
+// bDescriptorSubType = 0x01. `bmCapabilities` bit 0: device handles
+// call management itself (0 = no). Bit 1: device can send/receive call
+// management info over Data Class interface (0 = over Comm Class only).
+// For our ACM virtual port we use 0x00 — we do no call management.
+class CDCCallManagementFunctionalDescriptor : public Descriptor {
+ public:
+  constexpr CDCCallManagementFunctionalDescriptor(
+      uint8_t bmCapabilities, uint8_t bDataInterface,
+      const Descriptor* next = nullptr)
+      : Descriptor(0x24),
+        m_bmCapabilities(bmCapabilities),
+        m_bDataInterface(bDataInterface),
+        m_next(next) {}
+  constexpr static uint8_t BLength() {
+    return Descriptor::BLength() + 3 * sizeof(uint8_t);
+  }
+
+ protected:
+  void push(Channel* c) const override;
+  uint8_t bLength() const override { return BLength(); }
+
+ private:
+  uint8_t m_bmCapabilities;
+  uint8_t m_bDataInterface;
+  const Descriptor* m_next;
+};
+
+// bDescriptorSubType = 0x02. `bmCapabilities` bit 1 (Set_Line_Coding /
+// Set_Control_Line_State / Get_Line_Coding) is the only one hosts
+// routinely check for. We set 0x02 so Linux's cdc_acm happily binds;
+// the setter requests themselves are no-ops on our side (baud rate is
+// irrelevant — data rides USB bulk transfers directly).
+class CDCACMFunctionalDescriptor : public Descriptor {
+ public:
+  constexpr explicit CDCACMFunctionalDescriptor(
+      uint8_t bmCapabilities, const Descriptor* next = nullptr)
+      : Descriptor(0x24), m_bmCapabilities(bmCapabilities), m_next(next) {}
+  constexpr static uint8_t BLength() {
+    return Descriptor::BLength() + 2 * sizeof(uint8_t);
+  }
+
+ protected:
+  void push(Channel* c) const override;
+  uint8_t bLength() const override { return BLength(); }
+
+ private:
+  uint8_t m_bmCapabilities;
+  const Descriptor* m_next;
+};
+
+// bDescriptorSubType = 0x06. Identifies which interface is the
+// "master" (Control) and which is subordinate (Data). For our simple
+// ACM port there is exactly one subordinate.
+class CDCUnionFunctionalDescriptor : public Descriptor {
+ public:
+  constexpr CDCUnionFunctionalDescriptor(uint8_t bControlInterface,
+                                         uint8_t bSubordinateInterface0,
+                                         const Descriptor* next = nullptr)
+      : Descriptor(0x24),
+        m_bControlInterface(bControlInterface),
+        m_bSubordinateInterface0(bSubordinateInterface0),
+        m_next(next) {}
+  constexpr static uint8_t BLength() {
+    return Descriptor::BLength() + 3 * sizeof(uint8_t);
+  }
+
+ protected:
+  void push(Channel* c) const override;
+  uint8_t bLength() const override { return BLength(); }
+
+ private:
+  uint8_t m_bControlInterface;
+  uint8_t m_bSubordinateInterface0;
+  const Descriptor* m_next;
+};
+
+}  // namespace USB
+}  // namespace Device
+}  // namespace Ion
