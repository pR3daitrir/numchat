diff --git a/epsilon/apps/termia/app.cpp b/epsilon/apps/termia/app.cpp
new file mode 100644
index 0000000000..7a8700b838
--- /dev/null
+++ b/epsilon/apps/termia/app.cpp
@@ -0,0 +1,73 @@
+#include "app.h"
+
+#include <escher/container.h>
+#include <ion/termia_usb.h>
+#include <poincare/pool.h>
+#include <python/port/port.h>
+
+#include "termia_icon.h"
+
+namespace Termia {
+
+// Descriptor ----------------------------------------------------------------
+const Escher::Image* App::Descriptor::icon() const {
+  return ImageStore::TermiaIcon;
+}
+
+// Snapshot ------------------------------------------------------------------
+App* App::Snapshot::unpack(Escher::Container* container) {
+  return new (container->currentAppBuffer()) App(this);
+}
+
+const App::Descriptor* App::Snapshot::descriptor() const {
+  constexpr static Descriptor s_descriptor;
+  return &s_descriptor;
+}
+
+void App::Snapshot::reset() {
+  m_scrollback.clear();
+  m_history = History();  // reset browse cursor + contents
+}
+
+// App -----------------------------------------------------------------------
+App::App(Snapshot* snapshot)
+    : Escher::App(snapshot, &m_shellController),
+      m_shellController(&m_modalViewController, snapshot->scrollback(),
+                        snapshot->history()),
+      m_pythonInited(false) {}
+
+void App::willBecomeInactive() {
+  // Release MicroPython so Epsilon's other apps get their Poincare pool
+  // back when the user leaves Termia.
+  releasePython();
+  // Drop the USB tether if it's up — other apps (Settings → USB, DFU)
+  // can't share the controller. Subsequent returns to Termia will
+  // re-enumerate on the first `claude` call.
+  Ion::USB::Termia::closeTether();
+  Escher::App::willBecomeInactive();
+}
+
+void App::ensurePython() {
+  if (m_pythonInited) {
+    return;
+  }
+  // MicroPython co-opts memory that Poincare's pool lives in, so the
+  // pool has to be fully empty and torn down before we init. This
+  // mirrors the dance Code::App does in initPythonWithUser().
+  Poincare::Pool::sharedPool.deinit();
+  MicroPython::init(m_pythonHeap, m_pythonHeap + k_pythonHeapSize);
+  m_pythonInited = true;
+}
+
+void App::releasePython() {
+  if (!m_pythonInited) {
+    return;
+  }
+  MicroPython::deinit();
+  m_pythonInited = false;
+  // Re-init Poincare's pool so other apps that rely on it work after we
+  // leave. Mirrors Code::App's deinitPython().
+  Poincare::Pool::sharedPool.init();
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/app.h b/epsilon/apps/termia/app.h
new file mode 100644
index 0000000000..883caa22a2
--- /dev/null
+++ b/epsilon/apps/termia/app.h
@@ -0,0 +1,90 @@
+#pragma once
+
+#include <apps/i18n.h>
+#include <escher/app.h>
+
+#include "shell/history.h"
+#include "shell/scrollback.h"
+#include "ui/shell_controller.h"
+
+namespace Termia {
+
+class App : public Escher::App {
+ public:
+  class Descriptor : public Escher::App::Descriptor {
+   public:
+    I18n::Message name() const override { return I18n::Message::TermiaApp; }
+    I18n::Message upperName() const override {
+      return I18n::Message::TermiaAppCapital;
+    }
+    const Escher::Image* icon() const override;
+  };
+
+  // Persistent state — survives app transitions per Escher::App contract.
+  // Holds the scrollback (16 KB) and command history (2 KB) so the shell
+  // resumes where you left off when you Home-out and come back.
+  class Snapshot : public Escher::App::Snapshot {
+   public:
+    Snapshot() = default;
+    App* unpack(Escher::Container* container) override;
+    const Descriptor* descriptor() const override;
+
+    // Called on exam mode or explicit reset — wipes all state.
+    void reset() override;
+
+    Scrollback* scrollback() { return &m_scrollback; }
+    History* history() { return &m_history; }
+
+   private:
+    Scrollback m_scrollback;
+    History m_history;
+  };
+
+  static App* app() { return static_cast<App*>(Escher::App::app()); }
+  Snapshot* snapshot() {
+    return static_cast<Snapshot*>(Escher::App::snapshot());
+  }
+
+  // Lifecycle hook — we tear MicroPython down when we leave so Epsilon's
+  // Poincare pool becomes usable again. Matches Code::App's pattern.
+  void willBecomeInactive() override;
+
+  // Python lifecycle for Phase 4's `run` command. Both are idempotent.
+  // ensurePython() lazily initialises the embedded MicroPython interpreter
+  // on our 64 KB heap; releasePython() tears it down and hands memory back
+  // to Poincare.
+  void ensurePython();
+  void releasePython();
+  bool pythonReady() const { return m_pythonInited; }
+
+  // Exposed so run_python.cpp can stage script bytes there (see the
+  // buffer's `private:` declaration below for rationale on why it lives
+  // in the App's union slot).
+  size_t scriptSourceCap() const { return k_scriptSourceCap; }
+  char* scriptSourceBuf() { return m_scriptSourceBuf; }
+
+ private:
+  App(Snapshot* snapshot);
+
+  ShellController m_shellController;
+
+  // MicroPython heap. We use 32 KB (half of Code::App's 64 KB) so the
+  // Apps union doesn't exceed Code::App's size — Code stays the biggest
+  // member of the union, and our 32 KB is comfortably inside its
+  // existing slot. Simple scripts (Phase 4's verification target is a
+  // Fibonacci printer) fit easily; more ambitious scripts should run in
+  // Epsilon's dedicated Python app.
+  static constexpr size_t k_pythonHeapSize = 24 * 1024;
+  char m_pythonHeap[k_pythonHeapSize];
+
+  // Staging buffer for the Python source we copy out of Ion::Storage
+  // before MicroPython::init mutates it. Lives in the App (union slot,
+  // so union size doesn't grow as long as Code::App stays biggest)
+  // rather than a free-standing static so we don't balloon the generic
+  // .bss section and overrun the userland linker budget.
+  static constexpr size_t k_scriptSourceCap = 2048;
+  char m_scriptSourceBuf[k_scriptSourceCap + 1];
+  bool m_pythonInited;
+};
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/commands/builtin.cpp b/epsilon/apps/termia/commands/builtin.cpp
new file mode 100644
index 0000000000..dbb87a1011
--- /dev/null
+++ b/epsilon/apps/termia/commands/builtin.cpp
@@ -0,0 +1,299 @@
+// Implementations of the Phase-2 built-in commands.
+// Each returns an exit code (0 ok, non-zero otherwise).
+//
+// We avoid host-only libc features (vsnprintf, %zu, %llu) and instead use
+// Poincare::Print::CustomPrintf so the code compiles unchanged on both
+// the simulator (linux glibc) and the device (arm-none-eabi + newlib).
+
+#include <ion/timing.h>
+#include <poincare/print.h>
+#include <string.h>
+
+#include "../shell/dispatcher.h"
+#include "../shell/history.h"
+#include "../shell/scrollback.h"
+#include "../shell/shell.h"
+#include "../vfs/vfs.h"
+
+namespace Termia {
+
+// Tiny wrapper to keep call sites readable.
+static inline void printLine(Shell* shell, const char* fmt, auto&&... args) {
+  char buf[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(buf, sizeof(buf), fmt,
+                                static_cast<decltype(args)>(args)...);
+  shell->scrollback()->writeLine(buf);
+}
+
+int cmd_help(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+  shell->scrollback()->writeLine("Built-in commands:");
+  const Command* cmds = Dispatcher::commands();
+  for (int i = 0; i < Dispatcher::commandCount(); i++) {
+    // Manual right-padding because Poincare::Print has no %-8s width.
+    char padded[10];
+    size_t n = strlen(cmds[i].name);
+    if (n >= sizeof(padded)) {
+      n = sizeof(padded) - 1;
+    }
+    memcpy(padded, cmds[i].name, n);
+    for (size_t j = n; j < sizeof(padded) - 1; j++) {
+      padded[j] = ' ';
+    }
+    padded[sizeof(padded) - 1] = '\0';
+    printLine(shell, "  %s %s", padded, cmds[i].help);
+  }
+  return 0;
+}
+
+int cmd_clear(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+  shell->scrollback()->clear();
+  return 0;
+}
+
+int cmd_echo(int argc, const char* const argv[], Shell* shell) {
+  // Assemble argv[1..argc) into a single space-separated line.
+  char buf[Scrollback::k_lineCapacity];
+  size_t pos = 0;
+  for (int i = 1; i < argc && pos < sizeof(buf) - 1; i++) {
+    if (i > 1 && pos < sizeof(buf) - 1) {
+      buf[pos++] = ' ';
+    }
+    const char* a = argv[i];
+    size_t alen = strlen(a);
+    size_t copyLen = alen;
+    if (pos + copyLen >= sizeof(buf)) {
+      copyLen = sizeof(buf) - 1 - pos;
+    }
+    memcpy(buf + pos, a, copyLen);
+    pos += copyLen;
+  }
+  buf[pos] = '\0';
+  shell->scrollback()->writeLine(buf);
+  return 0;
+}
+
+int cmd_whoami(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+  shell->scrollback()->writeLine(shell->username());
+  return 0;
+}
+
+int cmd_uptime(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+  uint64_t ms = Ion::Timing::millis();
+  uint64_t totalSeconds = ms / 1000;
+  // Cast to int for Poincare::Print's %i. Even after years of uptime the
+  // per-unit totals remain in int range.
+  int seconds = static_cast<int>(totalSeconds % 60);
+  int minutes = static_cast<int>((totalSeconds / 60) % 60);
+  int hours = static_cast<int>(totalSeconds / 3600);
+  // NOTE: Poincare::Print::CustomPrintf treats `%Xs` where X is any
+  // non-zero byte as a case-modifier string specifier (for %Cs/%cs) and
+  // fetches the next arg as `char*`. A literal 's' two positions after
+  // `%i` therefore crashes with UB — e.g. `"%is"` makes the printer read
+  // an int as a string pointer. Use `%i:%i:%i` (clock-like) instead.
+  printLine(shell, "up %i:%i:%i", hours, minutes, seconds);
+  return 0;
+}
+
+int cmd_mem(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+  Scrollback* sb = shell->scrollback();
+  History* hist = shell->history();
+  printLine(shell, "scrollback: %i/%i bytes, %i/%i lines",
+            static_cast<int>(sb->usedBytes()),
+            static_cast<int>(Scrollback::k_numLines *
+                             Scrollback::k_lineCapacity),
+            sb->lineCount(), Scrollback::k_numLines);
+  printLine(shell, "history:    %i/%i entries", hist->count(),
+            History::k_numEntries);
+  return 0;
+}
+
+int cmd_history(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+  History* h = shell->history();
+  int n = h->count();
+  if (n == 0) {
+    shell->scrollback()->writeLine("(no history yet)");
+    return 0;
+  }
+  for (int i = 0; i < n; i++) {
+    printLine(shell, "%i  %s", i + 1, h->entryAtChronoIndex(i));
+  }
+  return 0;
+}
+
+// ---- filesystem commands (Phase 3) -------------------------------------
+
+static const char* writeErrorText(VFS::WriteError e) {
+  switch (e) {
+    case VFS::WriteError::None:
+      return "ok";
+    case VFS::WriteError::InvalidName:
+      return "invalid name";
+    case VFS::WriteError::OutOfSpace:
+      return "out of storage space";
+    default:
+      return "storage error";
+  }
+}
+
+static const char* renameErrorText(VFS::RenameError e) {
+  switch (e) {
+    case VFS::RenameError::None:
+      return "ok";
+    case VFS::RenameError::NotFound:
+      return "no such file";
+    case VFS::RenameError::InvalidName:
+      return "invalid name";
+    case VFS::RenameError::NameTaken:
+      return "destination already exists";
+    default:
+      return "storage error";
+  }
+}
+
+int cmd_ls(int argc, const char* const argv[], Shell* shell) {
+  const char* prefix = argc > 1 ? argv[1] : "";
+  // Accept leading `/` for pseudo-directory style (`ls /scripts`).
+  if (prefix[0] == '/') {
+    prefix++;
+  }
+  constexpr int k_listCap = 64;
+  VFS::FileInfo items[k_listCap];
+  int n = VFS::list(prefix, items, k_listCap);
+  if (n == 0) {
+    if (*prefix) {
+      printLine(shell, "ls: no files matching '%s'", prefix);
+    } else {
+      shell->scrollback()->writeLine("(no files)");
+    }
+    return 0;
+  }
+  for (int i = 0; i < n; i++) {
+    printLine(shell, "%s  %iB", items[i].fullName,
+              static_cast<int>(items[i].size));
+  }
+  printLine(shell, "-- %i files, %i/%i bytes free", n,
+            static_cast<int>(VFS::freeSpace()),
+            static_cast<int>(VFS::totalSpace()));
+  return 0;
+}
+
+int cmd_cat(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    shell->scrollback()->writeLine("cat: missing file operand");
+    return 2;
+  }
+  size_t size = 0;
+  const void* buffer = VFS::borrow(argv[1], &size);
+  if (!buffer) {
+    printLine(shell, "cat: %s: no such file", argv[1]);
+    return 1;
+  }
+  // Stream line-by-line straight from Ion::Storage's buffer — no copy.
+  const char* src = static_cast<const char*>(buffer);
+  size_t start = 0;
+  char lineBuf[Scrollback::k_lineCapacity];
+  for (size_t i = 0; i <= size; i++) {
+    bool end = (i == size) || (src[i] == '\n');
+    if (end) {
+      size_t lineLen = i - start;
+      if (lineLen >= sizeof(lineBuf)) {
+        lineLen = sizeof(lineBuf) - 1;
+      }
+      memcpy(lineBuf, src + start, lineLen);
+      lineBuf[lineLen] = '\0';
+      shell->scrollback()->writeLine(lineBuf);
+      start = i + 1;
+    }
+  }
+  return 0;
+}
+
+int cmd_rm(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    shell->scrollback()->writeLine("rm: missing file operand");
+    return 2;
+  }
+  if (!VFS::exists(argv[1])) {
+    printLine(shell, "rm: %s: no such file", argv[1]);
+    return 1;
+  }
+  if (!VFS::remove(argv[1])) {
+    printLine(shell, "rm: %s: could not remove (system record?)", argv[1]);
+    return 1;
+  }
+  return 0;
+}
+
+int cmd_cp(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 3) {
+    shell->scrollback()->writeLine("cp: usage: cp <src> <dst>");
+    return 2;
+  }
+  const char* src = argv[1];
+  const char* dst = argv[2];
+  size_t srcSize = 0;
+  const void* srcBuf = VFS::borrow(src, &srcSize);
+  if (!srcBuf) {
+    printLine(shell, "cp: %s: no such file", src);
+    return 1;
+  }
+  if (VFS::exists(dst)) {
+    printLine(shell, "cp: %s: destination already exists", dst);
+    return 1;
+  }
+  // Borrowed pointer becomes invalid after a write (storage may slide
+  // records to make room), so snapshot the bytes into a stack buffer
+  // first. Ion::Storage's total size is 42 KB; reasonable records stay
+  // well under a few KB, but be defensive.
+  constexpr size_t k_cpBufSize = 4096;
+  static uint8_t cpBuf[k_cpBufSize];
+  if (srcSize > k_cpBufSize) {
+    printLine(shell, "cp: %s: too large to copy (>%iB)", src,
+              static_cast<int>(k_cpBufSize));
+    return 1;
+  }
+  memcpy(cpBuf, srcBuf, srcSize);
+  VFS::WriteError e = VFS::write(dst, cpBuf, srcSize);
+  if (e != VFS::WriteError::None) {
+    printLine(shell, "cp: %s: %s", dst, writeErrorText(e));
+    return 1;
+  }
+  return 0;
+}
+
+int cmd_mv(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 3) {
+    shell->scrollback()->writeLine("mv: usage: mv <src> <dst>");
+    return 2;
+  }
+  VFS::RenameError e = VFS::rename(argv[1], argv[2]);
+  if (e != VFS::RenameError::None) {
+    printLine(shell, "mv: %s -> %s: %s", argv[1], argv[2],
+              renameErrorText(e));
+    return 1;
+  }
+  return 0;
+}
+
+int cmd_touch(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    shell->scrollback()->writeLine("touch: missing file operand");
+    return 2;
+  }
+  if (VFS::exists(argv[1])) {
+    // No mtime in Ion::Storage so touch on an existing file is a no-op.
+    return 0;
+  }
+  // Python editor bails on totally-empty records, so write a one-byte
+  // newline to make a meaningful empty file. Works for all listable
+  // extensions too (a one-char matrix/expression just re-parses fine).
+  const char nl = '\n';
+  VFS::WriteError e = VFS::write(argv[1], &nl, 1);
+  if (e != VFS::WriteError::None) {
+    printLine(shell, "touch: %s: %s", argv[1], writeErrorText(e));
+    return 1;
+  }
+  return 0;
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/commands/claude_cmd.cpp b/epsilon/apps/termia/commands/claude_cmd.cpp
new file mode 100644
index 0000000000..a17982cd18
--- /dev/null
+++ b/epsilon/apps/termia/commands/claude_cmd.cpp
@@ -0,0 +1,288 @@
+// cmd_claude — on-device Claude command.
+//
+// Two code paths:
+//
+//   SIMULATOR (PLATFORM_DEVICE not defined): spawn the host's `claude`
+//   CLI via popen(), stream stdout into the scrollback. This bypasses
+//   the Phase-6 USB transport gap entirely — on Linux the sim and the
+//   "host" are the same machine, so we can just exec directly. The
+//   user needs the `claude` CLI installed and authenticated (either
+//   CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token` or
+//   ANTHROPIC_API_KEY).
+//
+//   DEVICE (PLATFORM_DEVICE defined): keep the informative WIP stub.
+//   The real device has no subprocess API — it needs the USB CDC-ACM
+//   interface + the bridge daemon, which is still the Phase-6 blocker.
+//   When that lands, we swap this path to encode CLAUDE_REQUEST and
+//   write to the USB bridge handle.
+
+#include <poincare/print.h>
+#include <string.h>
+
+#include "../shell/scrollback.h"
+#include "../shell/shell.h"
+
+#if !defined(PLATFORM_DEVICE)
+// Simulator-only: we can pull in full POSIX stdio here since we build
+// against glibc. The device build's newlib doesn't reliably expose
+// popen() — which is fine, that path isn't used there.
+#include <stdio.h>
+#include <stdlib.h>
+#else
+// Device path: TMIA transport via Ion's userland USB bridge API.
+#include <ion/termia_usb.h>
+#endif
+
+namespace Termia {
+
+namespace {
+
+#if !defined(PLATFORM_DEVICE)
+
+// Escape the user's prompt for safe inclusion in a shell double-quoted
+// string: backslash-prefix `"` `\` `$` `` ` ``. Returns false if the
+// result won't fit in `dst`.
+bool escapeForShell(const char* src, char* dst, size_t cap) {
+  size_t di = 0;
+  for (size_t si = 0; src[si] != '\0'; si++) {
+    char c = src[si];
+    bool needsEscape = (c == '"' || c == '\\' || c == '$' || c == '`');
+    if (di + (needsEscape ? 2 : 1) + 1 > cap) {
+      return false;
+    }
+    if (needsEscape) {
+      dst[di++] = '\\';
+    }
+    dst[di++] = c;
+  }
+  dst[di] = '\0';
+  return true;
+}
+
+// Returns true if `claude` is in PATH on the host.
+bool claudeCliAvailable() {
+  FILE* p = popen("command -v claude >/dev/null 2>&1 && echo yes", "r");
+  if (!p) return false;
+  char buf[8] = {0};
+  fread(buf, 1, sizeof(buf) - 1, p);
+  pclose(p);
+  return strstr(buf, "yes") != nullptr;
+}
+
+int runClaudeSubprocess(const char* prompt, Shell* shell) {
+  char escaped[512];
+  if (!escapeForShell(prompt, escaped, sizeof(escaped))) {
+    shell->scrollback()->writeLine("claude: prompt too long to escape");
+    return 1;
+  }
+  // The user-selected model (defaults to "sonnet"; `model opus` switches
+  // for the rest of the session). We pass it on every call so any
+  // mid-session change takes effect immediately.
+  const char* model = shell->currentModel();
+  if (model == nullptr || *model == '\0') {
+    model = "sonnet";
+  }
+  char cmd[1024];
+  // 2>&1 merges stderr so auth/install errors reach the scrollback too.
+  snprintf(cmd, sizeof(cmd), "claude --model %s -p \"%s\" 2>&1", model,
+           escaped);
+
+  FILE* pipe = popen(cmd, "r");
+  if (!pipe) {
+    shell->scrollback()->writeLine(
+        "claude: popen() failed — is the shell available?");
+    return 1;
+  }
+
+  char line[Scrollback::k_lineCapacity];
+  while (fgets(line, sizeof(line), pipe) != nullptr) {
+    size_t n = strlen(line);
+    while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r')) {
+      line[--n] = '\0';
+    }
+    if (n > 0) {
+      shell->scrollback()->writeLine(line);
+    }
+  }
+  int status = pclose(pipe);
+  // status: -1 on wait failure; on success: high byte = exit code for
+  // shell-spawned children.
+  int exitCode = (status == -1) ? -1 : (status >> 8);
+  if (exitCode != 0) {
+    char line2[Scrollback::k_lineCapacity];
+    snprintf(line2, sizeof(line2), "claude: exit %d", exitCode);
+    shell->scrollback()->writeLine(line2);
+  }
+  return exitCode;
+}
+
+#endif  // !PLATFORM_DEVICE
+
+void assemblePrompt(int argc, const char* const argv[], char* out, size_t cap) {
+  size_t pos = 0;
+  for (int i = 1; i < argc && pos < cap - 1; i++) {
+    if (i > 1 && pos < cap - 1) {
+      out[pos++] = ' ';
+    }
+    const char* a = argv[i];
+    size_t alen = strlen(a);
+    if (pos + alen >= cap) {
+      alen = cap - 1 - pos;
+    }
+    memcpy(out + pos, a, alen);
+    pos += alen;
+  }
+  out[pos] = '\0';
+}
+
+}  // namespace
+
+int cmd_claude(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    shell->scrollback()->writeLine("claude: usage: claude <prompt...>");
+    return 2;
+  }
+
+  char prompt[Scrollback::k_lineCapacity * 4];
+  assemblePrompt(argc, argv, prompt, sizeof(prompt));
+
+#if !defined(PLATFORM_DEVICE)
+  // Simulator: talk to the real `claude` CLI on the host.
+  shell->scrollback()->writeLine("* Claude Code on NumWorks (simulator)");
+  {
+    char previewLine[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(previewLine, sizeof(previewLine),
+                                   "  prompt: \"%s\"", prompt);
+    shell->scrollback()->writeLine(previewLine);
+  }
+  if (!claudeCliAvailable()) {
+    shell->scrollback()->writeLine(
+        "claude: CLI not found. Install it first:");
+    shell->scrollback()->writeLine(
+        "  npm install -g @anthropic-ai/claude-code");
+    shell->scrollback()->writeLine(
+        "then authenticate with:  claude setup-token");
+    return 1;
+  }
+  shell->scrollback()->writeLine("  (calling claude -p ... this can take a moment)");
+  return runClaudeSubprocess(prompt, shell);
+#else
+  // Device: drive a Claude session over the USB bridge. The host must
+  // have `termia-bridge serve` running to receive the ClaudeRequest
+  // and spawn the `claude` CLI. Without the daemon, enumeration
+  // completes but SET_CONFIGURATION never flips the client ready
+  // flag — we time out and print a hint.
+  shell->scrollback()->writeLine("* Claude Code on NumWorks");
+  {
+    char previewLine[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(previewLine, sizeof(previewLine),
+                                   "  prompt: \"%s\"", prompt);
+    shell->scrollback()->writeLine(previewLine);
+  }
+  if (Ion::USB::Termia::isTetheredActive()) {
+    shell->scrollback()->writeLine("  [tether reused, sending...]");
+  } else {
+    shell->scrollback()->writeLine(
+        "  connecting to host bridge (run `termia-bridge serve`)...");
+  }
+
+  // Each chunk frame payload is a one-byte ChunkKind (0x01=TextDelta,
+  // 0x02=ToolUse, 0x03=Thinking, 0x04=Error) followed by text bytes.
+  // The sink splits the text into scrollback lines: breaks on any
+  // newline, wraps at k_lineCapacity otherwise. The first line of a
+  // chunk uses the kind marker ("● ", "… ", "! ") or plain indent
+  // for text-delta; continuation lines use a plain indent so the
+  // visual grouping stays clear.
+  auto sink = [](const uint8_t* payload, uint16_t len, void* userData) -> bool {
+    Shell* sh = static_cast<Shell*>(userData);
+    if (len == 0) return true;
+    const char* firstPrefix = "  ";
+    switch (payload[0]) {
+      case 0x02:
+        firstPrefix = "\xe2\x97\x8f ";
+        break;  // ● ToolUse
+      case 0x03:
+        firstPrefix = "\xe2\x80\xa6 ";
+        break;  // … Thinking
+      case 0x04:
+        firstPrefix = "! ";
+        break;  // Error
+      default:
+        break;
+    }
+    constexpr size_t kPrefixLen = 2;  // every prefix is two chars (UTF-8 indent)
+    const char* contPrefix = "  ";
+    uint16_t pos = 1;  // skip ChunkKind byte
+    const char* prefix = firstPrefix;
+    while (pos < len) {
+      char line[Scrollback::k_lineCapacity];
+      // Copy the prefix bytes (may be >2 when UTF-8).
+      size_t out = 0;
+      for (const char* p = prefix; *p && out < sizeof(line) - 1; p++) {
+        line[out++] = *p;
+      }
+      // Fill until newline or line cap.
+      while (pos < len && out < sizeof(line) - 1) {
+        char c = static_cast<char>(payload[pos++]);
+        if (c == '\n' || c == '\r') {
+          break;
+        }
+        line[out++] = c;
+      }
+      line[out] = '\0';
+      sh->scrollback()->writeLine(line);
+      prefix = contPrefix;
+      (void)kPrefixLen;
+    }
+    return true;
+  };
+
+  // Smuggle the user's model selection in front of the prompt using
+  // ASCII control bytes that can't appear in user text:
+  //   \x1f M : <model> \x1e <prompt>
+  // (US for "unit separator", RS for "record separator".)
+  // The bridge peels this off and passes --model <model> to the CLI.
+  // Older bridges that don't know about the prefix will still spawn
+  // claude — they'll just produce a confused reply, which is the right
+  // visible failure mode for "your bridge is out of date".
+  const char* model = shell->currentModel();
+  if (model == nullptr || *model == '\0') {
+    model = "sonnet";
+  }
+  // Build "\x1f M : <model> \x1e <prompt>" by hand — newlib on the
+  // device doesn't pull in snprintf, and Poincare::Print::CustomPrintf
+  // doesn't preserve raw control bytes safely. A simple memcpy chain is
+  // cheapest and totally portable.
+  char framedPrompt[Scrollback::k_lineCapacity * 4 + 32];
+  size_t fp = 0;
+  framedPrompt[fp++] = '\x1f';
+  framedPrompt[fp++] = 'M';
+  framedPrompt[fp++] = ':';
+  size_t mlen = strlen(model);
+  if (fp + mlen + 2 < sizeof(framedPrompt)) {
+    memcpy(framedPrompt + fp, model, mlen);
+    fp += mlen;
+    framedPrompt[fp++] = '\x1e';
+    size_t plen = strlen(prompt);
+    if (plen > sizeof(framedPrompt) - fp - 1) {
+      plen = sizeof(framedPrompt) - fp - 1;
+    }
+    memcpy(framedPrompt + fp, prompt, plen);
+    fp += plen;
+  }
+  framedPrompt[fp] = '\0';
+
+  uint32_t chunks =
+      Ion::USB::Termia::runClaudeProbe(framedPrompt, 30000, sink, shell);
+  if (chunks == 0) {
+    shell->scrollback()->writeLine("claude: no response from bridge");
+    shell->scrollback()->writeLine(
+        "        is `termia-bridge serve` running on the host?");
+    return 1;
+  }
+  shell->scrollback()->writeLine("  (stream complete)");
+  return 0;
+#endif
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/commands/fastfetch.cpp b/epsilon/apps/termia/commands/fastfetch.cpp
new file mode 100644
index 0000000000..352439d05d
--- /dev/null
+++ b/epsilon/apps/termia/commands/fastfetch.cpp
@@ -0,0 +1,155 @@
+// cmd_fastfetch — NumWorks-themed neofetch for Termia.
+//
+// Prints a small ASCII logo on the left and a column of system-info
+// fields on the right, one line at a time into the scrollback. Matches
+// the spirit of TERMIA.md §5 Phase 5; the exact glyphs used for the
+// "N" silhouette are ASCII-only because Epsilon's SmallFont doesn't
+// ship with Unicode block-drawing characters.
+
+#include <ion.h>
+#include <ion/battery.h>
+#include <ion/display.h>
+#include <ion/storage/file_system.h>
+#include <ion/timing.h>
+#include <poincare/print.h>
+#include <string.h>
+
+#include "../shell/scrollback.h"
+#include "../shell/shell.h"
+#include "../vfs/vfs.h"
+
+namespace Termia {
+
+namespace {
+
+// Hand-drawn 8-row ASCII "N". 13 cells wide so the right column has
+// comfortable separation at 45 cols × 14 rows. Paired with an info
+// string for each row in kLogoRows/info assembly below.
+constexpr const char* k_logo[8] = {
+    "    _____    ",
+    "   |N    |   ",
+    "   |NN   |   ",
+    "   |N N  |   ",
+    "   |N  N |   ",
+    "   |N   N|   ",
+    "   |_____|   ",
+    "             ",
+};
+
+const char* batteryText(char* buf, size_t cap) {
+  const char* levelStr = "?";
+  switch (Ion::Battery::level()) {
+    case Ion::Battery::Charge::EMPTY:
+      levelStr = "empty";
+      break;
+    case Ion::Battery::Charge::LOW:
+      levelStr = "~20%";
+      break;
+    case Ion::Battery::Charge::P40:
+      levelStr = "~40%";
+      break;
+    case Ion::Battery::Charge::P60:
+      levelStr = "~60%";
+      break;
+    case Ion::Battery::Charge::P80:
+      levelStr = "~80%";
+      break;
+    case Ion::Battery::Charge::FULL:
+      levelStr = "full";
+      break;
+  }
+  Poincare::Print::CustomPrintf(
+      buf, cap, "%s%s", levelStr,
+      Ion::Battery::isCharging() ? " (charging)" : "");
+  return buf;
+}
+
+int countStoredFiles() {
+  // Iterate the VFS extension list — same union we list in `ls`.
+  int total = 0;
+  Ion::Storage::FileSystem* fs = Ion::Storage::FileSystem::sharedFileSystem;
+  for (int i = 0; i < VFS::k_numListableExtensions; i++) {
+    total += fs->numberOfRecordsWithExtension(VFS::k_listableExtensions[i]);
+  }
+  return total;
+}
+
+void printPair(Shell* shell, const char* logo, const char* info) {
+  char line[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(line, sizeof(line), "%s %s", logo, info);
+  shell->scrollback()->writeLine(line);
+}
+
+}  // namespace
+
+int cmd_fastfetch(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+  char info0[64];
+  Poincare::Print::CustomPrintf(info0, sizeof(info0), "%s@numworks",
+                                 shell->username());
+
+  char info2[64];
+  Poincare::Print::CustomPrintf(info2, sizeof(info2),
+                                 "OS:      Termia 0.1 (custom userland)");
+
+  char info3[64];
+  const char* pcb = Ion::pcbVersion();
+  Poincare::Print::CustomPrintf(info3, sizeof(info3),
+                                 "Host:    NumWorks N0120 (rev %s)",
+                                 pcb ? pcb : "?");
+
+  char info4[64];
+  const char* kver = Ion::softwareVersion();
+  Poincare::Print::CustomPrintf(info4, sizeof(info4),
+                                 "Kernel:  Epsilon %s", kver ? kver : "?");
+
+  const char* info5 = "MCU:     STM32H7B0 @ 280 MHz";
+
+  char info6[64];
+  Poincare::Print::CustomPrintf(info6, sizeof(info6),
+                                 "Display: %ix%i RGB565",
+                                 Ion::Display::Width, Ion::Display::Height);
+
+  char info7[64];
+  char battBuf[40];
+  Poincare::Print::CustomPrintf(info7, sizeof(info7), "Battery: %s",
+                                 batteryText(battBuf, sizeof(battBuf)));
+
+  // Pair the logo rows with info lines (8 logo rows → need 8 info rows).
+  const char* infoLines[8] = {
+      info0,
+      "-----------------",
+      info2,
+      info3,
+      info4,
+      info5,
+      info6,
+      info7,
+  };
+
+  for (int i = 0; i < 8; i++) {
+    printPair(shell, k_logo[i], infoLines[i]);
+  }
+
+  // Extra info rows beneath the logo.
+  uint64_t ms = Ion::Timing::millis();
+  int seconds = static_cast<int>((ms / 1000) % 60);
+  int minutes = static_cast<int>((ms / 60000) % 60);
+  int hours = static_cast<int>(ms / 3600000);
+  char uptimeLine[Scrollback::k_lineCapacity];
+  // `%is` would trigger Poincare::Print::CustomPrintf's `%Xs` case-modifier
+  // branch and read `seconds` as a `char*` — classic UB. Use `%i:%i:%i`.
+  Poincare::Print::CustomPrintf(uptimeLine, sizeof(uptimeLine),
+                                 "              Uptime:  %i:%i:%i",
+                                 hours, minutes, seconds);
+  shell->scrollback()->writeLine(uptimeLine);
+
+  char scriptsLine[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(scriptsLine, sizeof(scriptsLine),
+                                 "              Scripts: %i files",
+                                 countStoredFiles());
+  shell->scrollback()->writeLine(scriptsLine);
+
+  return 0;
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/commands/ping.cpp b/epsilon/apps/termia/commands/ping.cpp
new file mode 100644
index 0000000000..5ae6ce97af
--- /dev/null
+++ b/epsilon/apps/termia/commands/ping.cpp
@@ -0,0 +1,75 @@
+// cmd_ping — validates the TMIA codec end-to-end on-device.
+//
+// TERMIA.md §5 Phase 6's final goal is a USB round-trip to the host
+// bridge. That transport wiring (adding a CDC-ACM class alongside
+// Epsilon's DFU interface, exposing stream endpoints to userland)
+// needs supervised kernel work. Until then, `ping` self-tests the
+// codec: encode a PING, decode it back, verify magic + CRC, then
+// report the in-memory round-trip time.
+//
+// When the real USB transport lands, this command will acquire the
+// bridge handle from the App, write the encoded frame, and wait for a
+// PONG. The codec path is already validated by this stub.
+
+#include <ion/timing.h>
+#include <poincare/print.h>
+#include <string.h>
+
+#include "../shell/scrollback.h"
+#include "../shell/shell.h"
+#include "../tmia/tmia.h"
+
+namespace Termia {
+
+int cmd_ping(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+  using namespace TMIA;
+
+  const uint64_t t0 = Ion::Timing::millis();
+
+  uint8_t frame[kMaxFrame];
+  const uint8_t nonce[4] = {0x42, 0x43, 0x44, 0x45};
+  EncodeError encErr = EncodeError::None;
+  size_t n = encode(FrameType::Ping, nonce, sizeof(nonce), frame,
+                    sizeof(frame), &encErr);
+  if (n == 0) {
+    char msg[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(msg, sizeof(msg),
+                                   "ping: encode failed (err=%i)",
+                                   static_cast<int>(encErr));
+    shell->scrollback()->writeLine(msg);
+    return 1;
+  }
+
+  FrameType decType = FrameType::Error;
+  size_t decLen = 0;
+  DecodeError decErr = DecodeError::None;
+  const uint8_t* payload = decode(frame, n, &decType, &decLen, &decErr);
+  if (!payload) {
+    char msg[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(msg, sizeof(msg),
+                                   "ping: decode failed (err=%i)",
+                                   static_cast<int>(decErr));
+    shell->scrollback()->writeLine(msg);
+    return 1;
+  }
+
+  const uint64_t t1 = Ion::Timing::millis();
+  const int roundTripMs = static_cast<int>(t1 - t0);
+
+  if (decType != FrameType::Ping || decLen != sizeof(nonce) ||
+      memcmp(payload, nonce, sizeof(nonce)) != 0) {
+    shell->scrollback()->writeLine("ping: round-trip payload mismatch");
+    return 1;
+  }
+
+  char line[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(line, sizeof(line),
+                                 "pong (codec rtt=%ims, crc ok)",
+                                 roundTripMs);
+  shell->scrollback()->writeLine(line);
+  shell->scrollback()->writeLine(
+      "note: USB transport to host bridge not yet wired (§6 WIP)");
+  return 0;
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/commands/polish.cpp b/epsilon/apps/termia/commands/polish.cpp
new file mode 100644
index 0000000000..9b0217c4a5
--- /dev/null
+++ b/epsilon/apps/termia/commands/polish.cpp
@@ -0,0 +1,241 @@
+// Phase-9 polish commands: man, set, matrix.
+//
+// Kept in one file because each is small and they share no state.
+// Larger "apps-inside-an-app" demos (snake, donut, startup splash) are
+// not wired in this commit — the spec marks polish as subjective.
+
+#include <ion.h>  // for Ion::random()
+#include <poincare/print.h>
+#include <string.h>
+
+#include "../shell/dispatcher.h"
+#include "../shell/scrollback.h"
+#include "../shell/shell.h"
+
+namespace Termia {
+
+// man <cmd> — print the help for a single command.
+int cmd_man(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    shell->scrollback()->writeLine("man: usage: man <command>");
+    return 2;
+  }
+  const Command* cmd = Dispatcher::find(argv[1]);
+  if (!cmd) {
+    char line[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(line, sizeof(line), "man: no entry for %s",
+                                   argv[1]);
+    shell->scrollback()->writeLine(line);
+    return 1;
+  }
+  char head[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(head, sizeof(head), "NAME: %s", cmd->name);
+  shell->scrollback()->writeLine(head);
+  char desc[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(desc, sizeof(desc), "SUMMARY: %s", cmd->help);
+  shell->scrollback()->writeLine(desc);
+  return 0;
+}
+
+// set theme <name> / set user <name> — mutable configuration.
+int cmd_set(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 3) {
+    shell->scrollback()->writeLine("set: usage: set <key> <value>");
+    shell->scrollback()->writeLine(
+        "     keys: theme  (default|light|matrix|amber|solarized|dark)");
+    shell->scrollback()->writeLine("           zoom   (small|large|0|1)");
+    return 2;
+  }
+  if (strcmp(argv[1], "zoom") == 0) {
+    const char* v = argv[2];
+    int z = -1;
+    if (strcmp(v, "small") == 0 || strcmp(v, "0") == 0) z = 0;
+    if (strcmp(v, "large") == 0 || strcmp(v, "1") == 0) z = 1;
+    if (z < 0) {
+      char line[Scrollback::k_lineCapacity];
+      Poincare::Print::CustomPrintf(line, sizeof(line),
+                                     "set zoom: unknown level '%s'", v);
+      shell->scrollback()->writeLine(line);
+      return 1;
+    }
+    shell->setZoomLevel(z);
+    shell->scrollback()->writeLine(z == 0 ? "zoom: small" : "zoom: large");
+    return 0;
+  }
+  const char* key = argv[1];
+  const char* value = argv[2];
+  if (strcmp(key, "theme") == 0) {
+    bool ok = false;
+    ThemeId t = themeFromName(value, &ok);
+    if (!ok) {
+      char line[Scrollback::k_lineCapacity];
+      Poincare::Print::CustomPrintf(line, sizeof(line),
+                                     "set theme: unknown theme '%s'", value);
+      shell->scrollback()->writeLine(line);
+      return 1;
+    }
+    shell->setTheme(t);
+    char line[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(line, sizeof(line), "theme: %s",
+                                   themeName(t));
+    shell->scrollback()->writeLine(line);
+    return 0;
+  }
+  char line[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(line, sizeof(line), "set: unknown key '%s'",
+                                 key);
+  shell->scrollback()->writeLine(line);
+  return 1;
+}
+
+// matrix — dump a fake Matrix-style burst into the scrollback. Not a
+// real animation (our command model is one-shot) but the static effect
+// still reads well on-screen.
+int cmd_matrix(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+  // Auto-switch to the matrix palette for the duration of the dump.
+  ThemeId previous = shell->theme();
+  shell->setTheme(ThemeId::Matrix);
+
+  constexpr int k_cols = 42;
+  constexpr int k_rows = 14;
+  for (int r = 0; r < k_rows; r++) {
+    char line[Scrollback::k_lineCapacity];
+    int pos = 0;
+    for (int c = 0; c < k_cols && pos < static_cast<int>(sizeof(line)) - 1;
+         c++) {
+      uint32_t rand = Ion::random();
+      // Sparse glyph distribution: most cells blank, occasional katakana
+      // placeholder (we don't have Unicode glyphs, so use ASCII).
+      uint32_t mod = rand % 6;
+      char ch = ' ';
+      if (mod == 0) {
+        ch = '0' + (rand % 10);
+      } else if (mod == 1) {
+        ch = 'A' + (rand % 26);
+      } else if (mod == 2) {
+        ch = '.';
+      }
+      line[pos++] = ch;
+    }
+    line[pos] = '\0';
+    shell->scrollback()->writeLine(line);
+  }
+  shell->scrollback()->writeLine("(use `set theme default` to switch back)");
+  // Keep the matrix theme active so the scrollback we just dumped looks
+  // right. User can opt out.
+  (void)previous;
+  return 0;
+}
+
+// theme [name] — print or set the active theme. With no argument, prints
+// the current theme and the list of valid names. With one argument,
+// switches. Lighter wrapper around `set theme <name>` so users can just
+// type `theme light`.
+int cmd_theme(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    char line[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(line, sizeof(line), "theme: %s",
+                                   themeName(shell->theme()));
+    shell->scrollback()->writeLine(line);
+    shell->scrollback()->writeLine(
+        "  available: default light matrix amber solarized");
+    shell->scrollback()->writeLine("  Shift+Power cycles themes live.");
+    return 0;
+  }
+  bool ok = false;
+  ThemeId t = themeFromName(argv[1], &ok);
+  if (!ok) {
+    char line[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(line, sizeof(line),
+                                   "theme: unknown theme '%s'", argv[1]);
+    shell->scrollback()->writeLine(line);
+    return 1;
+  }
+  shell->setTheme(t);
+  return 0;
+}
+
+// zoom [in|out|small|large|toggle] — adjust the on-screen font.
+int cmd_zoom(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    shell->scrollback()->writeLine(
+        shell->zoomLevel() == 0 ? "zoom: small (7x14)"
+                                : "zoom: large (10x18)");
+    shell->scrollback()->writeLine("  zoom in|out|small|large|toggle");
+    shell->scrollback()->writeLine("  Shift+> zoom in, Shift+< zoom out.");
+    return 0;
+  }
+  const char* v = argv[1];
+  if (strcmp(v, "in") == 0 || strcmp(v, "large") == 0 ||
+      strcmp(v, "1") == 0) {
+    shell->setZoomLevel(1);
+  } else if (strcmp(v, "out") == 0 || strcmp(v, "small") == 0 ||
+             strcmp(v, "0") == 0) {
+    shell->setZoomLevel(0);
+  } else if (strcmp(v, "toggle") == 0) {
+    shell->setZoomLevel(shell->zoomLevel() == 0 ? 1 : 0);
+  } else {
+    char line[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(line, sizeof(line),
+                                   "zoom: unknown level '%s'", v);
+    shell->scrollback()->writeLine(line);
+    return 1;
+  }
+  return 0;
+}
+
+// model [name] — print or switch the Claude model used by `claude`.
+// With no arg, prints the current model + the known shortcuts. With one
+// arg, switches: `model opus`, `model sonnet`, `model haiku`, or any
+// full ID like `model claude-opus-4-7`. The choice is per-session and
+// flows to both the simulator (popen `--model <name>`) and the device
+// (header `\x1fM:<name>\x1e<prompt>` — peeled off by the bridge).
+int cmd_model(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    char line[Scrollback::k_lineCapacity];
+    const char* cur = shell->currentModel();
+    Poincare::Print::CustomPrintf(line, sizeof(line), "model: %s",
+                                   (cur && *cur) ? cur : "(default)");
+    shell->scrollback()->writeLine(line);
+    shell->scrollback()->writeLine(
+        "  shortcuts: sonnet | opus | haiku");
+    shell->scrollback()->writeLine(
+        "  also accepts a full ID, e.g. claude-opus-4-7");
+    shell->scrollback()->writeLine(
+        "  applies to subsequent `claude` calls.");
+    return 0;
+  }
+  // Reject anything that looks dangerous as a CLI argument. The popen
+  // path quote-escapes user prompts but the model name is pasted in raw,
+  // so we tighten it to [a-z0-9.-] — covers every published model alias
+  // and the dotted-version IDs without opening a shell-injection door.
+  const char* name = argv[1];
+  for (const char* p = name; *p; p++) {
+    char c = *p;
+    bool ok = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+              c == '-' || c == '.' || c == '_';
+    if (!ok) {
+      shell->scrollback()->writeLine(
+          "model: invalid name (use lowercase a-z, digits, '-', '.')");
+      return 1;
+    }
+  }
+  shell->setCurrentModel(name);
+  char line[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(line, sizeof(line), "model: %s", name);
+  shell->scrollback()->writeLine(line);
+  return 0;
+}
+
+// light / dark — one-keyword shortcuts for the two most-used themes.
+int cmd_light(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+  shell->setTheme(ThemeId::Light);
+  return 0;
+}
+
+int cmd_dark(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+  shell->setTheme(ThemeId::Default);
+  return 0;
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/commands/run_python.cpp b/epsilon/apps/termia/commands/run_python.cpp
new file mode 100644
index 0000000000..4868196121
--- /dev/null
+++ b/epsilon/apps/termia/commands/run_python.cpp
@@ -0,0 +1,172 @@
+// cmd_run — executes a Python script via Epsilon's embedded MicroPython.
+//
+// TERMIA.md §5 Phase 4: `run <file.py>` streams stdout into the shell's
+// scrollback, prints any traceback on error. Interrupt-handling (Back =
+// Ctrl+C) is deferred to Phase 9 polish; for now an infinite loop has to
+// be escaped via Home, which will tear MicroPython down via
+// willBecomeInactive.
+
+#include <escher/container.h>
+#include <poincare/print.h>
+#include <python/port/port.h>
+#include <string.h>
+
+#include "../app.h"
+#include "../shell/scrollback.h"
+#include "../shell/shell.h"
+#include "../vfs/vfs.h"
+
+namespace Termia {
+
+namespace {
+
+// Bridge MicroPython stdout → our Scrollback. MicroPython writes stdout
+// in arbitrary chunks (each `print` call typically emits the body and
+// then the newline separately), so we buffer until we see a newline or
+// the line-slot fills up.
+class PrintHook : public MicroPython::ExecutionEnvironment {
+ public:
+  explicit PrintHook(Shell* shell) : m_shell(shell), m_pos(0) {
+    m_buf[0] = '\0';
+  }
+
+  void printText(const char* text, size_t length) override {
+    for (size_t i = 0; i < length; i++) {
+      char c = text[i];
+      if (c == '\n' || m_pos + 1 >= sizeof(m_buf)) {
+        m_buf[m_pos] = '\0';
+        m_shell->scrollback()->writeLine(m_buf);
+        m_pos = 0;
+        if (c == '\n') {
+          continue;
+        }
+      }
+      m_buf[m_pos++] = c;
+    }
+  }
+
+  // Flush any half-written last line (no trailing newline).
+  void flush() {
+    if (m_pos > 0) {
+      m_buf[m_pos] = '\0';
+      m_shell->scrollback()->writeLine(m_buf);
+      m_pos = 0;
+    }
+  }
+
+ private:
+  Shell* m_shell;
+  char m_buf[Scrollback::k_lineCapacity];
+  size_t m_pos;
+};
+
+// Make our VFS contents visible to MicroPython's `import` machinery.
+// Names arrive without the `.py`; Epsilon stores `.py` records whose
+// payload is [Status byte][NUL-terminated source].
+class ScriptProvider : public MicroPython::ScriptProvider {
+ public:
+  const char* contentOfScript(const char* name,
+                              bool /*markAsFetched*/) const override {
+    if (!name) {
+      return nullptr;
+    }
+    // Try `name.py`; fall back to `name` (in case the caller already
+    // included the extension).
+    char fullName[40];
+    Poincare::Print::CustomPrintf(fullName, sizeof(fullName), "%s.py", name);
+    size_t size = 0;
+    const void* buf = VFS::borrow(fullName, &size);
+    if (!buf) {
+      buf = VFS::borrow(name, &size);
+    }
+    if (!buf || size < 2) {
+      // Record doesn't exist or has no content past the Status byte.
+      return nullptr;
+    }
+    // Skip the 1-byte Status prefix that Code::Script uses.
+    return static_cast<const char*>(buf) + 1;
+  }
+};
+
+}  // namespace
+
+int cmd_run(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    shell->scrollback()->writeLine("run: usage: run <file.py>");
+    return 2;
+  }
+
+  // Accept both `foo` and `foo.py`; enforce .py in the lookup.
+  const char* arg = argv[1];
+  char fullName[40];
+  size_t argLen = strlen(arg);
+  bool hasExt = argLen >= 3 && strcmp(arg + argLen - 3, ".py") == 0;
+  if (hasExt) {
+    if (argLen + 1 > sizeof(fullName)) {
+      shell->scrollback()->writeLine("run: name too long");
+      return 2;
+    }
+    memcpy(fullName, arg, argLen + 1);
+  } else {
+    int n = Poincare::Print::CustomPrintf(fullName, sizeof(fullName),
+                                           "%s.py", arg);
+    if (n < 0 || n >= static_cast<int>(sizeof(fullName))) {
+      shell->scrollback()->writeLine("run: name too long");
+      return 2;
+    }
+  }
+
+  // Read the record. Python scripts are stored as [Status][NUL-term src].
+  size_t recSize = 0;
+  const void* recBuf = VFS::borrow(fullName, &recSize);
+  if (!recBuf) {
+    char err[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(err, sizeof(err), "run: %s: no such file",
+                                   fullName);
+    shell->scrollback()->writeLine(err);
+    return 1;
+  }
+  if (recSize < 2) {
+    char err[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(err, sizeof(err), "run: %s: empty script",
+                                   fullName);
+    shell->scrollback()->writeLine(err);
+    return 1;
+  }
+  // Copy content out of the storage buffer. Any subsequent
+  // MicroPython::init / runCode call may slide records, invalidating
+  // the borrowed pointer — so stash the source bytes into the App's
+  // dedicated scratch buffer (which lives in the union-backed .bss
+  // $app_buffer slot, so no .bss growth).
+  size_t srcCap = App::app()->scriptSourceCap();
+  char* srcBuf = App::app()->scriptSourceBuf();
+  size_t contentSize = recSize - 1;  // skip Status byte
+  if (contentSize > srcCap) {
+    char err[Scrollback::k_lineCapacity];
+    Poincare::Print::CustomPrintf(err, sizeof(err),
+                                   "run: %s: script too large (>%iB)",
+                                   fullName, static_cast<int>(srcCap));
+    shell->scrollback()->writeLine(err);
+    return 1;
+  }
+  memcpy(srcBuf, static_cast<const char*>(recBuf) + 1, contentSize);
+  srcBuf[contentSize] = '\0';
+
+  // Init MicroPython lazily + register our import provider.
+  App::app()->ensurePython();
+  static ScriptProvider s_provider;
+  MicroPython::registerScriptProvider(&s_provider);
+
+  PrintHook hook(shell);
+  bool ok = hook.runCode(srcBuf);
+  hook.flush();
+
+  if (!ok) {
+    // Traceback already printed to `hook` by MicroPython's exception
+    // handler. Just surface a non-zero exit code.
+    return 1;
+  }
+  return 0;
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/commands/sync_cmd.cpp b/epsilon/apps/termia/commands/sync_cmd.cpp
new file mode 100644
index 0000000000..029d076ef5
--- /dev/null
+++ b/epsilon/apps/termia/commands/sync_cmd.cpp
@@ -0,0 +1,88 @@
+// cmd_sync / cmd_push / cmd_pull — file-sync over TMIA.
+//
+// TERMIA.md §5 Phase 8: bidirectional mirror of the calculator VFS
+// with ~/.termia/sync on the host. The host-side list state machine
+// lives in bridge/crates/termia-bridge/src/sync.rs; this file drives
+// the calc-side protocol through Ion::USB::Termia helpers.
+//
+// Current coverage:
+//   sync         — list the host's sync dir.
+//   push / pull  — still stubs (next session).
+
+#include <ion/termia_usb.h>
+#include <poincare/print.h>
+#include <string.h>
+
+#include "../shell/scrollback.h"
+#include "../shell/shell.h"
+
+namespace Termia {
+
+namespace {
+
+struct SyncListCtx {
+  Shell* shell;
+  uint32_t shown;
+};
+
+bool onEntry(const char* name, uint32_t size, uint32_t mtimeUnix,
+             void* userData) {
+  (void)mtimeUnix;
+  SyncListCtx* ctx = static_cast<SyncListCtx*>(userData);
+  char line[Scrollback::k_lineCapacity];
+  /* Right-pad file size cheaply: "%-32s %i B". The scrollback is
+   * 60-ish char so names longer than ~30 will still fit even with
+   * the size suffix. */
+  Poincare::Print::CustomPrintf(line, sizeof(line), "  %s  (%i B)", name,
+                                static_cast<int>(size));
+  ctx->shell->scrollback()->writeLine(line);
+  ctx->shown++;
+  return true;
+}
+
+}  // namespace
+
+int cmd_sync(int /*argc*/, const char* const /*argv*/[], Shell* shell) {
+#if !defined(PLATFORM_DEVICE)
+  shell->scrollback()->writeLine(
+      "sync: device-only (simulator has no USB controller)");
+  return 1;
+#else
+  shell->scrollback()->writeLine("sync: listing ~/.termia/sync on host...");
+  SyncListCtx ctx{shell, 0};
+  uint32_t entries = Ion::USB::Termia::syncList(onEntry, &ctx, 15000);
+  if (entries == 0 && ctx.shown == 0) {
+    shell->scrollback()->writeLine(
+        "sync: no response (is `termia-bridge serve` running?)");
+    return 1;
+  }
+  char footer[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(footer, sizeof(footer),
+                                "sync: %i file(s) on host",
+                                static_cast<int>(ctx.shown));
+  shell->scrollback()->writeLine(footer);
+  return 0;
+#endif
+}
+
+int cmd_push(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    shell->scrollback()->writeLine("push: usage: push <file>");
+    return 2;
+  }
+  shell->scrollback()->writeLine(
+      "push: not implemented yet — coming in the next session.");
+  return 1;
+}
+
+int cmd_pull(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    shell->scrollback()->writeLine("pull: usage: pull <file>");
+    return 2;
+  }
+  shell->scrollback()->writeLine(
+      "pull: not implemented yet — coming in the next session.");
+  return 1;
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/commands/tether_cmd.cpp b/epsilon/apps/termia/commands/tether_cmd.cpp
new file mode 100644
index 0000000000..67cdae85ab
--- /dev/null
+++ b/epsilon/apps/termia/commands/tether_cmd.cpp
@@ -0,0 +1,116 @@
+// cmd_tether — opt-in USB enumeration probe for Termia's CDC-ACM
+// bridge. Runs a single 3-second blocking window during which the
+// calculator advertises VID 0x0483 / PID 0xA292 as a CDC-ACM composite
+// device. The host can verify enumeration with `lsusb -d 0483:a292`
+// and watch `dmesg` for cdc_acm binding.
+//
+// This is a diagnostic only — bulk-endpoint traffic (actual TMIA
+// packet I/O) is not implemented. Epsilon's USB stack currently only
+// dispatches endpoint 0 (control); a future session extends the stack
+// for bulk endpoints and wires `ping` / `claude` / `sync` onto them.
+//
+// On the simulator there is no USB controller; the command reports so.
+
+#include <ion/termia_usb.h>
+#include <poincare/print.h>
+#include <string.h>
+
+// NB: ion/termia_usb.h provides the persistent-tether API
+// (isTetheredActive, closeTether) alongside the probe entry points.
+
+#include "../shell/scrollback.h"
+#include "../shell/shell.h"
+
+namespace Termia {
+
+namespace {
+
+void writeLine(Shell* shell, const char* s) {
+  shell->scrollback()->writeLine(s);
+}
+
+int runEnumProbe(Shell* shell) {
+  writeLine(shell, "tether: advertising CDC-ACM for 3s ...");
+  writeLine(shell, "        host: lsusb -d 0483:a292");
+  uint32_t iterations = Ion::USB::Termia::runEnumerationProbe(3000);
+  if (iterations == 0) {
+    writeLine(shell, "tether: unavailable (simulator build, no USB)");
+    return 1;
+  }
+  char line[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(line, sizeof(line),
+                                "tether: done (%i poll iterations)",
+                                static_cast<int>(iterations));
+  writeLine(shell, line);
+  return 0;
+}
+
+int runEchoProbe(Shell* shell) {
+  writeLine(shell, "tether: bulk echo for 10s ...");
+  writeLine(shell, "        host: stty -F /dev/ttyACMx raw -echo");
+  writeLine(shell, "              echo hello > /dev/ttyACMx");
+  writeLine(shell, "              cat /dev/ttyACMx");
+  uint32_t iterations = Ion::USB::Termia::runEchoProbe(10000);
+  if (iterations == 0) {
+    writeLine(shell, "tether: unavailable (simulator build, no USB)");
+    return 1;
+  }
+  char line[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(line, sizeof(line),
+                                "tether: echo done (%i iterations)",
+                                static_cast<int>(iterations));
+  writeLine(shell, line);
+  return 0;
+}
+
+int runTmiaServerProbe(Shell* shell) {
+  writeLine(shell, "tether: TMIA server for 15s ...");
+  writeLine(shell, "        host: termia-bridge ping");
+  writeLine(shell, "              (calc answers Ping with Pong)");
+  uint32_t iterations = Ion::USB::Termia::runTmiaServerProbe(15000);
+  if (iterations == 0) {
+    writeLine(shell, "tether: unavailable (simulator build, no USB)");
+    return 1;
+  }
+  char line[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(line, sizeof(line),
+                                "tether: tmia done (%i iterations)",
+                                static_cast<int>(iterations));
+  writeLine(shell, line);
+  return 0;
+}
+
+}  // namespace
+
+int cmd_tether(int argc, const char* const argv[], Shell* shell) {
+  const char* sub = (argc >= 2) ? argv[1] : "status";
+  if (strcmp(sub, "status") == 0) {
+    writeLine(shell, Ion::USB::Termia::isTetheredActive()
+                         ? "tether: active (bridge is connected)"
+                         : "tether: idle");
+    return 0;
+  }
+  if (strcmp(sub, "close") == 0) {
+    Ion::USB::Termia::closeTether();
+    writeLine(shell, "tether: closed");
+    return 0;
+  }
+  if (strcmp(sub, "enum") == 0) {
+    return runEnumProbe(shell);
+  }
+  if (strcmp(sub, "echo") == 0) {
+    return runEchoProbe(shell);
+  }
+  if (strcmp(sub, "tmia") == 0) {
+    return runTmiaServerProbe(shell);
+  }
+  writeLine(shell, "tether: usage: tether [status|close|enum|echo|tmia]");
+  writeLine(shell, "        status — is the bridge currently connected?");
+  writeLine(shell, "        close  — drop the connection (slow next claude)");
+  writeLine(shell, "        enum   — 3s CDC-ACM enumeration probe");
+  writeLine(shell, "        echo   — 10s bulk loopback probe");
+  writeLine(shell, "        tmia   — 15s TMIA ping-server for termia-bridge");
+  return 2;
+}
+
+}  // namespace Termia
diff --git a/epsilon/apps/termia/commands/visual.cpp b/epsilon/apps/termia/commands/visual.cpp
new file mode 100644
index 0000000000..1c07864a94
--- /dev/null
+++ b/epsilon/apps/termia/commands/visual.cpp
@@ -0,0 +1,273 @@
+// visual.cpp — small commands that turn the scrollback into a canvas:
+//
+//   viz [--bar|--line] <numbers...>
+//     Draws a single-line sparkline by default, or a multi-row bar
+//     chart with --bar. Sparkline uses the eight Unicode block-eighths
+//     glyphs (▁▂▃▄▅▆▇█); the textfx translator collapses those to ASCII
+//     stubs on the device, so the visual still reads as a relative
+//     trend even on the calculator's font. With --bar the chart is
+//     full-width ASCII so it always renders sharply.
+//
+//   box <title> <text...>
+//     Frames `text` in an ASCII box with a title bar. Useful for
+//     highlighting Claude responses or emphasising results — a small
+//     amount of structure makes scanning the scrollback dramatically
+//     easier.
+
+#include <poincare/print.h>
+#include <string.h>
+
+#include "../shell/scrollback.h"
+#include "../shell/shell.h"
+
+namespace Termia {
+
+namespace {
+
+// Cheap-and-portable signed integer parser — newlib on the device
+// doesn't pull in strtol/strtod here, and Poincare doesn't ship a
+// public string-to-number helper. Decimals are accepted in the source
+// (parsed as truncated integer), so `viz 1.4 2.7 3.1` still works.
+// Returns true on success and writes the integer into *out.
+bool parseInt(const char* s, int* out) {
+  if (s == nullptr || *s == '\0') return false;
+  int sign = 1;
+  if (*s == '-') {
+    sign = -1;
+    s++;
+  } else if (*s == '+') {
+    s++;
+  }
+  bool sawDigit = false;
+  long long v = 0;
+  while (*s) {
+    char c = *s++;
+    if (c >= '0' && c <= '9') {
+      v = v * 10 + (c - '0');
+      sawDigit = true;
+      continue;
+    }
+    if (c == '.') {
+      // Skip any fractional digits.
+      while (*s >= '0' && *s <= '9') s++;
+      break;
+    }
+    return false;
+  }
+  if (!sawDigit) return false;
+  *out = static_cast<int>(sign * v);
+  return true;
+}
+
+// Parse argv[start..argc) as ints. Writes up to `cap` values into `out`
+// and returns the count actually parsed. Stops at the first argument
+// that fails to parse and prints a complaint to scrollback.
+int parseNumbers(int argc, const char* const argv[], int start, int* out,
+                  int cap, Shell* shell) {
+  int n = 0;
+  for (int i = start; i < argc && n < cap; i++) {
+    int v;
+    if (!parseInt(argv[i], &v)) {
+      char line[Scrollback::k_lineCapacity];
+      Poincare::Print::CustomPrintf(line, sizeof(line),
+                                     "viz: not a number: %s", argv[i]);
+      shell->scrollback()->writeLine(line);
+      return n;
+    }
+    out[n++] = v;
+  }
+  return n;
+}
+
+// Sparkline: emit a row of ramp characters proportional to each value.
+// The textfx translator preserves these printable bytes verbatim, so
+// the visual reads identically on sim and device.
+void drawSparkline(const int* xs, int n, Shell* shell) {
+  if (n == 0) {
+    shell->scrollback()->writeLine("viz: no data");
+    return;
+  }
+  int lo = xs[0], hi = xs[0];
+  for (int i = 1; i < n; i++) {
+    if (xs[i] < lo) lo = xs[i];
+    if (xs[i] > hi) hi = xs[i];
+  }
+  // 8 ASCII gradient steps: . , : ; o O 8 #
+  static const char k_steps[8] = {'.', ',', ':', ';', 'o', 'O', '8', '#'};
+  char line[Scrollback::k_lineCapacity];
+  int pos = 0;
+  for (int i = 0; i < n && pos < static_cast<int>(sizeof(line)) - 1; i++) {
+    int level = 0;
+    if (hi > lo) {
+      // Avoid floating-point: 7 * (x-lo) / (hi-lo) with rounding.
+      int num = 7 * (xs[i] - lo);
+      int den = hi - lo;
+      level = (num + den / 2) / den;
+      if (level < 0) level = 0;
+      if (level > 7) level = 7;
+    }
+    line[pos++] = k_steps[level];
+  }
+  line[pos] = '\0';
+  shell->scrollback()->writeLine(line);
+  char foot[Scrollback::k_lineCapacity];
+  Poincare::Print::CustomPrintf(foot, sizeof(foot),
+                                 "  min=%i max=%i n=%i", lo, hi, n);
+  shell->scrollback()->writeLine(foot);
+}
+
+// Bar: render each value as a horizontal '#' bar scaled to fill the
+// screen. Negative values get a '-' marker.
+void drawBars(const int* xs, int n, Shell* shell) {
+  if (n == 0) {
+    shell->scrollback()->writeLine("viz: no data");
+    return;
+  }
+  int absMax = 0;
+  for (int i = 0; i < n; i++) {
+    int a = xs[i] < 0 ? -xs[i] : xs[i];
+    if (a > absMax) absMax = a;
+  }
+  if (absMax == 0) absMax = 1;  // avoid /0 when all zeros
+  constexpr int k_chartW = 24;
+  for (int i = 0; i < n; i++) {
+    int a = xs[i] < 0 ? -xs[i] : xs[i];
+    int w = (a * k_chartW + absMax / 2) / absMax;
+    if (w > k_chartW) w = k_chartW;
+    char bar[Scrollback::k_lineCapacity];
+    char head[8];
+    Poincare::Print::CustomPrintf(head, sizeof(head), "%2i:%s", i,
+                                   xs[i] < 0 ? "-" : " ");
+    size_t pos = 0;
+    for (const char* p = head; *p && pos < sizeof(bar) - 1; p++) {
+      bar[pos++] = *p;
+    }
+    for (int k = 0; k < w && pos < sizeof(bar) - 1; k++) {
+      bar[pos++] = '#';
+    }
+    bar[pos] = '\0';
+    shell->scrollback()->writeLine(bar);
+  }
+}
+
+}  // namespace
+
+int cmd_viz(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 2) {
+    shell->scrollback()->writeLine(
+        "viz: usage: viz [--bar|--line] <numbers...>");
+    shell->scrollback()->writeLine(
+        "  default mode is sparkline; --bar = horizontal bar chart");
+    return 2;
+  }
+  int start = 1;
+  enum class Mode { Spark, Bar } mode = Mode::Spark;
+  if (strcmp(argv[1], "--bar") == 0 || strcmp(argv[1], "-b") == 0) {
+    mode = Mode::Bar;
+    start = 2;
+  } else if (strcmp(argv[1], "--line") == 0 || strcmp(argv[1], "-l") == 0) {
+    mode = Mode::Spark;
+    start = 2;
+  }
+  if (argc - start <= 0) {
+    shell->scrollback()->writeLine("viz: no numbers given");
+    return 2;
+  }
+
+  // Stack-allocated scratch — 32 numbers is plenty for 32-col bars.
+  constexpr int k_cap = 32;
+  int xs[k_cap];
+  int n = parseNumbers(argc, argv, start, xs, k_cap, shell);
+  if (n == 0) return 1;
+
+  if (mode == Mode::Bar) {
+    drawBars(xs, n, shell);
+  } else {
+    drawSparkline(xs, n, shell);
+  }
+  return 0;
+}
+
+int cmd_box(int argc, const char* const argv[], Shell* shell) {
+  if (argc < 3) {
+    shell->scrollback()->writeLine("box: usage: box <title> <text...>");
+    shell->scrollback()->writeLine(
+        "  e.g. box \"result\" \"the answer is 42\"");
+    return 2;
+  }
+  // Inner content width: 32 cols at large zoom, with 2 cells reserved
+  // for the box's left+right edges and 2 cells of padding.
+  constexpr int k_inner = 28;
+
+  // Top edge: +-{title}-+
+  char top[Scrollback::k_lineCapacity];
+  int pos = 0;
+  top[pos++] = '+';
+  // Title clamped to k_inner-2 (we leave a space on each side).
+  const char* title = argv[1];
+  size_t tlen = strlen(title);
+  if (tlen > static_cast<size_t>(k_inner - 2)) {
+    tlen = k_inner - 2;
+  }
+  top[pos++] = ' ';
+  for (size_t i = 0; i < tlen && pos < static_cast<int>(sizeof(top)) - 2; i++) {
+    top[pos++] = title[i];
+  }
+  top[pos++] = ' ';
+  while (pos < 2 + k_inner) {
+    top[pos++] = '-';
+  }
+  top[pos++] = '+';
+  top[pos] = '\0';
+  shell->scrollback()->writeLine(top);
+
+  // Content rows: each remaining argv joined by space, wrapped at k_inner.
+  char joined[Scrollback::k_lineCapacity * 4];
+  size_t jp = 0;
+  for (int i = 2; i < argc && jp < sizeof(joined) - 2; i++) {
+    if (i > 2 && jp < sizeof(joined) - 1) joined[jp++] = ' ';
+    const char* a = argv[i];
+    size_t alen = strlen(a);
+    if (jp + alen >= sizeof(joined)) alen = sizeof(joined) - 1 - jp;
+    memcpy(joined + jp, a, alen);
+    jp += alen;
+  }
+  joined[jp] = '\0';
+
+  size_t total = strlen(joined);
+  size_t off = 0;
+  do {
+    char row[Scrollback::k_lineCapacity];
+    int rp = 0;
+    row[rp++] = '|';
+    row[rp++] = ' ';
+    int taken = 0;
+    while (off < total && taken < k_inner - 2 &&
+           rp < static_cast<int>(sizeof(row)) - 3) {
+      row[rp++] = joined[off++];
+      taken++;
+    }
+    while (taken < k_inner - 2 && rp < static_cast<int>(sizeof(row)) - 3) {
+      row[rp++] = ' ';
+      taken++;
+    }
+    row[rp++] = ' ';
+    row[rp++] = '|';
+    row[rp] = '\0';
+    shell->scrollback()->writeLine(row);
+  } while (off < total);
+
+  // Bottom edge: full-width hyphen rule.
+  char bottom[Scrollback::k_lineCapacity];
+  int bp = 0;
+  bottom[bp++] = '+';
+  while (bp < k_inner + 2) {
+    bottom[bp++] = '-';
+  }
+  bottom[bp++] = '+';
+  bottom[bp] = '\0';
+  shell->scrollback()->writeLine(bottom);
+  return 0;
+}
+
+}  // namespace Termia
