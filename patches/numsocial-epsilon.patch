+#include <ion.h>
+#include <ion/termia_usb.h>
+#include <ion/timing.h>
+#include <ion/usb.h>
+#include <shared/usb/termia_bridge.h>
+#include <string.h>
+
+#include <new>
+
+namespace Ion {
+namespace USB {
+namespace Termia {
+
+// TMIA constants used by runClaudeProbe — minimal subset mirroring
+// the app-layer codec + bridge/crates/termia-protocol.
+namespace {
+constexpr uint8_t k_tmiaMagic[4] = {'T', 'M', 'I', 'A'};
+constexpr uint8_t k_tmiaVersion = 1;
+constexpr size_t k_tmiaHeaderLen = 8;
+constexpr size_t k_tmiaCrcLen = 2;
+constexpr uint8_t k_tmiaTypeClaudeRequest = 0x01;
+constexpr uint8_t k_tmiaTypeClaudeChunk = 0x02;
+constexpr uint8_t k_tmiaTypeClaudeDone = 0x03;
+constexpr uint8_t k_tmiaTypeSyncList = 0x04;
+constexpr uint8_t k_tmiaTypeError = 0x07;
+
+uint16_t crc16(const uint8_t* data, size_t len) {
+  uint16_t crc = 0xFFFF;
+  for (size_t i = 0; i < len; i++) {
+    crc ^= static_cast<uint16_t>(data[i]) << 8;
+    for (int b = 0; b < 8; b++) {
+      crc = (crc & 0x8000) ? static_cast<uint16_t>((crc << 1) ^ 0x1021)
+                           : static_cast<uint16_t>(crc << 1);
+    }
+  }
+  return crc;
+}
+
+/* Encode a TMIA frame with `type` and `payload`. Returns total bytes
+ * written or 0 on buffer overflow. */
+size_t encodeFrame(uint8_t type, const uint8_t* payload, uint16_t payloadLen,
+                   uint8_t* out, size_t outCap) {
+  size_t total = k_tmiaHeaderLen + payloadLen + k_tmiaCrcLen;
+  if (outCap < total) return 0;
+  out[0] = 'T';
+  out[1] = 'M';
+  out[2] = 'I';
+  out[3] = 'A';
+  out[4] = k_tmiaVersion;
+  out[5] = type;
+  out[6] = static_cast<uint8_t>(payloadLen & 0xFF);
+  out[7] = static_cast<uint8_t>((payloadLen >> 8) & 0xFF);
+  memcpy(out + k_tmiaHeaderLen, payload, payloadLen);
+  uint16_t crc = crc16(out, k_tmiaHeaderLen + payloadLen);
+  out[k_tmiaHeaderLen + payloadLen] = static_cast<uint8_t>(crc & 0xFF);
+  out[k_tmiaHeaderLen + payloadLen + 1] =
+      static_cast<uint8_t>((crc >> 8) & 0xFF);
+  return total;
+}
+
+/* Decode the frame at bytes[0..len]. Returns:
+ *    0  — buffer is shorter than a full frame (underflow; caller
+ *         should accumulate more bytes and retry).
+ *   >0  — bytes consumed by the decoded frame; the out-params are
+ *         populated. Caller should shift any remaining bytes down.
+ *   -1  — buffer is long enough but the frame is malformed (bad
+ *         magic / version / CRC). Caller should resync by discarding
+ *         bytes. Cast to int for the comparison. */
+int decodeFrame(const uint8_t* bytes, uint16_t len, uint8_t* outType,
+                uint16_t* outPayloadOffset, uint16_t* outPayloadLen) {
+  if (len < k_tmiaHeaderLen + k_tmiaCrcLen) return 0;  // underflow
+  for (int i = 0; i < 4; i++) {
+    if (bytes[i] != k_tmiaMagic[i]) return -1;  // bad magic
+  }
+  if (bytes[4] != k_tmiaVersion) return -1;
+  uint16_t payloadLen =
+      static_cast<uint16_t>(bytes[6]) |
+      (static_cast<uint16_t>(bytes[7]) << 8);
+  if (k_tmiaHeaderLen + payloadLen + k_tmiaCrcLen > len) return 0;  // underflow
+  uint16_t expected = crc16(bytes, k_tmiaHeaderLen + payloadLen);
+  uint16_t actual =
+      static_cast<uint16_t>(bytes[k_tmiaHeaderLen + payloadLen]) |
+      (static_cast<uint16_t>(bytes[k_tmiaHeaderLen + payloadLen + 1]) << 8);
+  if (actual != expected) return -1;
+  *outType = bytes[5];
+  *outPayloadOffset = k_tmiaHeaderLen;
+  *outPayloadLen = payloadLen;
+  return static_cast<int>(k_tmiaHeaderLen + payloadLen + k_tmiaCrcLen);
+}
+
+}  // namespace
+
+namespace {
+
+/* Shared implementation. The mode configures how bulk OUT packets
+ * are handled during the probe window. */
+uint32_t runProbe(uint32_t durationMs,
+                  Ion::Device::USB::TermiaBridge::Mode mode) {
+  const char* sn = Ion::serialNumber();
+  if (sn == nullptr) {
+    sn = "00000000";
+  }
+  /* Stack-build TermiaBridge, mirroring how Calculator::PollAndReset
+   * does the same with its own class. Keeping the instance on the
+   * userland stack (rather than BSS) avoids permanently burning the
+   * ~1.7 KB of RAM the descriptor tree occupies. */
+  Ion::Device::USB::TermiaBridge bridge(sn);
+  bridge.flushFIFOs();
+  bridge.setMode(mode);
+  Ion::USB::enable();
+
+  uint64_t start = Ion::Timing::millis();
+  uint64_t deadline = start + durationMs;
+  uint32_t pollCount = 0;
+  while (Ion::Timing::millis() < deadline) {
+    bridge.poll();
+    pollCount++;
+  }
+
+  bridge.detach();
+  Ion::USB::disable();
+  return pollCount;
+}
+
+}  // namespace
+
+uint32_t runEnumerationProbe(uint32_t durationMs) {
+  return runProbe(durationMs, Ion::Device::USB::TermiaBridge::Mode::Disabled);
+}
+
+uint32_t runEchoProbe(uint32_t durationMs) {
+  return runProbe(durationMs, Ion::Device::USB::TermiaBridge::Mode::Raw);
+}
+
+uint32_t runTmiaServerProbe(uint32_t durationMs) {
+  return runProbe(durationMs,
+                  Ion::Device::USB::TermiaBridge::Mode::TmiaServer);
+}
+
+/* Persistent tether state. `s_tetheredActive` flips to true on the
+ * first successful enumeration and stays true until closeTether() is
+ * called — survives across runClaudeProbe invocations so second and
+ * later calls skip the ~5 s enumeration + sync dance. */
+static bool s_tetheredActive = false;
+
+bool isTetheredActive() { return s_tetheredActive; }
+
+void closeTether() {
+  if (s_tetheredActive) {
+    Ion::USB::disable();
+    s_tetheredActive = false;
+  }
+}
+
+uint32_t runClaudeProbe(const char* prompt, uint32_t timeoutMs,
+                        ClaudeChunkSink sink, void* userData) {
+  const char* sn = Ion::serialNumber();
+  if (sn == nullptr) {
+    sn = "00000000";
+  }
+  Ion::Device::USB::TermiaBridge bridge(sn);
+  bridge.flushFIFOs();
+  bridge.setMode(Ion::Device::USB::TermiaBridge::Mode::TmiaClient);
+
+  const uint64_t start = Ion::Timing::millis();
+  const uint64_t deadline = start + timeoutMs;
+
+  /* RX buffer is shared between the optional sync step and the main
+   * response loop. Declared outside the tether-path split so both
+   * branches populate it. */
+  constexpr uint16_t k_rxBufCap = 512;
+  uint8_t rxBuf[k_rxBufCap];
+  uint16_t rxBufLen = 0;
+
+  if (s_tetheredActive) {
+    /* Fast path: host still has /dev/ttyACMn open, bridge still
+     * polling. Re-program this stack-scoped TermiaBridge's bulk
+     * endpoint state (hardware regs already configured, but this
+     * object's m_bulkEndpointsReady flag is fresh). Skip the
+     * handshake — bridge hasn't re-opened the port, so no new
+     * HELLO_ACK is coming. */
+    bridge.reattachAfterTether();
+  } else {
+    Ion::USB::enable();
+
+    /* Stage 1 — wait for the host to finish enumeration and send
+     * SET_CONFIGURATION(1). Only then are bulk endpoints armed. */
+    while (!bridge.isBulkReady() && Ion::Timing::millis() < deadline) {
+      bridge.poll();
+    }
+    if (!bridge.isBulkReady()) {
+      bridge.detach();
+      Ion::USB::disable();
+      return 0;
+    }
+
+    /* Stage 1.5 — sync with the bridge's HELLO_ACK. First call only;
+     * subsequent calls skip this because the bridge never re-sends
+     * HELLO_ACK as long as /dev/ttyACMn stays open. */
+    uint8_t pkt[64];
+    bool syncDone = false;
+    while (!syncDone && Ion::Timing::millis() < deadline) {
+      bridge.poll();
+      uint16_t pktLen = 0;
+      if (bridge.tryPopReceivedFrame(pkt, sizeof(pkt), &pktLen) &&
+          pktLen > 0) {
+        if (rxBufLen + pktLen <= k_rxBufCap) {
+          memcpy(rxBuf + rxBufLen, pkt, pktLen);
+          rxBufLen += pktLen;
+        }
+      }
+      uint8_t t;
+      uint16_t off, plen;
+      int consumed = decodeFrame(rxBuf, rxBufLen, &t, &off, &plen);
+      if (consumed > 0) {
+        memmove(rxBuf, rxBuf + consumed, rxBufLen - consumed);
+        rxBufLen -= static_cast<uint16_t>(consumed);
+        syncDone = true;
+      } else if (consumed < 0) {
+        rxBufLen = 0;  // resync by discarding buffer
+      }
+    }
+    if (!syncDone) {
+      bridge.detach();
+      Ion::USB::disable();
+      return 0;
+    }
+
+    s_tetheredActive = true;
+  }
+
+  /* Stage 2 — encode and send the ClaudeRequest. sendFrame splits
+   * the frame across multiple USB bulk packets as needed; 256 B
+   * prompt cap. */
+  uint16_t promptLen = static_cast<uint16_t>(strlen(prompt));
+  if (promptLen > 256) promptLen = 256;
+  uint8_t txFrame[512];
+  size_t txLen =
+      encodeFrame(k_tmiaTypeClaudeRequest,
+                  reinterpret_cast<const uint8_t*>(prompt), promptLen,
+                  txFrame, sizeof(txFrame));
+  if (txLen == 0 || !bridge.sendFrame(txFrame, static_cast<uint16_t>(txLen))) {
+    return 0;
+  }
+
+  /* Stage 3 — accumulate bulk-OUT bytes, decode frames as they
+   * complete, dispatch to the sink. Exits on ClaudeDone, caller
+   * abort, or timeout. The tether is intentionally left up on exit
+   * — call closeTether() to drop the pullup. */
+  uint32_t chunksDelivered = 0;
+  bool claudeDone = false;
+  while (!claudeDone && Ion::Timing::millis() < deadline) {
+    bridge.poll();
+    uint8_t pkt[64];
+    uint16_t pktLen = 0;
+    if (bridge.tryPopReceivedFrame(pkt, sizeof(pkt), &pktLen) &&
+        pktLen > 0) {
+      if (rxBufLen + pktLen > k_rxBufCap) {
+        rxBufLen = 0;  // overflow recovery
+      } else {
+        memcpy(rxBuf + rxBufLen, pkt, pktLen);
+        rxBufLen += pktLen;
+      }
+    }
+    while (true) {
+      uint8_t type;
+      uint16_t payloadOff, payloadLen;
+      int consumed =
+          decodeFrame(rxBuf, rxBufLen, &type, &payloadOff, &payloadLen);
+      if (consumed == 0) break;
+      if (consumed < 0) {
+        if (rxBufLen > 0) {
+          memmove(rxBuf, rxBuf + 1, rxBufLen - 1);
+          rxBufLen--;
+        }
+        continue;
+      }
+      if (type == k_tmiaTypeClaudeChunk || type == k_tmiaTypeError) {
+        chunksDelivered++;
+        if (sink != nullptr && !sink(rxBuf + payloadOff, payloadLen, userData)) {
+          claudeDone = true;
+        }
+      } else if (type == k_tmiaTypeClaudeDone) {
+        claudeDone = true;
+      }
+      memmove(rxBuf, rxBuf + consumed, rxBufLen - consumed);
+      rxBufLen -= static_cast<uint16_t>(consumed);
+      if (claudeDone) break;
+    }
+  }
+
+  return chunksDelivered;
+}
+
+namespace {
+
+/* Open the tether, identical to the first stages of runClaudeProbe.
+ * Non-tethered path runs full enumerate + sync; tethered path reuses
+ * the existing connection. On success leaves `bridge` ready for IO.
+ * Returns true on success. */
+bool openTetherSync(Ion::Device::USB::TermiaBridge& bridge, uint8_t* rxBuf,
+                    uint16_t rxBufCap, uint16_t& rxBufLen,
+                    uint64_t deadline) {
+  bridge.flushFIFOs();
+  bridge.setMode(Ion::Device::USB::TermiaBridge::Mode::TmiaClient);
+
+  if (s_tetheredActive) {
+    bridge.reattachAfterTether();
+    return true;
+  }
+  Ion::USB::enable();
+  while (!bridge.isBulkReady() && Ion::Timing::millis() < deadline) {
+    bridge.poll();
+  }
+  if (!bridge.isBulkReady()) {
+    bridge.detach();
+    Ion::USB::disable();
+    return false;
+  }
+  // HELLO_ACK sync
+  uint8_t pkt[64];
+  bool syncDone = false;
+  while (!syncDone && Ion::Timing::millis() < deadline) {
+    bridge.poll();
+    uint16_t pktLen = 0;
+    if (bridge.tryPopReceivedFrame(pkt, sizeof(pkt), &pktLen) &&
+        pktLen > 0) {
+      if (rxBufLen + pktLen <= rxBufCap) {
+        memcpy(rxBuf + rxBufLen, pkt, pktLen);
+        rxBufLen += pktLen;
+      }
+    }
+    uint8_t t;
+    uint16_t off, plen;
+    int consumed = decodeFrame(rxBuf, rxBufLen, &t, &off, &plen);
+    if (consumed > 0) {
+      memmove(rxBuf, rxBuf + consumed, rxBufLen - consumed);
+      rxBufLen -= static_cast<uint16_t>(consumed);
+      syncDone = true;
+    } else if (consumed < 0) {
+      rxBufLen = 0;
+    }
+  }
+  if (!syncDone) {
+    bridge.detach();
+    Ion::USB::disable();
+    return false;
+  }
+  s_tetheredActive = true;
+  return true;
+}
+
+/* Wait for the next complete TMIA frame on the tether. Accumulates
+ * bulk-OUT packets into rxBuf, decodes frames out of it. On success
+ * returns true and sets out-params; the caller is expected to shift
+ * the consumed bytes down. */
+bool waitForFrame(Ion::Device::USB::TermiaBridge& bridge, uint8_t* rxBuf,
+                  uint16_t rxBufCap, uint16_t& rxBufLen, uint8_t& outType,
+                  uint16_t& outPayloadOff, uint16_t& outPayloadLen,
+                  uint16_t& outConsumed, uint64_t deadline) {
+  while (Ion::Timing::millis() < deadline) {
+    bridge.poll();
+    uint8_t pkt[64];
+    uint16_t pktLen = 0;
+    if (bridge.tryPopReceivedFrame(pkt, sizeof(pkt), &pktLen) &&
+        pktLen > 0) {
+      if (rxBufLen + pktLen > rxBufCap) {
+        rxBufLen = 0;
+      } else {
+        memcpy(rxBuf + rxBufLen, pkt, pktLen);
+        rxBufLen += pktLen;
+      }
+    }
+    uint8_t type;
+    uint16_t off, len;
+    int consumed = decodeFrame(rxBuf, rxBufLen, &type, &off, &len);
+    if (consumed > 0) {
+      outType = type;
+      outPayloadOff = off;
+      outPayloadLen = len;
+      outConsumed = static_cast<uint16_t>(consumed);
+      return true;
+    }
+    if (consumed < 0 && rxBufLen > 0) {
+      memmove(rxBuf, rxBuf + 1, rxBufLen - 1);
+      rxBufLen--;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+namespace {
+Ion::Device::USB::TermiaBridge* s_stream = nullptr;
+static_assert(sizeof(Ion::Device::USB::TermiaBridge) <= k_streamStorageSize,
+              "k_streamStorageSize is too small");
+constexpr uint16_t k_streamPacketSize = 64;
+}  // namespace
+
+bool streamBegin(void* storage, size_t storageSize) {
+  if (storage == nullptr || storageSize < k_streamStorageSize) {
+    return false;
+  }
+  streamEnd();
+  closeTether();
+  /* The calculator may already be enumerated as a DFU device. Stay off the
+   * bus long enough for the host to notice, so it reads our descriptors. */
+  Ion::USB::disable();
+  Ion::Timing::msleep(300);
+  const char* sn = Ion::serialNumber();
+  s_stream = new (storage)
+      Ion::Device::USB::TermiaBridge(sn != nullptr ? sn : "00000000");
+  s_stream->flushFIFOs();
+  s_stream->setMode(Ion::Device::USB::TermiaBridge::Mode::TmiaClient);
+  Ion::USB::clearEnumerationInterrupt();
+  Ion::USB::enable();
+  s_tetheredActive = true;
+  return true;
+}
+
+bool streamReady() {
+  if (s_stream == nullptr) {
+    return false;
+  }
+  s_stream->poll();
+  return s_stream->isBulkReady();
+}
+
+void streamService(uint32_t durationMs) {
+  if (s_stream == nullptr) {
+    return;
+  }
+  const uint64_t deadline = Ion::Timing::millis() + durationMs;
+  do {
+    s_stream->poll();
+  } while (Ion::Timing::millis() < deadline);
+}
+
+void streamEnd() {
+  if (s_stream == nullptr) {
+    return;
+  }
+  s_stream->detach();
+  Ion::USB::disable();
+  s_stream = nullptr;
+  s_tetheredActive = false;
+}
+
+uint16_t streamRead(uint8_t* buffer, uint16_t cap) {
+  if (s_stream == nullptr || cap < k_streamPacketSize) {
+    return 0;
+  }
+  /* A packet produces two status words in the RX FIFO (data, then transfer
+   * complete) and poll() handles one word per call. */
+  s_stream->poll();
+  s_stream->poll();
+  uint16_t length = 0;
+  return s_stream->tryPopReceivedFrame(buffer, cap, &length) ? length : 0;
+}
+
+bool streamWrite(const uint8_t* data, size_t length, uint32_t timeoutMs) {
+  if (s_stream == nullptr || !s_stream->isBulkReady()) {
+    return false;
+  }
+  const uint64_t deadline = Ion::Timing::millis() + timeoutMs;
+  auto waitForIdle = [deadline]() {
+    while (s_stream->isTxBusy()) {
+      s_stream->poll();
+      if (Ion::Timing::millis() > deadline) {
+        return false;
+      }
+    }
+    return true;
+  };
+  for (size_t offset = 0; offset < length; offset += k_streamPacketSize) {
+    const size_t remaining = length - offset;
+    const uint16_t chunk = remaining > k_streamPacketSize
+                               ? k_streamPacketSize
+                               : static_cast<uint16_t>(remaining);
+    if (!waitForIdle() || !s_stream->writePacket(data + offset, chunk)) {
+      return false;
+    }
+  }
+  if (length > 0 && length % k_streamPacketSize == 0) {
+    return waitForIdle() && s_stream->writePacket(data, 0);
+  }
+  return true;
+}
+
+uint32_t syncList(SyncListSink sink, void* userData, uint32_t timeoutMs) {
+  const char* sn = Ion::serialNumber();
+  if (sn == nullptr) sn = "00000000";
+  Ion::Device::USB::TermiaBridge bridge(sn);
+
+  constexpr uint16_t k_rxBufCap = 2048;  // bigger — sync lists can be larger
+  uint8_t rxBuf[k_rxBufCap];
+  uint16_t rxBufLen = 0;
+
+  const uint64_t deadline = Ion::Timing::millis() + timeoutMs;
+  if (!openTetherSync(bridge, rxBuf, k_rxBufCap, rxBufLen, deadline)) {
+    return 0;
+  }
+
+  // Send SYNC_LIST request (empty payload).
+  uint8_t reqFrame[16];
+  size_t reqLen =
+      encodeFrame(k_tmiaTypeSyncList, nullptr, 0, reqFrame, sizeof(reqFrame));
+  if (reqLen == 0 ||
+      !bridge.sendFrame(reqFrame, static_cast<uint16_t>(reqLen))) {
+    return 0;
+  }
+
+  // Wait for SYNC_LIST response. Skip other frame types that may
+  // arrive ahead of it.
+  while (Ion::Timing::millis() < deadline) {
+    uint8_t type;
+    uint16_t payloadOff, payloadLen, consumed;
+    if (!waitForFrame(bridge, rxBuf, k_rxBufCap, rxBufLen, type, payloadOff,
+                      payloadLen, consumed, deadline)) {
+      return 0;
+    }
+    if (type != k_tmiaTypeSyncList) {
+      // Drop + continue (unknown/Error frame — for now treat as skip).
+      memmove(rxBuf, rxBuf + consumed, rxBufLen - consumed);
+      rxBufLen -= consumed;
+      continue;
+    }
+    // Parse payload: [count: u16 LE][entries]
+    //   entry := [name_len: u8][name: name_len bytes][size: u32 LE][mtime: u32 LE]
+    if (payloadLen < 2) {
+      return 0;
+    }
+    const uint8_t* p = rxBuf + payloadOff;
+    uint16_t count = static_cast<uint16_t>(p[0]) |
+                     (static_cast<uint16_t>(p[1]) << 8);
+    uint16_t cursor = 2;
+    uint32_t delivered = 0;
+    for (uint16_t i = 0; i < count; i++) {
+      if (cursor + 1 > payloadLen) break;
+      uint8_t nameLen = p[cursor++];
+      if (cursor + nameLen + 8 > payloadLen) break;
+      char nameBuf[256];
+      uint8_t copyLen = nameLen;
+      if (copyLen >= sizeof(nameBuf)) copyLen = sizeof(nameBuf) - 1;
+      memcpy(nameBuf, p + cursor, copyLen);
+      nameBuf[copyLen] = '\0';
+      cursor += nameLen;
+      uint32_t size = static_cast<uint32_t>(p[cursor]) |
+                      (static_cast<uint32_t>(p[cursor + 1]) << 8) |
+                      (static_cast<uint32_t>(p[cursor + 2]) << 16) |
+                      (static_cast<uint32_t>(p[cursor + 3]) << 24);
+      cursor += 4;
+      uint32_t mtime = static_cast<uint32_t>(p[cursor]) |
+                       (static_cast<uint32_t>(p[cursor + 1]) << 8) |
+                       (static_cast<uint32_t>(p[cursor + 2]) << 16) |
+                       (static_cast<uint32_t>(p[cursor + 3]) << 24);
+      cursor += 4;
+      delivered++;
+      if (sink != nullptr && !sink(nameBuf, size, mtime, userData)) break;
+    }
+    memmove(rxBuf, rxBuf + consumed, rxBufLen - consumed);
+    rxBufLen -= consumed;
+    return delivered;
+  }
+  return 0;
+}
+
+}  // namespace Termia
+}  // namespace USB
+}  // namespace Ion
