diff --git a/epsilon/apps/termia/ui/terminal_view.cpp b/epsilon/apps/termia/ui/terminal_view.cpp
new file mode 100644
index 0000000000..18eb116cbb
--- /dev/null
+++ b/epsilon/apps/termia/ui/terminal_view.cpp
@@ -0,0 +1,149 @@
+#include "terminal_view.h"
+
+#include <kandinsky/font.h>
+#include <string.h>
+
+#include "../shell/shell.h"
+
+namespace Termia {
+
+// Per-zoom cell metrics. Index 0 = Small (default), index 1 = Large.
+// Values come from kandinsky/font.h: SmallFont is 7×14, LargeFont is 10×18.
+// The screen is 320×240 — 320 / 7 = 45 cols small, 320 / 10 = 32 cols large.
+struct CellMetrics {
+  KDFont::Size font;
+  int w;
+  int h;
+  int cols;
+};
+
+static constexpr CellMetrics k_metrics[2] = {
+    {KDFont::Size::Small, 7, 14, 45},
+    {KDFont::Size::Large, 10, 18, 32},
+};
+
+TerminalView::TerminalView(const Shell* shell) : Escher::View(), m_shell(shell) {}
+
+static inline KDGlyph::Style textStyle(const Palette& p, KDFont::Size font) {
+  return KDGlyph::Style{
+      .glyphColor = p.fg,
+      .backgroundColor = p.bg,
+      .font = font,
+  };
+}
+
+void TerminalView::drawRect(KDContext* ctx, KDRect /*rect*/) const {
+  const Palette palette = m_shell->palette();
+  const KDColor bg = palette.bg;
+  const KDColor fg = palette.fg;
+
+  // Pick metrics based on the shell's current zoom level. Clamp defensively.
+  int z = m_shell->zoomLevel();
+  if (z < 0) z = 0;
+  if (z > 1) z = 1;
+  const CellMetrics m = k_metrics[z];
+  const KDGlyph::Style style = textStyle(palette, m.font);
+
+  // Always repaint the whole view — simpler than tracking dirty regions
+  // and the spec's 30 FPS scroll goal is comfortable at this resolution.
+  ctx->fillRect(bounds(), bg);
+
+  const int viewH = bounds().height();
+  const int rows = viewH / m.h;
+  if (rows < 2) {
+    return;  // defensive; shouldn't happen on a real device
+  }
+  const int scrollbackRows = rows - 1;  // bottom row is the live prompt
+
+  // Scrollback: newest line at the bottom of the scrollback area, older
+  // lines stacked upward. Shell::viewOffset() lets the user scroll back
+  // through older output via Shift+Up / Shift+Down.
+  const Scrollback* sb = m_shell->scrollback();
+  const int available = sb->lineCount();
+  const int offset = m_shell->viewOffset();
+  const int hOffset = m_shell->horizOffset();
+  const int remaining = available - offset;
+  const int toDraw = remaining < scrollbackRows
+                         ? (remaining > 0 ? remaining : 0)
+                         : scrollbackRows;
+  for (int i = 0; i < toDraw; i++) {
+    const char* text = sb->lineAt(i + offset);
+    // Slide the line left by hOffset cells. Lines shorter than the
+    // offset render blank — an empty row is the right visual cue that
+    // there's nothing more to the right.
+    if (hOffset > 0) {
+      int textLen = sb->lineLengthAt(i + offset);
+      if (hOffset >= textLen) {
+        continue;  // entirely scrolled past
+      }
+      text = text + hOffset;
+    }
+    int y = (scrollbackRows - 1 - i) * m.h;
+    ctx->drawString(text, KDPoint(0, y), style);
+  }
+
+  // Scroll indicators along the top edge: "^ scrolled" middle-right when
+  // the vertical viewport is held back, "<" top-left when the user is
+  // sliding right past the line origin.
+  if (offset > 0) {
+    const char* hint = "^ scrolled";
+    const int hintLen = 10;
+    ctx->drawString(hint, KDPoint((m.cols - hintLen) * m.w, 0), style);
+  }
+  if (hOffset > 0) {
+    ctx->drawString("<", KDPoint(0, 0), style);
+  }
+
+  // Prompt row at the bottom: prompt + current input + cursor.
+  const int promptRowY = scrollbackRows * m.h;
+  const char* prompt = m_shell->prompt();
+  const int promptLen = static_cast<int>(strlen(prompt));
+  ctx->drawString(prompt, KDPoint(0, promptRowY), style);
+
+  const char* input = m_shell->lineEditor().text();
+  const int inputLen = m_shell->lineEditor().length();
+
+  // Visible input window: if the input overflows the terminal width,
+  // slide the window so the cursor is always on-screen.
+  const int inputCols = m.cols - promptLen - 1;  // -1 for trailing cursor cell
+  int firstVisibleCol = 0;
+  if (inputLen > inputCols) {
+    firstVisibleCol = m_shell->lineEditor().cursorPos() - inputCols + 1;
+    if (firstVisibleCol < 0) {
+      firstVisibleCol = 0;
+    }
+    if (firstVisibleCol > inputLen - inputCols) {
+      firstVisibleCol = inputLen - inputCols;
+    }
+  }
+
+  if (inputLen > 0) {
+    const char* vis = input + firstVisibleCol;
+    int visLen = inputLen - firstVisibleCol;
+    if (visLen > inputCols) {
+      visLen = inputCols;
+    }
+    ctx->drawString(vis, KDPoint(promptLen * m.w, promptRowY), style, visLen);
+  }
+
+  // Cursor: filled cell in fg colour, with the underlying char (if any)
+  // re-rendered in inverse so it stays readable.
+  const int cursorVisCol =
+      promptLen + (m_shell->lineEditor().cursorPos() - firstVisibleCol);
+  if (cursorVisCol >= 0 && cursorVisCol < m.cols) {
+    KDRect cursorRect(cursorVisCol * m.w, promptRowY, m.w, m.h);
+    ctx->fillRect(cursorRect, fg);
+    int cursorModelPos = m_shell->lineEditor().cursorPos();
+    if (cursorModelPos < inputLen) {
+      char under[2] = {input[cursorModelPos], '\0'};
+      KDGlyph::Style invStyle = {
+          .glyphColor = bg,
+          .backgroundColor = fg,
+          .font = m.font,
+      };
+      ctx->drawString(under, KDPoint(cursorVisCol * m.w, promptRowY), invStyle);
+    }
+  }
+}
+
+}  // namespace Termia
